# Connapse Environment Variables
# Connapse starts without this file. Copy it to .env only to change something.
# ⚠️ NEVER commit the .env file to version control

# ----------------------------------------------------------------------------
# Extras
# ----------------------------------------------------------------------------
# The local embedding model. on (the default) runs Ollama and downloads the model on
# first start. off never downloads or starts it: set the embedding provider below, or
# choose one in Settings -> Embedding.
# CONNAPSE_LOCAL_MODEL=on

# The reranker, off by default. It adds about 2 GB of memory, and a CPU takes seconds per search.
# COMPOSE_PROFILES=with-reranker

# The Connapse image, by release tag. Defaults to latest.
# CONNAPSE_VERSION=v0.4.0

# ----------------------------------------------------------------------------
# Database and file storage passwords
# ----------------------------------------------------------------------------
# The first start makes random ones and keeps them in the secrets volume, so leave
# these unset. Set them only to choose your own before the first start; a value here
# replaces the kept one, and PostgreSQL and MinIO data don't change password by themselves.
# POSTGRES_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# ----------------------------------------------------------------------------
# Application Settings (optional overrides)
# ----------------------------------------------------------------------------
# Only the variables listed under `web.environment` in docker-compose.yml reach
# the web app; setting any other key in this file does nothing. To use one of the
# keys below that isn't listed there, such as a Knowledge__Search__ setting, add it
# under `services.web.environment` in docker-compose.override.yml.
# Settings saved under Admin -> Settings override these values.

# ASP.NET Core environment
# ASPNETCORE_ENVIRONMENT=Development

# Embedding provider (Ollama, OpenAI, AzureOpenAI)
# Knowledge__Embedding__Provider=Ollama
# Knowledge__Embedding__Model=nomic-embed-text
# Knowledge__Embedding__BaseUrl=http://ollama:11434

# OpenAI settings (if using OpenAI provider)
# Knowledge__Embedding__OpenAiApiKey=sk-...

# Azure OpenAI settings (if using AzureOpenAI provider)
# Knowledge__Embedding__AzureEndpoint=https://your-resource.openai.azure.com
# Knowledge__Embedding__AzureApiKey=...
# Knowledge__Embedding__AzureDeploymentName=text-embedding-3-small

# ----------------------------------------------------------------------------
# Auth / JWT Settings (v0.2.0+)
# ----------------------------------------------------------------------------
# Admin account auto-seed on first startup
# CONNAPSE_ADMIN_EMAIL=admin@example.com
# CONNAPSE_ADMIN_PASSWORD=YourSecureAdminPassword123!

# JWT signing secret — generate with: openssl rand -base64 64
# ⚠️ REQUIRED in production. Must be at least 32 characters.
# Identity__Jwt__Secret=replace-with-a-long-random-secret-at-least-64-chars
# Identity__Jwt__Issuer=Connapse                        # JWT issuer claim
# Identity__Jwt__Audience=Connapse                      # JWT audience claim
# Identity__Jwt__AccessTokenLifetimeMinutes=60          # Access token lifetime
# Identity__Jwt__RefreshTokenLifetimeDays=7             # Refresh token lifetime
# Identity__Cookie__SlidingExpirationDays=14            # Cookie session lifetime

# ----------------------------------------------------------------------------
# LLM Provider Settings (v0.3.0+)
# ----------------------------------------------------------------------------
# Knowledge__Llm__Provider=Ollama                       # Ollama | OpenAI | AzureOpenAI | Anthropic
# Knowledge__Llm__BaseUrl=http://ollama:11434           # Base URL (Ollama/OpenAI)
# Knowledge__Llm__Model=llama3.2                        # Model name
# Knowledge__Llm__ApiKey=                               # API key (OpenAI/AzureOpenAI/Anthropic)
# Knowledge__Llm__AzureDeploymentName=                  # Azure OpenAI deployment name
# Knowledge__Llm__Temperature=0.7                       # Generation temperature
# Knowledge__Llm__MaxTokens=2000                        # Max output tokens

# ----------------------------------------------------------------------------
# Search Settings
# ----------------------------------------------------------------------------
# Knowledge__Search__Mode=Hybrid                        # Vector | Keyword | Hybrid
# Knowledge__Search__TopK=10                            # Default result count
# Knowledge__Search__FusionMethod=ConvexCombination     # ConvexCombination | DBSF
# Knowledge__Search__FusionAlpha=0.65                   # Semantic weight (0.0-1.0)
# Knowledge__Search__AutoCut=false                      # Auto-trim after largest score gap
# Knowledge__Search__MinimumScore=0                     # Minimum similarity score floor

# ----------------------------------------------------------------------------
# Chunking Settings
# ----------------------------------------------------------------------------
# Knowledge__Chunking__Strategy=Semantic                # Semantic | FixedSize | SentenceAwareFixedSize | Recursive | SentenceWindow | DocumentAware
# Knowledge__Chunking__MaxChunkSize=512                 # Max tokens per chunk
# Knowledge__Chunking__Overlap=50                       # Overlap tokens between chunks

# ----------------------------------------------------------------------------
# Upload Settings
# ----------------------------------------------------------------------------
# Knowledge__Upload__MaxFileBytes=268435456             # Max upload size (default 256 MiB)
# Knowledge__Upload__ParallelWorkers=4                  # Parallel ingestion workers

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
# RateLimiting__AuthPermitLimit=10                      # Auth endpoint requests per window
# RateLimiting__AuthWindowSeconds=60                    # Auth rate limit window (seconds)
# RateLimiting__ApiPermitLimit=200                      # API endpoint requests per window
# RateLimiting__ApiWindowSeconds=60                     # API rate limit window (seconds)
# RateLimiting__McpPermitLimit=600                      # MCP endpoint requests per window
# RateLimiting__McpWindowSeconds=60                     # MCP rate limit window (seconds)

# ----------------------------------------------------------------------------
# Development Tools (optional)
# ----------------------------------------------------------------------------
# Ollama API endpoint (only if running Ollama separately)
# OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# - This file uses docker-compose variable substitution syntax
# - Values here fill in the ${...} variables in docker-compose.yml
# - See SECURITY.md for full security considerations
# - For the full configuration reference, see docs/reference/configuration.md
