<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Connapse.Eval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The harness hosts Connapse.Web in-process, so it runs on the ASP.NET Core shared framework
         like the web app does; framework assemblies then supersede package copies the same way. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <PackageReference Include="Testcontainers.Minio" Version="4.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Connapse.Web\Connapse.Web.csproj" />
  </ItemGroup>

</Project>
