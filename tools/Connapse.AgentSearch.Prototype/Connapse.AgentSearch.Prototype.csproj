<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Tool parameter names are agent-facing and follow rg's snake_case flags. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <Description>CON-142 prototype: exact-text file search and file reading for agents, as an MCP stdio server over a folder of original files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>

</Project>
