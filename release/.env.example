# Connapse environment configuration
# Connapse starts without this file. Copy it to .env only to change something.

# --- Extras ---------------------------------------------------------------------
# The local embedding model. on (the default) runs Ollama and downloads the model on
# first start. off never downloads or starts it: set the embedding provider below, or
# choose one in Settings -> Embedding.
# CONNAPSE_LOCAL_MODEL=on

# The reranker, off by default. It adds about 2 GB of memory, and a CPU takes seconds per search.
# COMPOSE_PROFILES=with-reranker

# Pin to a specific release tag, e.g. v0.4.0. Defaults to the release this file came with.
# CONNAPSE_VERSION=v0.4.0

# --- Embedding provider (with the local model off) ------------------------------
# Knowledge__Embedding__Provider=OpenAI
# Knowledge__Embedding__Model=text-embedding-3-small
# Knowledge__Embedding__Dimensions=1536
# Knowledge__Embedding__OpenAiApiKey=sk-...

# Azure OpenAI, instead:
# Knowledge__Embedding__Provider=AzureOpenAI
# Knowledge__Embedding__AzureEndpoint=https://your-resource.openai.azure.com
# Knowledge__Embedding__AzureApiKey=
# Knowledge__Embedding__AzureDeploymentName=text-embedding-3-small

# An Ollama you already run:
# Knowledge__Embedding__BaseUrl=http://your-ollama-host:11434

# --- Passwords ------------------------------------------------------------------
# The first start makes random ones and keeps them in the secrets volume, so leave
# these unset. Set them only to choose your own before the first start; a value here
# replaces the kept one, and PostgreSQL and MinIO data don't change password by themselves.
# POSTGRES_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# Leave these unset to create the Owner account in the setup form the first time you open
# Connapse. Set both only to create or restore the Owner from the environment on startup.
# CONNAPSE_ADMIN_EMAIL=admin@example.com
# CONNAPSE_ADMIN_PASSWORD=change_me_admin

# Secret key used to sign JWT tokens, at least 32 characters. Left unset, the first start
# makes one and keeps it in the appdata volume.
# Identity__Jwt__Secret=
