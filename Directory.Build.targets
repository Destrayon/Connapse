<Project>
  <!--
    TreeSitter.DotNet ships about 30 grammars, around 65 MB per platform. CodeParser (CON-36) loads only C#,
    TypeScript, TSX and Python, so every other grammar is dropped from build and publish output, in every project
    that references it directly or through Connapse.Ingestion. The core library (tree-sitter) stays.
  -->
  <PropertyGroup>
    <TreeSitterGrammarsDropped>^(lib)?tree-sitter-(?!(c-sharp|typescript|tsx|python)$)</TreeSitterGrammarsDropped>
  </PropertyGroup>

  <Target Name="DropUnusedTreeSitterGrammars" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_UnusedTreeSitterGrammar Include="@(RuntimeTargetsCopyLocalItems);@(NativeCopyLocalItems)"
                                Condition="'%(NuGetPackageId)' == 'TreeSitter.DotNet' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(TreeSitterGrammarsDropped)'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_UnusedTreeSitterGrammar)" />
      <NativeCopyLocalItems Remove="@(_UnusedTreeSitterGrammar)" />
    </ItemGroup>
  </Target>

  <!--
    A build with no runtime identifier copies every package's native libraries for every platform into
    runtimes/: about 870 MB per output folder (ONNX Runtime, SkiaSharp with an 80 MB Windows .pdb, PDFium,
    libgit2, tree-sitter), and eleven projects have one, so a solution build writes about 10 GB of it. On
    GitHub's 72 GB runners that filled the disk (CON-246). CI builds with -p:RuntimeAssetsFor=linux-x64 and
    gets only the folders the .NET host can load on that machine: the identifier itself, its OS family
    (linux, win, osx), unix for the non-Windows ones, and any. The deps.json still lists the other
    platforms; the host never looks for them. Unset, as in local and Docker builds, nothing changes.
  -->
  <Target Name="DropOtherPlatformsRuntimeAssets" AfterTargets="ResolvePackageAssets" Condition="'$(RuntimeAssetsFor)' != ''">
    <PropertyGroup>
      <_RuntimeAssetsFamily>$(RuntimeAssetsFor.Split('-')[0])</_RuntimeAssetsFamily>
      <_RuntimeAssetsKept>;$(RuntimeAssetsFor);$(_RuntimeAssetsFamily);any;</_RuntimeAssetsKept>
      <_RuntimeAssetsKept Condition="'$(_RuntimeAssetsFamily)' != 'win'">$(_RuntimeAssetsKept)unix;</_RuntimeAssetsKept>
    </PropertyGroup>
    <ItemGroup>
      <_OtherPlatformRuntimeAsset Include="@(RuntimeTargetsCopyLocalItems)"
                                  Condition="!$(_RuntimeAssetsKept.Contains(';%(RuntimeIdentifier);'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_OtherPlatformRuntimeAsset)" />
    </ItemGroup>
  </Target>
</Project>
