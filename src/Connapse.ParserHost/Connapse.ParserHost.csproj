<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web process resolves Microsoft.Extensions.* from the ASP.NET Core shared framework,
         so its output folder has no copies; the host runs from that folder and needs the same
         framework. The runtime image already carries it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Connapse.Core\Connapse.Core.csproj" />
    <ProjectReference Include="..\Connapse.Ingestion\Connapse.Ingestion.csproj" />
  </ItemGroup>

</Project>
