<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Connapse.Core\Connapse.Core.csproj" />
    <ProjectReference Include="..\Connapse.Storage\Connapse.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="MsgReader" Version="6.1.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- 5.2.1, not later: 5.3+ moves to SkiaSharp 4, and RapidOcrNet is built against SkiaSharp 3. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <!-- PDFium itself, newer than the 147 PDFtoImage 5.2.1 asks for: it renders untrusted pages and
         takes security fixes often (#641). Its C API is stable, so PDFtoImage runs on it unchanged. -->
    <PackageReference Include="bblanchon.PDFium.Linux" Version="156.0.8076" />
    <PackageReference Include="bblanchon.PDFium.macOS" Version="156.0.8076" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <PackageReference Include="RapidOcrNet" Version="4.2.0" GeneratePathProperty="true" />
    <PackageReference Include="PragmaticSegmenterNet" Version="1.0.5" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="SmartReader" Version="0.11.1" />
    <PackageReference Include="Tabula" Version="1.0.1" />
    <PackageReference Include="UTF.Unknown" Version="2.7.0" />
    <PackageReference Include="VersOne.Epub" Version="3.3.6" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    RapidOcrNet copies its PP-OCRv5 models only into projects that reference it directly. As
    content of this project they also reach Connapse.Web, Connapse.ParserHost (where OCR runs) and
    their publish output, at models/v5 beside the assemblies, where PdfOcr loads them.
  -->
  <ItemGroup>
    <None Include="$(PkgRapidOcrNet)/models/v5/*.*" Link="models/v5/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    PP-DocLayout v3 for PdfLayout (#642): PaddlePaddle's layout model, Apache-2.0, as packaged in ONNX
    by RapidAI/RapidLayout v1.2.0. Too large for git and published in no NuGet package, so it is
    downloaded once into .models/ at the repository root, checked against its SHA-256, and copied
    like the OCR models to models/layout beside the assemblies.
  -->
  <PropertyGroup>
    <LayoutModelUrl>https://www.modelscope.cn/models/RapidAI/RapidLayout/resolve/v1.2.0/onnx/pp_doc_layout/pp_doc_layoutv3.onnx</LayoutModelUrl>
    <LayoutModelSha256>250dbad1dfb9e4983fab75e1bf5085cd56ec3f41d5c7d0f8623ec74856e7aa67</LayoutModelSha256>
    <LayoutModelDir>$(MSBuildThisFileDirectory)../../.models/</LayoutModelDir>
    <LayoutModelPath>$(LayoutModelDir)pp_doc_layoutv3.onnx</LayoutModelPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(LayoutModelPath)" Link="models/layout/pp_doc_layoutv3.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="DownloadLayoutModel" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="!Exists('$(LayoutModelPath)')">
    <!-- curl, not MSBuild's DownloadFile: ModelScope redirects to a storage host that refuses DownloadFile (403). -->
    <MakeDir Directories="$(LayoutModelDir)" />
    <Exec Command="curl -fsSL --retry 3 -o &quot;$(LayoutModelDir)pp_doc_layoutv3.onnx.part&quot; &quot;$(LayoutModelUrl)&quot;" />
    <GetFileHash Files="$(LayoutModelDir)pp_doc_layoutv3.onnx.part" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="DownloadedLayoutModelSha256" />
    </GetFileHash>
    <Delete Files="$(LayoutModelDir)pp_doc_layoutv3.onnx.part" Condition="'$(DownloadedLayoutModelSha256.ToLowerInvariant())' != '$(LayoutModelSha256)'" />
    <Error Condition="'$(DownloadedLayoutModelSha256.ToLowerInvariant())' != '$(LayoutModelSha256)'" Text="The layout model downloaded from $(LayoutModelUrl) has SHA-256 $(DownloadedLayoutModelSha256), expected $(LayoutModelSha256)." />
    <Move SourceFiles="$(LayoutModelDir)pp_doc_layoutv3.onnx.part" DestinationFiles="$(LayoutModelPath)" />
  </Target>

  <!-- Every build, not only after a download: a file restored from a cache or left in .models must match too. -->
  <Target Name="VerifyLayoutModel" AfterTargets="DownloadLayoutModel" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <GetFileHash Files="$(LayoutModelPath)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="ExistingLayoutModelSha256" />
    </GetFileHash>
    <Error Condition="'$(ExistingLayoutModelSha256.ToLowerInvariant())' != '$(LayoutModelSha256)'" Text="$(LayoutModelPath) has SHA-256 $(ExistingLayoutModelSha256), expected $(LayoutModelSha256). Delete it to download it again." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Connapse.Ingestion.Tests" />
  </ItemGroup>

</Project>
