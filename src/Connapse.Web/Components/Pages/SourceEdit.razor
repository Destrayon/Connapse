@page "/sources/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "RequireAdmin")]
@using Connapse.Core
@using Connapse.Core.Interfaces
@using Connapse.Storage.Connectors
@using Connapse.Storage.Connectors.GitHub
@using Connapse.Web.Components.Settings
@using Connapse.Web.Components.Shared
@using Connapse.Web.Components.Sources
@using Connapse.Web.Services
@inject ISourceStore SourceStore
@inject IConnectionStore ConnectionStore
@inject IConnectorFactory ConnectorFactory
@inject IAuditLogger AuditLogger
@inject CustomSourceTokenReplacement TokenReplacement
@inject ILogger<SourceEdit> Logger

@*
    One source's settings. What it reads from — the connection and the bucket, directory, or
    repository — is shown but not editable: pointing a source somewhere else is a new source,
    and silently re-pointing one would leave its indexed documents describing the old place.
*@

<PageTitle>Edit source — Connapse</PageTitle>

<div class="container py-4" style="max-width:52rem">
    <a href="/sources" class="small text-decoration-none"><span class="bi-arrow-left me-1"></span>Sources</a>

    @if (loadError is not null)
    {
        <div class="alert alert-danger mt-3">@loadError</div>
    }
    else if (source is null || form is null)
    {
        <div class="text-muted mt-3"><span class="spinner-border spinner-border-sm me-1"></span> Loading…</div>
    }
    else
    {
        @* The setup guide sits in the title row, as on every provider surface. *@
        <div class="d-flex flex-wrap align-items-baseline gap-2 mt-2 mb-4">
            <h1 class="h4 mb-0">@source.Name</h1>
            @if (form.Attachments is { } guided)
            {
                <SetupGuideLink Id="atlassian-setup-guide" Href="@guided.SetupGuideUrl" />
            }
        </div>

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h6 mb-3">General</h2>
                <div class="mb-3">
                    <label class="form-label" for="source-name">Name</label>
                    <input id="source-name" @ref="nameInput" class="form-control @(form.NameError is null ? "" : "is-invalid")" required
                           aria-invalid="@(form.NameError is null ? null : "true")"
                           aria-describedby="@(form.NameError is null ? null : "source-name-error")"
                           @bind="form.Name" @bind:after="() => { if (form.NameError is not null) form.ValidateName(); }"
                           @onblur="() => form.ValidateName()" />
                    @if (form.NameError is { } nameError)
                    {
                        <div id="source-name-error" class="invalid-feedback d-block fw-semibold" role="alert">
                            <span class="bi-x-circle me-1" aria-hidden="true"></span>@nameError
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label" for="source-description">Description <span class="text-muted">(optional)</span></label>
                    <input id="source-description" class="form-control" @bind="form.Description" />
                </div>
                <div>
                    <label class="form-label" for="source-interval">Sync interval in seconds <span class="text-muted">(optional)</span></label>
                    <input id="source-interval" @ref="intervalInput" type="number" min="60" class="form-control @(form.SyncIntervalError is null ? "" : "is-invalid")" style="max-width:12rem"
                           aria-invalid="@(form.SyncIntervalError is null ? null : "true")"
                           aria-describedby="@(form.SyncIntervalError is null ? "source-interval-help" : "source-interval-error source-interval-help")"
                           @bind="form.SyncIntervalSeconds" @bind:after="() => form.ValidateSyncInterval()"
                           @onblur="() => form.ValidateSyncInterval()" />
                    @if (form.SyncIntervalError is { } intervalError)
                    {
                        <div id="source-interval-error" class="invalid-feedback d-block fw-semibold" role="alert">
                            <span class="bi-x-circle me-1" aria-hidden="true"></span>@intervalError
                        </div>
                    }
                    <div id="source-interval-help" class="form-text">Empty uses the configured default. The minimum is 60.</div>
                </div>
            </div>
        </section>

        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h6 mb-2">Reads from</h2>
                <dl class="row small mb-0">
                    <dt class="col-sm-3 fw-normal text-muted">Connection</dt>
                    <dd class="col-sm-9">@(connection?.Name ?? (source.Provider is { } p ? $"{(p == ConnectionProvider.Custom ? "Custom source" : p.ToString())} (no connection)" : "(missing connection)"))</dd>
                    <dt class="col-sm-3 fw-normal text-muted">Scope</dt>
                    <dd class="col-sm-9 font-monospace">@(SourceScopeSummary.Describe(source.ScopeJson, SiteHost) ?? "—")</dd>
                </dl>
                <div class="form-text">
                    @if (form.Attachments is { } fixedItem)
                    {
                        <text>@fixedItem.ItemFixedNote</text>
                    }
                    else
                    {
                        <text>To read from somewhere else, add a new source.</text>
                    }
                </div>
            </div>
        </section>

        @if (holdsToken)
        {
            <section class="card mb-3" id="source-token-section">
                <div class="card-body">
                    <h2 class="h6 mb-2">Token</h2>
                    <p class="small text-muted mb-2" id="source-token-help">
                        The token Connapse sends to the middle man. When the middle man's token changes, enter the new one
                        here: it is checked with the middle man before it replaces the stored one, and nothing is re-read.
                    </p>
                    <div class="d-flex gap-2 align-items-start">
                        <div class="flex-grow-1">
                            <label class="visually-hidden" for="source-token">New token</label>
                            <input id="source-token" type="password" autocomplete="off"
                                   class="form-control @(tokenError is null ? "" : "is-invalid")" placeholder="New token"
                                   aria-describedby="@(tokenError is null ? "source-token-help" : "source-token-error source-token-help")"
                                   aria-invalid="@(tokenError is null ? null : "true")"
                                   @bind="newToken" />
                            @if (tokenError is not null)
                            {
                                <div id="source-token-error" class="invalid-feedback d-block fw-semibold" role="alert">
                                    <span class="bi-x-circle me-1" aria-hidden="true"></span>@tokenError
                                </div>
                            }
                            @if (tokenReplaced)
                            {
                                <div id="source-token-replaced" class="small text-success mt-1" role="status">
                                    <span class="bi-check-circle me-1" aria-hidden="true"></span>Token replaced. The next sync uses it.
                                </div>
                            }
                        </div>
                        <button id="source-token-replace" class="btn btn-outline-secondary" @onclick="ReplaceTokenAsync" disabled="@replacingToken">
                            @if (replacingToken)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            Replace token
                        </button>
                    </div>
                </div>
            </section>
        }

        @if (form.Attachments is { } atlassian)
        {
            @* One section for Confluence and Jira alike; the field ids carry the product. *@
            string id = atlassian.FieldIdPrefix;
            <section class="card mb-3">
                <div class="card-body">
                    <fieldset id="@($"{id}-attachments-group")">
                        <legend class="h6 mb-3">@AtlassianSourceSelection.AttachmentsLabel</legend>
                        <div class="form-check">
                            <input id="@($"{id}-attachments")" type="checkbox" class="form-check-input"
                                   aria-describedby="@(atlassian.IncludeAttachments && connection is { } shown && !atlassian.AttachmentScopeConfirmedFor(shown.Health)
                                       ? $"{id}-attachments-help {id}-attachments-scope-route"
                                       : $"{id}-attachments-help")"
                                   @bind="atlassian.IncludeAttachments" @bind:after="AttachmentsChanged" />
                            <label for="@($"{id}-attachments")" class="form-check-label">@AtlassianSourceSelection.IncludeAttachmentsLabel</label>
                            <div id="@($"{id}-attachments-help")" class="form-text mt-0">
                                @atlassian.AttachmentsShortHelp
                                @atlassian.AttachmentScopeHelpText
                                <a href="@AtlassianSourceSelection.MissingScopeGuideUrl" target="_blank" rel="noopener">How to add it<span class="visually-hidden"> (opens in a new tab)</span></a>.
                            </div>
                            @if (atlassian.IncludeAttachments && connection is { } site && !atlassian.AttachmentScopeConfirmedFor(site.Health))
                            {
                                <ConfluenceAttachmentScopeRoute Id="@($"{id}-attachments-scope-route")" ConnectionId="site.Id" SiteName="@site.Name"
                                                                Scope="@atlassian.RequiredAttachmentScope" />
                            }
                        </div>
                        <div class="ms-4 mt-2">
                            <label class="form-label small" for="@($"{id}-max-attachment-mb")">@AtlassianSourceSelection.MaxAttachmentMbLabel</label>
                            <input id="@($"{id}-max-attachment-mb")" type="number" class="form-control form-control-sm @(atlassian.MaxAttachmentMbError is null ? "" : "is-invalid")"
                                   min="@AtlassianSourceSelection.MinAttachmentMb" max="@AtlassianSourceSelection.MaxAttachmentMbLimit" style="max-width: 8rem;"
                                   aria-describedby="@(atlassian.MaxAttachmentMbError is null ? $"{id}-max-attachment-mb-help" : $"{id}-max-attachment-mb-error {id}-max-attachment-mb-help")"
                                   aria-invalid="@(atlassian.MaxAttachmentMbError is null ? null : "true")"
                                   disabled="@(!atlassian.IncludeAttachments)"
                                   @bind="atlassian.MaxAttachmentMb" @bind:after="ValidateMaxSize" @onblur="ValidateMaxSize" />
                            @if (atlassian.MaxAttachmentMbError is { } sizeError)
                            {
                                <div id="@($"{id}-max-attachment-mb-error")" class="invalid-feedback d-block fw-semibold" role="alert">
                                    <span class="bi-x-circle me-1" aria-hidden="true"></span>@sizeError
                                </div>
                            }
                            <div id="@($"{id}-max-attachment-mb-help")" class="form-text">
                                @AtlassianSourceSelection.MaxAttachmentMbHelp
                            </div>
                        </div>
                    </fieldset>
                </div>
            </section>
        }

        @if (form.GitHubKind == GitHubContentKind.IssuesAndPullRequests)
        {
            <section class="card mb-3">
                <div class="card-body">
                    <h2 class="h6 mb-3">Issues and pull requests</h2>
                    <div class="form-check mb-3">
                        <input id="include-comments" type="checkbox" class="form-check-input" @bind="form.IncludeComments" />
                        <label for="include-comments" class="form-check-label">Include comments</label>
                    </div>

                    @if (form.IncludeComments)
                    {
                        <p id="comment-authors-help" class="small text-muted mb-3">
                            Comments from bots, such as review bots and CI reports, are left out. People's comments are kept.
                            Descriptions are always kept, whoever wrote them. Change that for specific accounts here.
                            @if (authors.Count == 0)
                            {
                                <text>Suggestions appear once the source has synced.</text>
                            }
                        </p>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold" for="include-bots">Also index comments from these bots</label>
                            <AuthorPicker Id="include-bots" Selected="form.IncludedBots" Authors="authors"
                                          Suggest="a => a.IsBot" Placeholder="None — bots are left out" OnChanged="PickerChanged"
                                          Label="Bots whose comments are indexed" DescribedBy="comment-authors-help" />
                        </div>
                        <div>
                            <label class="form-label small fw-semibold" for="exclude-people">Leave out comments from these accounts</label>
                            <AuthorPicker Id="exclude-people" Selected="form.ExcludedPeople" Authors="authors"
                                          Suggest="a => !a.IsBot" Placeholder="None — everyone else is kept" OnChanged="PickerChanged"
                                          Label="Accounts whose comments are left out" DescribedBy="comment-authors-help" />
                        </div>
                    }
                </div>
            </section>
        }
        else if (form.GitHubKind == GitHubContentKind.Docs)
        {
            <section class="card mb-3">
                <div class="card-body">
                    <h2 class="h6 mb-3">Docs</h2>
                    <ProviderField Spec="GitHubFieldSpecs.DocPatterns" Small="true" CssClass="mb-0" @bind-Value="form.DocPatterns" />
                </div>
            </section>
        }

        @if (message is not null)
        {
            <div class="alert @(success ? "alert-success" : "alert-danger") small" role="@(success ? "status" : "alert")">
                <span class="@(success ? "bi-check-circle" : "bi-x-circle") me-1" aria-hidden="true"></span>@message
            </div>
        }

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-primary" @onclick="Save" disabled="@saving">
                @if (saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    <span>Saving…</span>
                }
                else
                {
                    <span>Save</span>
                }
            </button>
            <a class="btn btn-outline-secondary" href="/sources">Cancel</a>
            @if (form.ChangesScope(source))
            {
                <span class="small text-muted">Saving re-reads everything on the next sync, so the change applies throughout.</span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private Source? source;
    private Connection? connection;
    private SourceEditForm? form;
    private IReadOnlyList<GitHubCommentAuthor> authors = [];
    private string? loadError;
    private string? message;
    private bool success;
    private bool saving;
    private ElementReference nameInput;
    private ElementReference intervalInput;
    private bool holdsToken;
    private string? newToken;
    private string? tokenError;
    private bool tokenReplaced;
    private bool replacingToken;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            source = await SourceStore.GetAsync(Id);
            if (source is null)
            {
                loadError = "That source no longer exists.";
                return;
            }

            connection = source.ConnectionId is Guid connectionId ? await ConnectionStore.GetAsync(connectionId) : null;
            form = SourceEditForm.From(source, connection?.Provider);
            holdsToken = await TokenReplacement.AppliesToAsync(source, CancellationToken.None);

            // Read from the source's local records, so suggesting authors costs no GitHub requests.
            if (form.GitHubKind == GitHubContentKind.IssuesAndPullRequests && connection is not null
                && ConnectorFactory.Create(source, connection) is GitHubConnector github)
            {
                authors = github.CommentAuthors();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load source {SourceId} for editing", Id);
            loadError = "Could not load the source. Reload the page to try again; if it keeps failing, the server log has the cause.";
        }
    }

    /// <summary>Re-renders the page, so the note about a full re-read follows the pickers.</summary>
    private void PickerChanged() => message = null;

    /// <summary>The Atlassian site's address, which a Confluence scope does not hold itself.</summary>
    private string? SiteHost =>
        connection is { Provider: ConnectionProvider.Atlassian }
        && Connapse.Storage.Connectors.Atlassian.AtlassianSite.FromConfigJson(connection.ConfigJson) is { } site
            ? new Uri(site.SiteUrl).Host
            : null;

    private void ValidateMaxSize() => form?.Attachments?.ValidateMaxAttachmentMb();

    // As on the New source dialog: turning attachments off clears a size error; turning them on re-checks it.
    private void AttachmentsChanged()
    {
        if (form?.Attachments is { } atlassian && (atlassian.MaxAttachmentMbError is not null || !atlassian.IncludeAttachments))
            atlassian.ValidateMaxAttachmentMb();
    }

    private async Task ReplaceTokenAsync()
    {
        if (source is null) return;
        replacingToken = true;
        tokenError = null;
        tokenReplaced = false;
        try
        {
            CustomTokenReplacement result = await TokenReplacement.ReplaceAsync(source.Id, newToken, CancellationToken.None);
            if (result.Error is null)
            {
                newToken = null;
                tokenReplaced = true;
            }
            else
            {
                tokenError = result.Error;
            }
        }
        catch (Exception ex)
        {
            // An exception escaping a Blazor event handler tears down the circuit.
            Logger.LogError(ex, "Could not replace the token of source {SourceId}", source.Id);
            tokenError = "Could not replace the token, so the old one is still in use. Try again; if it keeps failing, the server log has the cause.";
        }
        finally
        {
            replacingToken = false;
        }
    }

    private async Task Save()
    {
        if (source is null || form is null) return;

        message = null;
        // Every error renders beside its own field, so nothing is repeated at the bottom.
        // Focus goes to the first field in error, so a screen reader hears it there.
        if (form.Validate() is not null)
        {
            if (form.NameError is not null) await nameInput.FocusAsync();
            else if (form.SyncIntervalError is not null) await intervalInput.FocusAsync();
            return;
        }

        var request = form.ToRequest(source);
        if (request is null)
        {
            (message, success) = ("Nothing changed.", true);
            return;
        }

        saving = true;
        try
        {
            bool rereads = request.ScopeJson is not null;
            var updated = await SourceStore.UpdateAsync(source.Id, request);
            if (updated is null)
            {
                (message, success) = ("That source no longer exists.", false);
                return;
            }

            await AuditLogger.LogAsync("source.updated", "source", source.Id.ToString(), new { updated.Name });
            source = updated;
            form = SourceEditForm.From(updated, connection?.Provider);
            (message, success) = (rereads
                ? "Saved. The next sync re-reads everything with the new settings — or sync it now from Sources."
                : "Saved.", true);
        }
        catch (Exception ex)
        {
            // An exception escaping a Blazor event handler tears down the circuit. The exception's
            // text is for the log, not the page: it can quote internals that mean nothing here.
            Logger.LogError(ex, "Could not save source {SourceId}", source.Id);
            (message, success) = ("Could not save the source, so nothing was changed. Try again; if it keeps failing, the server log has the cause.", false);
        }
        finally
        {
            saving = false;
        }
    }
}
