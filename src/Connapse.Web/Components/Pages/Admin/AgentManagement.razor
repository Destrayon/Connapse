@page "/admin/agents"
@attribute [Authorize(Policy = "RequireAdmin")]
@using Connapse.Application
@using Connapse.Application.Agents
@using Connapse.Core
@inject AgentOperations Agents
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject ILogger<AgentManagement> Logger
@rendermode InteractiveServer

<PageTitle>Agents - Connapse</PageTitle>

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="mb-1">
            <span class="bi-robot me-2"></span>
            Agents
        </h1>
        <p class="text-muted mb-0">
            Agents are non-human identities (scripts, workflows, bots) that access the API.
            Each agent has its own API keys used for authentication.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Create Agent -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">New Agent</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" @bind="newAgentName" placeholder="my-agent" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Description <span class="text-muted">(optional)</span></label>
                    <input type="text" class="form-control" @bind="newAgentDescription" placeholder="What does this agent do?" />
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-primary" @onclick="CreateAgentAsync" disabled="@isProcessing">
                        @if (isProcessing && processingAction == "create")
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Create Agent
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Agents List -->
    @if (agents.Count == 0)
    {
        <div class="card">
            <div class="card-body text-muted">No agents yet. Create one above.</div>
        </div>
    }
    else
    {
        @foreach (var agent in agents)
        {
            var isExpanded = selectedAgentId == agent.Id;
            var activeKeyCount = agent.Keys.Count(k => !k.IsRevoked);
            var activeKeys = selectedAgentKeys.Where(k => !k.IsRevoked).ToList();

            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <!-- Identity -->
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="fw-semibold">@agent.Name</span>
                                @if (agent.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(agent.Description))
                            {
                                <div class="text-muted small">@agent.Description</div>
                            }
                            <div class="text-muted small mt-1">
                                Created @agent.CreatedAt.ToString("MMM dd, yyyy")
                                &nbsp;·&nbsp;
                                <span class="@(activeKeyCount == 0 ? "text-warning" : "")">
                                    @activeKeyCount API @(activeKeyCount == 1 ? "key" : "keys")
                                </span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm @(isExpanded ? "btn-secondary" : "btn-outline-secondary")"
                                    @onclick="() => ToggleExpand(agent.Id)"
                                    disabled="@isProcessing">
                                <span class="bi-key me-1"></span>
                                API Keys
                            </button>
                            <button class="btn btn-sm @(agent.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                    @onclick="() => ToggleActiveAsync(agent)"
                                    disabled="@isProcessing">
                                @(agent.IsActive ? "Disable" : "Enable")
                            </button>
                            @if (confirmDeleteAgentId == agent.Id)
                            {
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => DeleteAgentAsync(agent.Id)"
                                        disabled="@isProcessing">
                                    Confirm Delete
                                </button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => confirmDeleteAgentId = null">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => confirmDeleteAgentId = agent.Id"
                                        disabled="@isProcessing">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>

                    <!-- API Keys Panel -->
                    @if (isExpanded)
                    {
                        <hr class="mt-3 mb-3" />

                        <div class="mb-3">
                            <h6 class="mb-1">API Keys</h6>
                            <p class="text-muted small mb-0">
                                Use these keys to authenticate API requests as this agent.
                                Pass the key in the <code>X-Api-Key</code> header.
                                Keys are only shown once when created.
                            </p>
                        </div>

                        <!-- One-time key display -->
                        @if (newKeyAgentId == agent.Id && newKeyResponse is not null)
                        {
                            <div class="alert alert-success alert-dismissible mb-3">
                                <strong>Key created — copy it now.</strong> It won't be shown again.
                                <div class="input-group mt-2">
                                    <input type="text" class="form-control font-monospace"
                                           value="@newKeyResponse.Token" readonly id="new-agent-key-token" />
                                    <button class="btn btn-outline-secondary" @onclick="CopyKeyToken" type="button">
                                        <span class="bi-clipboard me-1"></span>Copy
                                    </button>
                                </div>
                                <button type="button" class="btn-close"
                                        @onclick="() => { newKeyResponse = null; newKeyAgentId = null; }"></button>
                            </div>
                        }

                        <!-- Active keys table -->
                        @if (activeKeys.Count > 0)
                        {
                            <table class="table table-sm mb-3">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Prefix</th>
                                        <th>Created</th>
                                        <th>Last used</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var key in activeKeys)
                                    {
                                        <tr>
                                            <td class="align-middle">@key.Name</td>
                                            <td class="align-middle font-monospace text-muted small">@key.TokenPrefix…</td>
                                            <td class="align-middle text-muted small">@key.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="align-middle text-muted small">@(key.LastUsedAt?.ToString("MMM dd, yyyy") ?? "Never")</td>
                                            <td class="align-middle text-end">
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => RevokeKeyAsync(agent.Id, key.Id)"
                                                        disabled="@isProcessing">
                                                    Revoke
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted small mb-3">No active keys. Add one below.</p>
                        }

                        <!-- Add key form -->
                        <div class="d-flex gap-2 align-items-end">
                            <div>
                                <label class="form-label small mb-1">Key name</label>
                                <input type="text" class="form-control form-control-sm"
                                       style="width: 220px;"
                                       @bind="newKeyName" placeholder="e.g. production" />
                            </div>
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" id="new-key-approval-@agent.Id" @bind="newKeyRequiresApproval" />
                                <label class="form-check-label small" for="new-key-approval-@agent.Id">Ask before it deletes anything over MCP</label>
                            </div>
                            <div class="mb-1">
                                @foreach (var scope in TokenScopeChoices.AgentKey)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="new-key-scope-@agent.Id-@scope"
                                               checked="@newKeyScopes.Contains(scope)"
                                               @onchange="e => newKeyScopes.SymmetricExceptWith([scope])" />
                                        <label class="form-check-label small" for="new-key-scope-@agent.Id-@scope"><code>@scope</code></label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => CreateKeyAsync(agent.Id)"
                                    disabled="@isProcessing">
                                Add Key
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private string newAgentName = "";
    private string newAgentDescription = "";
    private string newKeyName = "";
    private bool newKeyRequiresApproval = true;
    // A key can do only what its scopes allow over MCP; one issued with none can call no tool (#932).
    private readonly HashSet<string> newKeyScopes = [TokenScopeChoices.Default];
    private bool isProcessing;
    private string processingAction = "";
    private Guid? selectedAgentId;
    private IReadOnlyList<AgentKeyListItem> selectedAgentKeys = [];
    private Guid? confirmDeleteAgentId;
    private Guid? newKeyAgentId;
    private CreateAgentKeyResponse? newKeyResponse;
    private string? statusMessage;
    private bool statusSuccess;
    private OperationContext context = null!;

    private IReadOnlyList<AgentDto> agents = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        context = new OperationContext(authState.User, OperationSurface.Ui);

        await LoadAgentsAsync();
    }

    private async Task LoadAgentsAsync()
    {
        agents = await ShownAsync(Agents.List.RunAsync(context), agents, "The agents couldn't be loaded. Reload the page to try again.");
    }

    /// <summary>The open agent's keys, through agents.keys.list.</summary>
    private async Task LoadKeysAsync(Guid agentId)
    {
        // Only this agent's keys are kept on a failure: another agent's would read as this one's.
        selectedAgentKeys = await ShownAsync(Agents.ListKeys.RunAsync(context, agentId), selectedAgentId == agentId ? selectedAgentKeys : [],
            "The agent's keys couldn't be loaded. Reload the page to try again.");
    }

    /// <summary>
    /// A read's result, or none with its failure shown. A read that throws leaves what's on screen, so a
    /// key just created stays there when only the refresh after it fails.
    /// </summary>
    private async Task<IReadOnlyList<T>> ShownAsync<T>(Task<Attempt<IReadOnlyList<T>, AgentStatus>> read, IReadOnlyList<T> current, string failure)
    {
        try
        {
            var result = await read;
            if (!result.Succeeded)
                Say(result.Detail, false);
            return result.Result ?? [];
        }
        catch (Exception ex)
        {
            Failed(ex, failure);
            return current;
        }
    }

    /// <summary>
    /// Runs one of the page's changes with the page busy. An unexpected error, such as the database being
    /// unreachable, shows <paramref name="failure"/> rather than ending the page.
    /// </summary>
    private async Task RunAsync(string failure, Func<Task> change)
    {
        isProcessing = true;
        statusMessage = null;
        try
        {
            await change();
        }
        catch (Exception ex)
        {
            Failed(ex, failure);
        }
        finally
        {
            isProcessing = false;
            processingAction = "";
        }
    }

    private void Failed(Exception ex, string failure)
    {
        Logger.LogError(ex, "Agents page: {Failure}", failure);
        Say(failure, false);
    }

    private void Say(string? message, bool success)
    {
        statusMessage = message;
        statusSuccess = success;
    }

    private async Task ToggleExpand(Guid agentId)
    {
        // One load at a time: the page's operations share one DbContext, which can't run two queries at once.
        if (isProcessing)
            return;
        if (selectedAgentId == agentId)
        {
            selectedAgentId = null;
            selectedAgentKeys = [];
        }
        else
        {
            // The keys first, so the panel opens once, with them, rather than empty and then again.
            isProcessing = true;
            await LoadKeysAsync(agentId);
            isProcessing = false;
            selectedAgentId = agentId;
            newKeyName = "";
            newKeyRequiresApproval = true;
            newKeyScopes.Clear();
            newKeyScopes.Add(TokenScopeChoices.Default);
            newKeyResponse = null;
            newKeyAgentId = null;
        }
    }

    private Task CreateAgentAsync()
    {
        processingAction = "create";
        return RunAsync("The agent couldn't be created. Try again.", async () =>
        {
            var created = await Agents.Create.RunAsync(context, new CreateAgentRequest(newAgentName, newAgentDescription));
            if (!created.Succeeded)
            {
                Say(created.Detail, false);
                return;
            }
            Say($"Agent '{created.Result!.Name}' created.", true);
            newAgentName = "";
            newAgentDescription = "";
            await LoadAgentsAsync();
        });
    }

    private Task ToggleActiveAsync(AgentDto agent) => RunAsync("The agent couldn't be updated. Try again.", async () =>
    {
        var set = await Agents.SetActive.RunAsync(context, new SetAgentActiveCommand(agent.Id, !agent.IsActive));
        if (!set.Succeeded)
        {
            Say(set.Detail, false);
            return;
        }
        Say($"Agent '{agent.Name}' updated.", true);
        await LoadAgentsAsync();
    });

    private Task DeleteAgentAsync(Guid agentId)
    {
        confirmDeleteAgentId = null;
        return RunAsync("The agent couldn't be deleted. Try again.", async () =>
        {
            var deleted = await Agents.Delete.RunAsync(context, agentId);
            if (!deleted.Succeeded)
            {
                Say(deleted.Detail, false);
                return;
            }
            Say("Agent deleted.", true);
            if (selectedAgentId == agentId)
            {
                selectedAgentId = null;
                selectedAgentKeys = [];
            }
            await LoadAgentsAsync();
        });
    }

    private Task CreateKeyAsync(Guid agentId) => RunAsync("The key couldn't be created. Try again.", async () =>
    {
        var created = await Agents.CreateKey.RunAsync(context, new CreateAgentKeyCommand(agentId, new CreateAgentKeyRequest(newKeyName,
            [.. TokenScopeChoices.AgentKey.Where(newKeyScopes.Contains)], RequiresApproval: newKeyRequiresApproval)));
        if (!created.Succeeded)
        {
            Say(created.Detail, false);
            return;
        }
        newKeyResponse = created.Result;
        newKeyAgentId = agentId;
        newKeyName = "";
        await LoadAgentsAsync();
        await LoadKeysAsync(agentId);
    });

    private Task RevokeKeyAsync(Guid agentId, Guid keyId) => RunAsync("The key couldn't be revoked. Try again.", async () =>
    {
        var revoked = await Agents.RevokeKey.RunAsync(context, new AgentKeyTarget(agentId, keyId));
        if (!revoked.Succeeded)
        {
            Say(revoked.Detail, false);
            return;
        }
        Say("Key revoked.", true);
        if (newKeyAgentId == agentId)
        {
            newKeyResponse = null;
            newKeyAgentId = null;
        }
        await LoadAgentsAsync();
        await LoadKeysAsync(agentId);
    });

    private async Task CopyKeyToken()
    {
        if (newKeyResponse is null) return;
        var copied = await JS.InvokeAsync<bool>("connapse.copyToClipboard", newKeyResponse.Token);
        statusMessage = copied ? "Token copied to clipboard!" : "Could not copy. Please copy it manually.";
        statusSuccess = copied;
    }
}
