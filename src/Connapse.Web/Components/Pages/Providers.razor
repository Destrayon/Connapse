        await SaveSamlSettings(updated);

        if (saveSuccess)
            pastedMetadata = null;
    }

    /// <summary>The block an administrator pasted back from the group command.</summary>
    private string? pastedGroup;

    /// <summary>
    /// Records the group so a connection can print a grant command naming it.
    /// </summary>
    /// <remarks>
    /// Written onto the sign-in settings rather than onto the located instance. The instance is
    /// only "where is the directory"; a group exists solely to be the grantee on an access grant,
    /// which is what per-user permissions are made of. A connection may still name a different
    /// grantee, because granting separate teams separate buckets is the point of groups.
    /// </remarks>
    private async Task SaveGrantGroup((string Id, string Name) group)
    {
        var updated = new SamlSignInSettings
        {
            EntityId = samlSettings.EntityId,
            AcsUrl = samlSettings.AcsUrl,
            IdpEntityId = samlSettings.IdpEntityId,
            IdpSingleSignOnUrl = samlSettings.IdpSingleSignOnUrl,
            IdpSigningCertificate = samlSettings.IdpSigningCertificate,
            GrantGroupId = group.Id,
            GrantGroupName = group.Name,
        };

        await SaveSamlSettings(updated);

        // Cleared only on success, so a failed save leaves the block in the box rather than sending
        // somebody back to a terminal whose scrollback may be gone.
        if (saveSuccess)
            pastedGroup = null;
    }

