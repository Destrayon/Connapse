    /// <summary>
    /// Clears the recorded pool, for an administrator who removed it in AWS.
    /// </summary>
    /// <remarks>
    /// Connapse has no way to notice: it holds no credential that may read the account, and asking
    /// AWS on every page load would be the beginning of one. So the values simply persist, and the
    /// worst of them is the SAML audience — it is built from the pool id, so a stale one reads as
    /// perfectly valid while naming a pool that no longer exists.
    /// </remarks>
    private async Task ClearSamlApplication()
    {
        // Enforcement is deliberately left on. Clearing the application makes the sign-in settings
        // incomplete, which the scope resolver reads as EnforcingButUnusable and denies — searches
        // return nothing for everyone until the application is set up again, rather than silently
        // widening the whole corpus to every user.
        //
        // Built from CurrentValue, not the samlSettings snapshot captured at page load: on a
        // long-lived page another administrator may have changed the group since, and rebuilding
        // from the stale copy would write that obsolete value back.
        await SaveSamlSettings(GrantGroupOnly(SamlOptions.CurrentValue));

        if (saveSuccess)
        {
            pastedMetadata = null;
            showSamlManual = true;
        }
    }

    private async Task ClearGrantGroup()
    {
        // CurrentValue, not the page-load snapshot: another administrator may have rotated the
        // certificate or issuer since this page opened, and rebuilding the SAML fields from the
        // stale copy would revert that rotation.
        await SaveSamlSettings(WithoutGrantGroup(SamlOptions.CurrentValue));

        if (saveSuccess)
            pastedGroup = null;
    }

    /// <summary>The SAML application settings without the default grant group.</summary>
    private static SamlSignInSettings WithoutGrantGroup(SamlSignInSettings from) => new()
    {
        EntityId = from.EntityId,
        AcsUrl = from.AcsUrl,
        IdpEntityId = from.IdpEntityId,
        IdpSingleSignOnUrl = from.IdpSingleSignOnUrl,
        IdpSigningCertificate = from.IdpSigningCertificate,
    };

    /// <summary>Only the default grant group, without the SAML application settings.</summary>
    private static SamlSignInSettings GrantGroupOnly(SamlSignInSettings from) => new()
    {
        GrantGroupId = from.GrantGroupId,
        GrantGroupName = from.GrantGroupName,
    };

    /// <summary>Generates a fresh CA + leaf pair and reveals the CloudShell command.</summary>
    /// <remarks>
    /// Generated once and cached: the CA cert is embedded in the command and the leaf is what will be
    /// stored, so the two must stay paired. Regenerating deliberately mints a new pair (the button
    /// says so), which is why any prior paste-back is discarded — a script from the old CA would
    /// register a trust anchor the new leaf does not chain to.
    /// </remarks>
    private void PrepareRolesAnywhereScript()
    {
        raKeypair = RolesAnywhereKeyGenerator.Generate();
        raPasted = null;
        copyMessage = null;
    }

    private async Task CopyRolesAnywhereScript()
    {
        if (raKeypair is null) return;

        // Through the shared helper: navigator.clipboard is undefined outside a secure context, and
        // Connapse is routinely served over plain HTTP on a LAN.
        copySucceeded = await JS.InvokeAsync<bool>("connapse.copyToClipboard",
            AwsRolesAnywhereSetup.GenerateScript(raKeypair.CaCertificatePem, raRegion));

        copyMessage = copySucceeded
            ? "Copied."
            : "Could not copy — select the command above and copy it manually.";
    }

    private async Task CopyResetCleanup()
    {
        if (raResetCleanup is null) return;

        copySucceeded = await JS.InvokeAsync<bool>("connapse.copyToClipboard", raResetCleanup);
        copyMessage = copySucceeded
            ? "Copied."
            : "Could not copy — select the snippet above and copy it manually.";
    }

    /// <summary>Saves the credential from the script's ARN block, pairing them with the generated leaf.</summary>
    private async Task SaveRolesAnywhereFromScript(AwsRolesAnywhereArns arns)
    {
        if (raKeypair is null) return;

        var config = new RolesAnywhereConfig(
            raKeypair.LeafCertificatePem, arns.TrustAnchorArn, arns.ProfileArn, arns.RoleArn, arns.Region);

        await SaveValidatedRolesAnywhere(config, raKeypair.LeafPrivateKeyPem, null);
    }

    /// <summary>Saves a bring-your-own credential typed into the manual-values form.</summary>
    private async Task SaveManualRolesAnywhere()
    {
        if (!CanSaveManualRa) return;

        var config = new RolesAnywhereConfig(
            manualCertPem!.Trim(), manualTrustAnchorArn!.Trim(), manualProfileArn!.Trim(),
            manualRoleArn!.Trim(), manualRegion!.Trim());

        await SaveValidatedRolesAnywhere(config, manualPrivateKeyPem!.Trim(), null);
    }

    /// <summary>
    /// The one save path for every Roles Anywhere credential: prove it, then persist it.
    /// </summary>
    /// <remarks>
    /// <c>SaveRolesAnywhereAsync</c> overwrites irreversibly, so the credential is checked against AWS
    /// first (a real <c>CreateSession</c>) and stored only if that succeeds. A bad cert, ARN, or
    /// region therefore never destroys the last working credential — nothing is written on failure,
    /// and the form is left intact so the operator can fix and retry without regenerating.
    /// </remarks>
    private async Task SaveValidatedRolesAnywhere(RolesAnywhereConfig config, string privateKeyPem, string? principal)
    {
        awsBusy = true;
        try
        {
            RolesAnywhereValidationResult result = await RaValidator.ValidateAsync(config, privateKeyPem);
            if (!result.Ok)
            {
                saveSuccess = false;
                saveMessage = $"AWS did not accept this credential, so nothing was changed: {result.Error}";
                return;
            }

            await CredentialStore.SaveRolesAnywhereAsync("aws", config, privateKeyPem, principal, null);

            // The secret material is not kept around once stored; the whole handshake resets.
            raKeypair = null;
            raPasted = null;
            raRegion = null;
            raResetCleanup = null;
            manualTrustAnchorArn = manualProfileArn = manualRoleArn = manualRegion = null;
            manualCertPem = manualPrivateKeyPem = null;
            showSetup = false;
            copyMessage = null;

            saveSuccess = true;
            saveMessage = "AWS Roles Anywhere access saved.";
            await RefreshSetups();
        }
        catch (Exception ex)
        {
            // Entries left alone on failure. An exception escaping a Blazor event handler tears down
            // the circuit and clears the form, and a generated leaf can only be reissued from a fresh
            // CloudShell run — so a momentary database error must not cost the operator the round-trip.
            saveSuccess = false;
            saveMessage = $"Could not store the AWS credential: {ex.Message} " +
                          "Your entries are still below — try again.";
        }
        finally
        {
            awsBusy = false;
        }
    }

    /// <summary>
    /// Clears this instance's Roles Anywhere credential, then offers to remove the AWS-side resources.
    /// </summary>
    /// <remarks>
    /// The local wipe comes first and is what actually protects the operator: it stops this instance
    /// authenticating immediately, independent of any AWS call. The AWS trust anchor, role, and
    /// profile are per-instance, so a CloudShell cleanup snippet is shown afterwards to remove them —
    /// Connapse's own read-only identity cannot delete them directly. Nothing shared is ever touched,
    /// because in the per-instance design nothing is shared.
    /// </remarks>
    private async Task ResetAccessIdentity()
    {
        awsBusy = true;
        try
        {
            // Read the ARNs before wiping so the cleanup snippet can name them.
            RolesAnywhereConfig? config = await CredentialStore.GetRolesAnywhereAsync("aws");

            await CredentialStore.DeleteAsync("aws");

            raResetCleanup = config is null
                ? null
                : AwsRolesAnywhereSetup.GenerateResetScript(
                    config.TrustAnchorArn, config.ProfileArn, config.RoleArn, config.Region);

            raKeypair = null;
            raPasted = null;
            showSetup = true;
            saveSuccess = true;
            saveMessage = raResetCleanup is null
                ? "Connapse's stored AWS credential was removed."
                : "Connapse's stored AWS credential was removed. It is still valid in AWS until you "
                  + "run the cleanup command shown below, or it expires.";
            await RefreshSetups();
        }
        catch (Exception ex)
        {
            saveSuccess = false;
            saveMessage = $"Could not clear the AWS credential: {ex.Message}";
        }
        finally
        {
            awsBusy = false;
        }
    }

    /// <summary>Loads whether a Roles Anywhere credential is stored, which drives the card's mode.</summary>
    private async Task LoadAwsCredentialModeAsync()
    {
        if (Key != "aws") return;

        try
        {
            hasStoredRaCredential = await CredentialStore.GetRolesAnywhereAsync("aws") is not null;
        }
        catch (Exception ex)
        {
            // A read failure should not strand the card. Treat it as no stored row and let the probe
            // status speak; the card degrades to the setup path rather than throwing.
            Logger.LogWarning(ex, "Could not read the stored AWS Roles Anywhere credential");
            hasStoredRaCredential = false;
        }
    }

    /// <summary>Scrolls to a section of this page, and opens whatever it is you came to change.</summary>
    /// <remarks>
    /// Each requirement that is already satisfied shows its section as a summary, so scrolling
    /// alone lands on something with nothing to do on it — and on a tall enough window it does not
    /// even move, which is indistinguishable from a dead link. Both sections are therefore opened
    /// before the scroll rather than after somebody hunts for the button that opens them.
    /// <para>
    /// Only these three need it. Every other action on a requirement card is a real link
    /// elsewhere. A section missing from this list scrolls to a card that is collapsed, which
    /// reads as the button doing nothing at all.
    /// </para>
    /// </remarks>
    private async Task ScrollTo(string elementId)
    {
        showSetup = elementId == "access" || showSetup;
        showIdentityCenterSetup = elementId == "identity-center" || showIdentityCenterSetup;
        showSamlManual = elementId == "permissions" || showSamlManual;

        await JS.InvokeVoidAsync("connapse.scrollToId", elementId);
    }

    private async Task RefreshSetups()
    {
        setups = null;
        StateHasChanged();
        setups = await SetupReader.ReadAsync();
        await LoadAwsCredentialModeAsync();
    }

    /// <summary>What a provider would let you do, for one you have not taken up.</summary>
    /// <remarks>
    /// Says what it is for rather than what is missing. Somebody scanning this list is deciding
    /// whether they need the provider at all, and "Sign-in not configured" answers a question
    /// they have not asked yet.
    /// </remarks>
    private static string Offer(ProviderSetup provider) => provider.Key switch
    {
        "aws" => "Read files from S3.",
        "azure" => "Sign in with Azure AD, and read files from Blob Storage.",
        _ => $"Set up {provider.DisplayName}."
    };

    /// <summary>One line naming what still needs doing, for the list.</summary>
    /// <remarks>
    /// Names the outstanding requirements rather than counting them. "1 of 2" tells the reader how
    /// much is left but not what, and only the latter is something they can act on.
    /// </remarks>
    private static string Summarise(ProviderSetup provider)
    {
        var outstanding = provider.Requirements
            .Where(r => r.Status != RequirementStatus.Satisfied)
            .Select(r => r.Name)
            .ToList();

        return outstanding.Count == 0
            ? "Everything Connapse needs is set up."
            : $"Needs attention: {string.Join(", ", outstanding)}";
    }

    private async Task SaveAzureAdSettings(AzureAdSettings settings)
    {
        azureAdSettings = settings;
        await SaveSettings("azuread", settings);
        await RefreshSetups();
    }

    /// <summary>What the settings form saves. Never stops enforcement.</summary>
    /// <remarks>
    /// A named wrapper rather than binding the method below directly: an editing form has no
    /// business being able to switch permission enforcement off, and this way it cannot express it.
    /// </remarks>
    private Task SaveSamlSettingsFromForm(SamlSignInSettings settings) =>
        SaveSamlSettings(settings);

    /// <summary>
    /// Stores the sign-in settings, and decides whether permissions are still being enforced.
    /// </summary>
    /// <remarks>
    /// The latch lives here rather than on the form because several callers above rebuild this
    /// object field by field, and every one of them would otherwise clear the flag by omission —
    /// which is precisely the silent un-enforcement this choke point exists to prevent.
    /// <para>
    /// A complete configuration turns enforcement on, and nothing here turns it back off: once on,
    /// it stays on until the application is completely reconfigured. An incomplete save — blanking
    /// the certificate to paste a rotated one, or resetting the application entirely — leaves the
    /// flag in force, so the searches deny while the settings are incomplete. That is the loud
    /// failure rather than the quiet one: no path through this page silently widens the corpus.
    /// </para>
    /// </remarks>
    private async Task SaveSamlSettings(SamlSignInSettings settings)
    {
        // Written to its own category, so recording enforcement never rewrites a SAML value. That
        // matters for a deployment configured through environment variables: the database outranks
        // the environment, so copying those values into a row here would shadow them permanently.
        bool enforcing = settings.IsConfigured || EnforcementOptions.CurrentValue.IsEnforcing;

        await SaveSettings("samlsignin", settings);

        if (saveSuccess && enforcing != EnforcementOptions.CurrentValue.IsEnforcing)
        {
            await SaveSettings(
                PermissionEnforcementSettings.Category,
                new PermissionEnforcementSettings { IsEnforcing = enforcing });
        }

        // What was posted, not a re-read of CurrentValue. The options reload behind SaveSettings is
        // not guaranteed to have landed by the time this line runs, so a stale read would hand the
        // form back the previous values and make a save look as though it had not taken. Guarded on
        // success so a failed save leaves the form showing what is actually stored.
        if (saveSuccess) samlSettings = settings;

        await RefreshSetups();
    }

    @* Two labels, because Warning means two different things depending on what carries it, and one
       switch serving both put "Partly set up" on a card for something that was not partly anything.
       Every other status reads the same at either scale, so both switches fall through to Label. *@

    /// <summary>The badge on a whole provider.</summary>
    private static string ProviderLabel(RequirementStatus status) => status switch
    {
        // Some requirements met and some not. A complete label, unlike "Works, but", which left
        // the reader holding an unfinished sentence in a chip four words wide.
        RequirementStatus.Warning => "Partly set up",
        _ => Label(status)
    };

    /// <summary>The badge on one requirement.</summary>
    private static string RequirementLabel(RequirementStatus status) => status switch
    {
        // A single requirement has no parts to be partly through. Warning here means the one
        // thing it has ever meant: this works, and Connapse cannot demonstrate that it does.
        RequirementStatus.Warning => "Unconfirmed",
        _ => Label(status)
    };

    private static string Label(RequirementStatus status) => status switch
    {
        RequirementStatus.Satisfied => "Ready",
        RequirementStatus.Provisioning => "Provisioning",
        RequirementStatus.Failed => "Failed",
        RequirementStatus.NotConfigured => "Not set up",
        _ => "Unknown"
    };

    private static string BadgeClass(RequirementStatus status) => status switch
    {
        RequirementStatus.Satisfied => "text-bg-success",
        // The only red on the page. Something the administrator already did did not take, which is
        // a different thing from a fresh install with a next step.
        RequirementStatus.Failed => "text-bg-danger",
        RequirementStatus.Provisioning => "text-bg-info",
        RequirementStatus.Warning => "text-bg-warning",
        // Not "danger": nothing is broken, it simply has not been done, and colouring a fresh
        // install red tells the reader they have a problem rather than a next step.
        RequirementStatus.NotConfigured => "text-bg-secondary",
        _ => "text-bg-light"
    };

    private static string IconClass(RequirementStatus status) => status switch
    {
        RequirementStatus.Satisfied => "bi-check-circle-fill text-success",
        RequirementStatus.Failed => "bi-x-circle-fill text-danger",
        RequirementStatus.Provisioning => "bi-hourglass-split text-info",
        RequirementStatus.Warning => "bi-exclamation-triangle-fill text-warning",
        RequirementStatus.NotConfigured => "bi-circle text-secondary",
        _ => "bi-question-circle text-secondary"
    };

    private async Task SaveSettings<T>(string category, T settings) where T : class
    {
        try
        {
            await SettingsStore.SaveAsync(category, settings);
            ReloadService.Reload();
            saveMessage = $"{SettingsName(category)} settings saved successfully!";
            saveSuccess = true;
        }
        catch (Exception ex)
        {
            saveMessage = $"Failed to save {SettingsName(category)} settings: {ex.Message}";
            saveSuccess = false;
        }
    }

    /// <summary>What to call a settings category in a sentence.</summary>
    /// <remarks>
    /// The category is a storage key — lower-case, no spaces — and reading it back to somebody as
    /// "samlsignin settings saved successfully" shows them the key rather than a readable name.
    /// Unlisted categories fall through unchanged, which is what they did before this existed.
    /// </remarks>
    private static string SettingsName(string category) => category switch
    {
        "samlsignin" => "AWS sign-in",
        _ => category
    };
}
