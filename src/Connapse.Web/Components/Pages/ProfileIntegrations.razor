@page "/profile/integrations"
@layout ProfileLayout
@attribute [Authorize]
@using Connapse.Core
@using Connapse.Identity.Services
@using Connapse.Web.Components.Layout
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@inject IAwsIdentityLinkService AwsIdentityLinkService
@inject IAzureIdentityLinkService AzureIdentityLinkService
@inject GitHubIdentityLinkStore GitHubIdentityLinks
@inject GitHubLinkFlow GitHubLinkFlow
@inject Connapse.Storage.Connectors.GitHub.ConnapseGitHubApp GitHubApp
@inject IOptionsMonitor<SamlSignInSettings> SamlOptions
@inject IOptionsMonitor<AzureAdSignInSettings> AzureAdOptions
@inject IOptionsMonitor<PermissionEnforcementSettings> EnforcementOptions
@inject EnforcementMigration Migration
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ILogger<ProfileIntegrations> Logger
@inject Connapse.Core.Interfaces.IAuditLogger AuditLogger
@rendermode InteractiveServer

<PageTitle>Integrations - Connapse</PageTitle>

<div class="container-fluid py-4" style="max-width: 900px;">
    <!-- Page heading -->
    <div class="d-flex align-items-center mb-4">
        <span class="bi-plug-fill me-2 text-accent" style="font-size: 1.5rem;"></span>
        <h1 class="h3 mb-0">Integrations</h1>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="@(statusSuccess ? "status" : "alert")">
            <span class="@(statusSuccess ? "bi-check-circle" : "bi-x-circle") me-2" aria-hidden="true"></span>@statusMessage
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- Cloud Identities Section -->
    <div class="mb-3 d-flex align-items-center">
        <span class="bi-cloud-fill me-2 text-accent"></span>
        <h2 class="h5 mb-0">Cloud Identities</h2>
    </div>
    <p class="text-muted small mb-4">
        Link your cloud account so Connapse knows who you are. This card stores identity
        metadata only — no access keys, no tokens — and linking does not grant Connapse access to
        your storage. Connecting AWS records which IAM Identity Center user you are, so that what
        you may read can be looked up later; nothing that could act as you is kept.
        <br />
        @* What linking actually does here depends on whether this deployment enforces per-user
           permissions, and saying the wrong one of these is worse than saying nothing: telling
           somebody their results are unfiltered when they are filtered sends them hunting for a
           bug, and the reverse tells them they are protected when they are not. *@
        @switch (awsEnforcement)
        {
            case EnforcementState.Enforcing:
                <strong>Your search results are filtered to what you may read.</strong>
                <text>
                    Once your AWS account is linked, searches return only documents covered by an
                    S3 access grant held by you or a group you belong to. Removing a grant, or
                    disabling you in the directory, takes effect within a minute.
                </text>
                break;

            case EnforcementState.EnforcingButUnusable:
                <strong>Per-user permissions are enabled but cannot be applied.</strong>
                <text>
                    Searches are being refused rather than answered without filtering. An
                    administrator needs to finish the AWS sign-in settings under Providers.
                </text>
                break;

            default:
                <strong>Linking AWS does not filter your search results on this deployment.</strong>
                <text>
                    Per-user search permissions have not been set up, so every Connapse user can
                    search everything indexed, whether or not an account is linked. An
                    administrator turns this on under Providers.
                </text>
                break;
        }
        <br />
        <strong>GitHub:</strong> public repositories are searchable by everyone. Linking GitHub lets
        you find content from private repositories you can read on GitHub.
    </p>

    <div class="row g-3">
        <!-- AWS Permissions Identity Card -->
        <div class="col-md-6">
            <div class="card h-100 provider-card @(awsIdentity is not null ? "provider-connected" : "")"
                 style="--provider-color: #f59e0b;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 40px; height: 40px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25);">
                            <span class="bi-shield-lock" style="font-size: 1.1rem; color: #f59e0b;"></span>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <strong>Amazon Web Services (Permissions)</strong>
                        </div>
                        @if (awsIdentity is not null)
                        {
                            <span class="badge rounded-pill" style="background: color-mix(in srgb, var(--color-success) 15%, transparent); color: color-mix(in srgb, var(--color-success) 70%, white); border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent);">
                                <span class="bi-check-circle-fill me-1"></span>Connected
                            </span>
                        }
                    </div>

                    @if (!awsSignInConfigured)
                    {
                        <div class="rounded-3 p-3" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.2);">
                            <small class="d-flex align-items-start" style="color: #fbbf24;">
                                <span class="bi-info-circle-fill me-2 mt-1 flex-shrink-0"></span>
                                <span>AWS permissions are not set up yet. An administrator configures this under Providers &rarr; Amazon Web Services before anyone can connect.</span>
                            </small>
                        </div>
                    }
                    else if (awsIdentity is not null)
                    {
                        <div class="d-flex flex-column gap-2 mb-3">
                            <div>
                                <small class="text-muted d-block">Connected as</small>
                                @if (!string.IsNullOrWhiteSpace(awsIdentity.DirectoryUserName))
                                {
                                    <span class="small">@awsIdentity.DirectoryUserName</span>
                                    @if (!string.IsNullOrWhiteSpace(awsIdentity.Email))
                                    {
                                        <span class="small text-muted"> &middot; @awsIdentity.Email</span>
                                    }
                                }
                                else
                                {
                                    <span class="small text-warning">
                                        Connected before this deployment recorded directory user
                                        names. Disconnect and connect again, or permissions will not
                                        resolve.
                                    </span>
                                }
                            </div>
                            <div class="d-flex gap-4">
                                <div>
                                    <small class="text-muted d-block">Connected</small>
                                    <small>@awsIdentity.ConnectedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                @if (awsIdentity.LastUsedAt is not null)
                                {
                                    <div>
                                        <small class="text-muted d-block">Last used</small>
                                        <small>@awsIdentity.LastUsedAt.Value.ToString("MMM dd, yyyy")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-2">
                            Separate from the AWS sign-in card above, which carries no permission
                            information. Connecting here lets Connapse check your AWS permissions
                            once per-user search filtering is switched on — it does not filter your
                            search results today.
                        </p>
                        @* There is no longer anything between Connapse and the directory to
                           name: the sign-in goes straight to Identity Center. *@
                        <p class="text-muted small mb-0">
                            <span class="bi-box-arrow-up-right me-1"></span>
                            You sign in at <strong>AWS IAM Identity Center</strong> with the
                            credentials and multi-factor you already use — not in Connapse, which
                            never sees what you type there.
                        </p>
                    }
                </div>
                @if (awsIdentity is not null)
                {
                    <!-- Always reachable, even if an admin cleared the AWS sign-in settings after
                         this user connected: disconnecting must never depend on
                         awsSignInConfigured, or a connected row becomes unremovable through any
                         surface. Nothing about the removal needs AWS to be reachable — the row is
                         local and holds no credential — so there is no not-configured case left to
                         handle. -->
                    <div class="card-footer border-top-0 px-4 pb-4 pt-0">
                        @if (confirmDisconnectAws)
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-danger" @onclick="DisconnectAwsAsync" disabled="@isProcessing">
                                    Confirm Disconnect
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDisconnectAws = false">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDisconnectAws = true" disabled="@isProcessing">
                                <span class="bi-x-circle me-1"></span>Disconnect
                            </button>
                        }
                    </div>
                }
                else if (awsSignInConfigured)
                {
                    <div class="card-footer border-top-0 px-4 pb-4 pt-0">
                        <button class="btn btn-sm btn-primary" @onclick="ConnectAwsAsync" disabled="@isProcessing">
                            <span class="bi-box-arrow-up-right me-1"></span>Continue to AWS sign-in
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Azure (Entra ID) Identity Card -->
        <div class="col-md-6">
            <div class="card h-100 provider-card @(azureIdentity is not null ? "provider-connected" : "")"
                 style="--provider-color: #0078d4;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 40px; height: 40px; background: rgba(0, 120, 212, 0.1); border: 1px solid rgba(0, 120, 212, 0.25);">
                            <span class="bi-shield-lock" style="font-size: 1.1rem; color: #0078d4;"></span>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <strong>Microsoft Entra ID</strong>
                        </div>
                        @if (azureIdentity is not null)
                        {
                            <span class="badge rounded-pill" style="background: color-mix(in srgb, var(--color-success) 15%, transparent); color: color-mix(in srgb, var(--color-success) 70%, white); border: 1px solid color-mix(in srgb, var(--color-success) 30%, transparent);">
                                <span class="bi-check-circle-fill me-1"></span>Connected
                            </span>
                        }
                    </div>

                    @if (!azureSignInConfigured)
                    {
                        <div class="rounded-3 p-3" style="background: rgba(0, 120, 212, 0.08); border: 1px solid rgba(0, 120, 212, 0.2);">
                            <small class="d-flex align-items-start" style="color: #60a5fa;">
                                <span class="bi-info-circle-fill me-2 mt-1 flex-shrink-0"></span>
                                <span>Entra ID sign-in is not set up yet. An administrator configures this under Providers &rarr; Azure &rarr; Per-user permissions before anyone can connect.</span>
                            </small>
                        </div>
                    }
                    else if (azureIdentity is not null)
                    {
                        <div class="d-flex flex-column gap-2 mb-3">
                            <div>
                                <small class="text-muted d-block">Connected as</small>
                                <span class="small">@azureIdentity.DisplayName</span>
                            </div>
                            <div class="d-flex gap-4">
                                <div>
                                    <small class="text-muted d-block">Tenant</small>
                                    <small>@azureIdentity.TenantId</small>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Connected</small>
                                    <small>@azureIdentity.ConnectedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            <span class="bi-box-arrow-up-right me-1"></span>
                            You sign in at <strong>Microsoft Entra ID</strong> with the
                            credentials and multi-factor you already use — not in Connapse, which
                            never sees what you type there.
                        </p>
                    }
                </div>
                @if (azureIdentity is not null)
                {
                    <!-- Same reasoning as the AWS footer above: disconnect must not depend on
                         azureSignInConfigured, or a connected row becomes unremovable once an
                         administrator clears the Entra settings. -->
                    <div class="card-footer border-top-0 px-4 pb-4 pt-0">
                        @if (confirmDisconnectAzure)
                        {
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-danger" @onclick="DisconnectAzureAsync" disabled="@isProcessing">
                                    Confirm Disconnect
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDisconnectAzure = false">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDisconnectAzure = true" disabled="@isProcessing">
                                <span class="bi-x-circle me-1"></span>Disconnect
                            </button>
                        }
                    </div>
                }
                else if (azureSignInConfigured)
                {
                    <div class="card-footer border-top-0 px-4 pb-4 pt-0">
                        <button class="btn btn-sm btn-primary" @onclick="ConnectAzureAsync" disabled="@isProcessing">
                            <span class="bi-box-arrow-up-right me-1"></span>Continue to Entra sign-in
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- GitHub Identity Card: signs in through the provider GitHub App, so private repository
             content can be searched by people GitHub says can read it. -->
        <div class="col-md-6">
            <div class="card h-100 provider-card @(gitHubIdentity is not null ? "provider-connected" : "")"
                 style="--provider-color: #6e7681;">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width: 40px; height: 40px; background: rgba(110, 118, 129, 0.1); border: 1px solid rgba(110, 118, 129, 0.25);">
                            <span class="bi-github" style="font-size: 1.1rem;"></span>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <strong>GitHub</strong>
                        </div>
                        @if (gitHubIdentity is not null)
                        {
                            <span class="badge rounded-pill text-bg-success">
                                <span class="bi-check-circle-fill me-1" aria-hidden="true"></span>Connected
                            </span>
                        }
                    </div>

                    @if (gitHubIdentity is not null)
                    {
                        <div class="d-flex gap-4 mb-3">
                            <div>
                                <small class="text-muted d-block">Connected as</small>
                                <span class="small">@gitHubIdentity.Login</span>
                            </div>
                            <div>
                                <small class="text-muted d-block">Connected</small>
                                <small>@gitHubIdentity.ConnectedAt.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>
                    }
                    else if (!gitHubSignInAvailable)
                    {
                        <div class="rounded-3 p-3" style="background: rgba(110, 118, 129, 0.08); border: 1px solid rgba(110, 118, 129, 0.2);">
                            <small class="d-flex align-items-start text-muted">
                                <span class="bi-info-circle-fill me-2 mt-1 flex-shrink-0"></span>
                                <span>
                                    @(gitHubAppExists
                                        ? "GitHub sign-in is not available: this deployment's GitHub App can't sign people in yet. Ask an administrator to add its client secret under Providers → GitHub."
                                        : "GitHub sign-in is not available yet. An administrator sets up the GitHub App under Providers → GitHub first.")
                                </span>
                            </small>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            <span class="bi-box-arrow-up-right me-1" aria-hidden="true"></span>
                            You sign in at <strong>GitHub</strong>. GitHub's page says the App can "act on your behalf";
                            Connapse only reads which account you are, then gives up that access straight away.
                            It uses your account to show you private repository content GitHub says you can read.
                        </p>
                    }
                </div>
                @if (gitHubIdentity is not null)
                {
                    <div class="card-footer border-top-0 px-4 pb-4 pt-0">
                        @if (confirmDisconnectGitHub)
                        {
                            <p id="github-disconnect-help" class="small text-muted mb-2">
                                You will stop seeing private repository content in search. Your GitHub account is not changed.
                            </p>
                            <div class="d-flex gap-2">
                                <button @ref="gitHubConfirmButton" class="btn btn-sm btn-danger" @onclick="DisconnectGitHubAsync"
                                        disabled="@isProcessing" aria-describedby="github-disconnect-help">
                                    Disconnect GitHub
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelGitHubDisconnect">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <button @ref="gitHubDisconnectButton" class="btn btn-sm btn-outline-danger" @onclick="AskGitHubDisconnect" disabled="@isProcessing">
                                <span class="bi-x-circle me-1" aria-hidden="true"></span>Disconnect
                            </button>
                        }
                    </div>
                }
                else if (gitHubSignInAvailable)
                {
                    <div class="card-footer border-top-0 px-4 pb-4 pt-0">
                        <button class="btn btn-sm btn-primary" @onclick="ConnectGitHub" disabled="@isProcessing">
                            <span class="bi-box-arrow-up-right me-1" aria-hidden="true"></span>Continue to GitHub sign-in
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private Guid currentUserId;
    private bool isProcessing;
    private string? statusMessage;
    private bool statusSuccess;

    private AwsIdentityLinkDto? awsIdentity;
    private bool awsSignInConfigured;

    /// <summary>Whether this deployment filters search results, and whether it currently can.</summary>
    private EnforcementState awsEnforcement;
    private bool confirmDisconnectAws;

    private AzureIdentityLinkDto? azureIdentity;
    private bool azureSignInConfigured;
    private bool confirmDisconnectAzure;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userIdStr = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userIdStr is not null)
            Guid.TryParse(userIdStr, out currentUserId);

        awsSignInConfigured = SamlOptions.CurrentValue.IsConfigured;
        awsEnforcement = EnforcementOptions.CurrentValue.StateFor(
            SamlOptions.CurrentValue, Migration.Determined);
        azureSignInConfigured = AzureAdOptions.CurrentValue.IsConfigured;

        ApplyAwsErrorFromQuery();
        ApplyAzureErrorFromQuery();
        ApplyGitHubErrorFromQuery();

        await LoadIdentitiesAsync();
    }

    private async Task LoadIdentitiesAsync()
    {
        awsIdentity = await AwsIdentityLinkService.GetAsync(currentUserId);
        azureIdentity = await AzureIdentityLinkService.GetAsync(currentUserId);
        gitHubIdentity = await GitHubIdentityLinks.GetAsync(currentUserId);

        // Available once the provider App exists and can sign users in (an App registered by hand
        // has no client secret, so it cannot).
        gitHubSignInAvailable = await GitHubApp.CanSignInUsersAsync();
        gitHubAppExists = gitHubSignInAvailable || await GitHubApp.IsConfiguredAsync();
    }

    private Connapse.Identity.Data.Entities.UserGitHubIdentityLinkEntity? gitHubIdentity;
    private bool gitHubSignInAvailable;
    private bool gitHubAppExists;
    private bool confirmDisconnectGitHub;
    private ElementReference gitHubConfirmButton;
    private ElementReference gitHubDisconnectButton;

    /// <summary>Where focus goes after the next render, as the disconnect buttons swap.</summary>
    private bool? focusGitHubConfirm;

    private void AskGitHubDisconnect() => (confirmDisconnectGitHub, focusGitHubConfirm) = (true, true);

    private void CancelGitHubDisconnect() => (confirmDisconnectGitHub, focusGitHubConfirm) = (false, false);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusGitHubConfirm is not { } confirm) return;
        focusGitHubConfirm = null;
        await (confirm ? gitHubConfirmButton : gitHubDisconnectButton).FocusAsync();
    }

    private void ApplyGitHubErrorFromQuery()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("linked", out var linked) && linked.ToString() == "github")
        {
            (statusMessage, statusSuccess) = ("GitHub account linked. Private repositories you can read on GitHub now appear in your search results.", true);
            return;
        }

        if (!query.TryGetValue("error", out var errorValues)) return;

        statusMessage = errorValues.ToString() switch
        {
            "github_not_configured" => "Could not connect your GitHub account: GitHub sign-in is not set up yet. An administrator sets up the GitHub App under Providers.",
            "github_link_declined" => "You cancelled on GitHub, so no account was linked.",
            "github_link_expired" => "That GitHub sign-in took too long or was started in another tab. Start it again.",
            "github_link_wrong_user" => "That GitHub sign-in was started by a different Connapse user, so nothing was linked. Sign in to Connapse as yourself and start again.",
            "github_link_unlinked" => "You disconnected GitHub while the sign-in was finishing, so nothing was linked. Start it again to link.",
            "github_link_failed" => "GitHub did not complete the sign-in, so no account was linked. Try again; if it keeps failing, tell an administrator.",
            _ => statusMessage,
        };
        if (errorValues.ToString().StartsWith("github_", StringComparison.Ordinal))
            statusSuccess = false;
    }

    private void ConnectGitHub() =>
        Navigation.NavigateTo("/api/v1/auth/cloud/github/connect", forceLoad: true);

    private async Task DisconnectGitHubAsync()
    {
        isProcessing = true;
        statusMessage = null;
        confirmDisconnectGitHub = false;
        try
        {
            // Refused first, so a sign-in racing the delete cannot put the link back.
            GitHubLinkFlow.RevokeFor(currentUserId);
            bool deleted = await GitHubIdentityLinks.DeleteAsync(currentUserId);
            if (deleted)
                await AuditLogger.LogAsync("identity.github.unlinked", "user", currentUserId.ToString());
            (statusMessage, statusSuccess) = deleted
                ? ("GitHub account disconnected. Private repository content no longer appears in your search results.", true)
                : ("No GitHub account link found.", false);
            await LoadIdentitiesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect GitHub identity link for user {UserId}", currentUserId);
            (statusMessage, statusSuccess) = ("Failed to disconnect. Please try again.", false);
        }
        finally
        {
            isProcessing = false;
        }
    }

    // The assertion consumer redirects here with ?error=aws_<reason> when a sign-in failed. A
    // silent, unchanged page would leave the user guessing whether anything happened.
    private void ApplyAwsErrorFromQuery()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("error", out var errorValues))
            return;

        var error = errorValues.ToString();
        if (!error.StartsWith("aws_", StringComparison.Ordinal))
            return;

        // One message per reason the assertion consumer can refuse. Several of these are the same
        // sentence to a person and different to whoever investigates, which is the point: the
        // difference between an expired assertion and a forged one matters to an administrator.
        var reason = error["aws_".Length..];
        statusMessage = reason switch
        {
            "not_configured" => "Could not connect your AWS identity: AWS sign-in is not set up yet. An administrator sets it up under Providers.",
            "unknown_request" => "Could not connect your AWS identity: the sign-in did not match the one that started it, or it took too long. Please try again.",
            "response_missing" or "response_malformed" => "Could not connect your AWS identity: AWS sent something Connapse could not read.",
            "signature_invalid" => "Could not connect your AWS identity: the response from AWS could not be verified. An administrator may need to paste the current signing certificate.",
            "configuration_invalid" => "Could not connect your AWS identity: the stored AWS sign-in settings are unusable. An administrator needs to check them.",
            "status_not_success" => "AWS did not complete the sign-in.",
            "issuer_mismatch" => "Could not connect your AWS identity: the response came from a different directory than the one Connapse is set up for.",
            "destination_mismatch" => "Could not connect your AWS identity: the response was addressed elsewhere. Connapse's address may have changed without the AWS application being updated.",
            "assertion_not_yet_valid" or "assertion_expired" => "Could not connect your AWS identity: the response from AWS was outside its validity window. Check the clock on the Connapse server, then try again.",
            "assertion_replayed" => "Could not connect your AWS identity: that sign-in had already been used. Please start again.",
            "response_unsolicited" => "Could not connect your AWS identity: AWS sent a response to a different sign-in than the one you started. Please try again.",
            // Not phrased as an accusation. The ordinary way to reach this is finishing a sign-in
            // in a browser signed in as somebody else, which is a mistake far more often than it
            // is an attack — and the person reading it is whoever finished the sign-in, who in the
            // attack is the victim rather than the attacker.
            "wrong_user" => "Could not connect your AWS identity: that sign-in was started by a different Connapse account. Sign in as the account you want to connect, then start again.",
            "assertion_id_missing" => "Could not connect your AWS identity: AWS sent a response Connapse cannot safely accept.",
            "no_directory_user" => "Could not connect your AWS identity: AWS did not say which directory user you are. An administrator needs to map the Subject attribute in IAM Identity Center.",
            _ => "Could not connect your AWS identity. Please try again.",
        };
        statusSuccess = false;
    }

    private void ConnectAwsAsync()
    {
        Navigation.NavigateTo("/api/v1/auth/cloud/aws/connect", forceLoad: true);
    }

    // The Entra callback/confirm hop redirects here with ?error=azure_<reason> when a sign-in
    // failed. Unlike AWS, every failure path collapses to one of two generic reasons — the
    // detail (a bad signature, a replayed callback, a validator rejection) is logged
    // server-side and never put in a URL a browser can carry in history.
    private void ApplyAzureErrorFromQuery()
    {
        var uri = new Uri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue("error", out var errorValues))
            return;

        var error = errorValues.ToString();
        if (!error.StartsWith("azure_", StringComparison.Ordinal))
            return;

        var reason = error["azure_".Length..];
        statusMessage = reason switch
        {
            "not_configured" => "Could not connect your Entra identity: Entra ID sign-in is not set up yet. An administrator sets it up under Providers.",
            "link_failed" => "Could not connect your Entra identity. Please try again.",
            _ => "Could not connect your Entra identity. Please try again.",
        };
        statusSuccess = false;
    }

    private void ConnectAzureAsync()
    {
        Navigation.NavigateTo("/api/v1/auth/cloud/azure/connect", forceLoad: true);
    }

    private async Task DisconnectAzureAsync()
    {
        isProcessing = true;
        statusMessage = null;
        confirmDisconnectAzure = false;
        try
        {
            bool deleted = await AzureIdentityLinkService.DisconnectAsync(currentUserId);
            if (deleted)
            {
                statusMessage = "Entra identity disconnected.";
                statusSuccess = true;
                await LoadIdentitiesAsync();
            }
            else
            {
                statusMessage = "No Entra identity link found.";
                statusSuccess = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect Azure identity link for user {UserId}", currentUserId);
            statusMessage = "Failed to disconnect. Please try again.";
            statusSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task DisconnectAwsAsync()
    {
        isProcessing = true;
        statusMessage = null;
        confirmDisconnectAws = false;
        try
        {
            var result = await AwsIdentityLinkService.DisconnectAsync(currentUserId);
            if (result.LinkChangedDuringDisconnect)
            {
                // A reconnect raced this disconnect: the row was left in place because it had
                // already been replaced by the time the delete ran.
                // Reload so the card reflects whatever is actually connected now.
                statusMessage = "Your AWS identity changed while disconnecting. Please try again.";
                statusSuccess = false;
                await LoadIdentitiesAsync();
            }
            else if (result.Deleted)
            {
                // Nothing to qualify. The link held an attested identity rather than a credential,
                // so removing the row is the whole of disconnecting — there is nothing left live
                // at AWS to warn about.
                statusMessage = "AWS identity disconnected.";
                statusSuccess = true;
                await LoadIdentitiesAsync();
            }
            else
            {
                statusMessage = "No AWS identity link found.";
                statusSuccess = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to disconnect AWS identity link for user {UserId}", currentUserId);
            statusMessage = "Failed to disconnect. Please try again.";
            statusSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }
}
