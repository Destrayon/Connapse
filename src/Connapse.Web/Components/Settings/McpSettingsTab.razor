@using Connapse.Core

<EditForm Model="@localSettings" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" for="mcpToolList">Tool list</label>
            <InputSelect @bind-Value="localSettings.ToolList" class="form-select" id="mcpToolList">
                <option value="@McpSettings.Compact">Compact, with tool search (default)</option>
                <option value="@McpSettings.Full">Every tool</option>
            </InputSelect>
            <small class="form-text text-muted">
                What MCP clients see at <code>/mcp</code>. Compact shows a few tools and lets the agent search for the
                rest, which keeps its context small. Every tool suits clients that search tools themselves, like
                Claude Code. A token or agent key created with "Show every MCP tool" always gets every tool, and
                <code>/mcp/full</code> always shows every tool.
            </small>
            <ValidationMessage For="() => localSettings.ToolList" />
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-primary me-2">
                <span class="bi-save me-1"></span> Save Changes
            </button>
            <button type="button" class="btn btn-secondary" @onclick="Reset">
                <span class="bi-arrow-counterclockwise me-1"></span> Reset
            </button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public McpSettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback<McpSettings> OnSave { get; set; }

    private McpSettings localSettings = new();

    protected override void OnParametersSet()
    {
        localSettings = Settings with { };
    }

    private async Task HandleSubmit() => await OnSave.InvokeAsync(localSettings);

    private void Reset()
    {
        localSettings = Settings with { };
    }
}
