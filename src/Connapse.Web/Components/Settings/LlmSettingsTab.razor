@using Connapse.Core

<div class="alert alert-info" role="note" data-testid="llm-unused-notice">
    <div class="d-flex align-items-start">
        <span class="bi-info-circle-fill me-2 mt-1 flex-shrink-0"></span>
        <div>
            <strong>No feature uses these settings yet.</strong>
            <div class="small mt-1">
                Connapse doesn't send anything to this AI model today. The settings are kept for features
                planned later, so you can save and test a provider now, but filling them in changes nothing yet.
            </div>
        </div>
    </div>
</div>

<EditForm Model="@localSettings" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Provider</label>
            <InputSelect @bind-Value="localSettings.Provider" class="form-select" @bind-Value:after="OnProviderChanged">
                <option value="Ollama">Ollama</option>
                <option value="OpenAI">OpenAI</option>
                <option value="AzureOpenAI">Azure OpenAI</option>
                <option value="Anthropic">Anthropic</option>
            </InputSelect>
        </div>

        @if (IsOllama)
        {
            <div class="col-md-6">
                <label class="form-label">Model</label>
                <InputText @bind-Value="localSettings.Model" class="form-control" placeholder="llama3.2" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Base URL</label>
                <InputText @bind-Value="localSettings.BaseUrl" class="form-control" placeholder="e.g. http://ollama:11434 (Docker) or http://localhost:11434 (local)" />
            </div>

            <div class="col-md-6">
                <label class="form-label" for="maxConcurrent">Max Concurrent Requests</label>
                <InputNumber @bind-Value="localSettings.MaxConcurrentRequests" class="form-control" id="maxConcurrent" min="1" />
                <small class="form-text text-muted">
                    Requests sent to Ollama at once (default 1). Ollama runs one at a time unless its <code>OLLAMA_NUM_PARALLEL</code> is raised; requests past that limit queue there and can time out.
                    Takes effect after a restart.
                </small>
            </div>
        }
        else if (IsOpenAi)
        {
            <div class="col-md-6">
                <label class="form-label">API Key</label>
                <InputText @bind-Value="localSettings.OpenAiApiKey" type="password" class="form-control" placeholder="@SettingsPageSaves.Placeholder(SavedKeys, localSettings.OpenAiApiKey, "sk-...", nameof(LlmSettings.OpenAiApiKey), nameof(LlmSettings.ApiKey))" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Model</label>
                <InputText @bind-Value="localSettings.Model" class="form-control" placeholder="gpt-4o" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Base URL</label>
                <InputText @bind-Value="localSettings.OpenAiBaseUrl" class="form-control" placeholder="https://api.openai.com/v1" />
                <small class="form-text text-muted">Override for OpenAI-compatible endpoints (Groq, Together, etc.)</small>
            </div>
        }
        else if (IsAzureOpenAi)
        {
            <div class="col-md-6">
                <label class="form-label">API Key</label>
                <InputText @bind-Value="localSettings.AzureApiKey" type="password" class="form-control" placeholder="@SettingsPageSaves.Placeholder(SavedKeys, localSettings.AzureApiKey, null, nameof(LlmSettings.AzureApiKey), nameof(LlmSettings.ApiKey))" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Endpoint URL</label>
                <InputText @bind-Value="localSettings.AzureEndpoint" class="form-control" placeholder="https://your-resource.openai.azure.com" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Deployment Name</label>
                <InputText @bind-Value="localSettings.AzureDeploymentName" class="form-control" placeholder="gpt-4o" />
                <small class="form-text text-muted">The deployment name in your Azure OpenAI resource</small>
            </div>
        }
        else if (IsAnthropic)
        {
            <div class="col-md-6">
                <label class="form-label">API Key</label>
                <InputText @bind-Value="localSettings.AnthropicApiKey" type="password" class="form-control" placeholder="@SettingsPageSaves.Placeholder(SavedKeys, localSettings.AnthropicApiKey, "sk-ant-...", nameof(LlmSettings.AnthropicApiKey), nameof(LlmSettings.ApiKey))" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Model</label>
                <InputText @bind-Value="localSettings.Model" class="form-control" placeholder="claude-sonnet-4-20250514" />
            </div>

            <div class="col-md-6">
                <label class="form-label" for="anthropicBaseUrl">Base URL</label>
                <InputText @bind-Value="localSettings.AnthropicBaseUrl" class="form-control" id="anthropicBaseUrl" placeholder="https://api.anthropic.com" />
                <small class="form-text text-muted">Override for a proxy in front of Anthropic's API; leave empty for the default</small>
            </div>
        }

        <div class="col-md-6">
            <label class="form-label">Temperature</label>
            <InputNumber @bind-Value="localSettings.Temperature" class="form-control" step="0.1" min="0" max="2" disabled="@IsAnthropic" />
            <small class="form-text text-muted">Randomness (0.0-2.0). Not used for Anthropic: its API no longer accepts a temperature, so Claude uses its default.</small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Max Tokens</label>
            <InputNumber @bind-Value="localSettings.MaxTokens" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Timeout (seconds)</label>
            <InputNumber @bind-Value="localSettings.TimeoutSeconds" class="form-control" />
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-primary me-2">
                <span class="bi-save me-1"></span> Save Changes
            </button>
            <button type="button" class="btn btn-secondary me-2" @onclick="Reset">
                <span class="bi-arrow-counterclockwise me-1"></span> Reset
            </button>
            <button type="button" class="btn btn-info" @onclick="TestConnection" disabled="@isTestingConnection">
                @if (isTestingConnection)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Testing...</span>
                }
                else
                {
                    <span class="bi-plug me-1"></span>
                    <span>Test Connection</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(testMessage))
        {
            <div class="col-12 mt-3">
                <div class="alert @(testSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    <span class="@(testSuccess ? "bi-check-circle" : "bi-x-circle") me-2"></span>
                    @testMessage
                    <button type="button" class="btn-close" @onclick="@(() => testMessage = null)"></button>
                </div>
            </div>
        }
    </div>
</EditForm>

@inject Connapse.Application.Settings.TestConnection Test
@inject AuthenticationStateProvider Authentication

@code {
    [Parameter]
    public LlmSettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback<LlmSettings> OnSave { get; set; }

    /// <summary>The keys saved for these settings, by property name; the page never holds their values.</summary>
    [Parameter]
    public IReadOnlySet<string> SavedKeys { get; set; } = new HashSet<string>();

    private LlmSettings localSettings = new();
    private bool isTestingConnection;
    private string? testMessage;
    private bool testSuccess;

    private bool IsOllama => localSettings.Provider is null or "Ollama";
    private bool IsOpenAi => localSettings.Provider == "OpenAI";
    private bool IsAzureOpenAi => localSettings.Provider == "AzureOpenAI";
    private bool IsAnthropic => localSettings.Provider == "Anthropic";

    protected override void OnParametersSet()
    {
        localSettings = Settings with { };
    }

    private void OnProviderChanged()
    {
        switch (localSettings.Provider)
        {
            case "OpenAI":
                if (string.IsNullOrWhiteSpace(localSettings.Model) || localSettings.Model == "llama3.2")
                    localSettings.Model = "gpt-4o";
                if (localSettings.MaxTokens == 2000)
                    localSettings.MaxTokens = 4096;
                break;

            case "AzureOpenAI":
                if (string.IsNullOrWhiteSpace(localSettings.Model) || localSettings.Model == "llama3.2")
                    localSettings.Model = "gpt-4o";
                if (localSettings.MaxTokens == 2000)
                    localSettings.MaxTokens = 4096;
                break;

            case "Anthropic":
                if (string.IsNullOrWhiteSpace(localSettings.Model) || localSettings.Model == "llama3.2")
                    localSettings.Model = "claude-sonnet-4-20250514";
                if (localSettings.MaxTokens == 2000)
                    localSettings.MaxTokens = 4096;
                break;

            case "Ollama":
            default:
                if (localSettings.Model is "gpt-4o" or "claude-sonnet-4-20250514")
                    localSettings.Model = "llama3.2";
                // BaseUrl comes from config (appsettings / env var) — don't hardcode a default
                if (localSettings.MaxTokens == 4096)
                    localSettings.MaxTokens = 2000;
                break;
        }
    }

    private async Task HandleSubmit()
    {
        await OnSave.InvokeAsync(localSettings);
    }

    private void Reset()
    {
        localSettings = Settings with { };
    }

    private async Task TestConnection()
    {
        isTestingConnection = true;
        testMessage = null;
        StateHasChanged();

        try
        {
            (testSuccess, testMessage) = await Test.TestAsync(Authentication, "llm", localSettings, 10);
        }
        catch (Exception ex)
        {
            testSuccess = false;
            testMessage = $"Test failed: {ex.Message}";
        }
        finally
        {
            isTestingConnection = false;
            StateHasChanged();
        }
    }
}
