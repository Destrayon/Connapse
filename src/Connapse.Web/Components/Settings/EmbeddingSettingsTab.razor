@using Connapse.Application.Settings
@using Connapse.Core
@using Connapse.Storage.Vectors

<EditForm Model="@localSettings" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Provider</label>
            <InputSelect @bind-Value="localSettings.Provider" class="form-select" @bind-Value:after="OnProviderChanged">
                <option value="Ollama">Ollama</option>
                <option value="OpenAI">OpenAI</option>
                <option value="AzureOpenAI">Azure OpenAI</option>
            </InputSelect>
        </div>

        @if (IsOllama)
        {
            <div class="col-md-6">
                <label class="form-label">Model</label>
                <InputText @bind-Value="localSettings.Model" class="form-control" placeholder="nomic-embed-text" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Base URL</label>
                <InputText @bind-Value="localSettings.BaseUrl" class="form-control" placeholder="e.g. http://ollama:11434 (Docker) or http://localhost:11434 (local)" />
            </div>
        }
        else if (IsOpenAi)
        {
            <div class="col-md-6">
                <label class="form-label">API Key</label>
                <InputText @bind-Value="localSettings.OpenAiApiKey" type="password" class="form-control" placeholder="sk-..." />
            </div>

            <div class="col-md-6">
                <label class="form-label">Model</label>
                <InputText @bind-Value="localSettings.Model" class="form-control" placeholder="text-embedding-3-small" />
                <small class="form-text text-muted">text-embedding-3-small (1536d) or text-embedding-3-large (3072d)</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Base URL</label>
                <InputText @bind-Value="localSettings.OpenAiBaseUrl" class="form-control" placeholder="https://api.openai.com/v1" />
                <small class="form-text text-muted">Override for OpenAI-compatible proxies</small>
            </div>
        }
        else if (IsAzureOpenAi)
        {
            <div class="col-md-6">
                <label class="form-label">API Key</label>
                <InputText @bind-Value="localSettings.AzureApiKey" type="password" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Endpoint URL</label>
                <InputText @bind-Value="localSettings.AzureEndpoint" class="form-control" placeholder="https://your-resource.openai.azure.com" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Deployment Name</label>
                <InputText @bind-Value="localSettings.AzureDeploymentName" class="form-control" placeholder="text-embedding-3-small" />
                <small class="form-text text-muted">The deployment name in your Azure OpenAI resource</small>
            </div>
        }

        <div class="col-md-6">
            <label class="form-label">Dimensions</label>
            <InputNumber @bind-Value="localSettings.Dimensions" class="form-control" />
            <small class="form-text text-muted">
                @if (IsOpenAi || IsAzureOpenAi)
                {
                    @:text-embedding-3-small: 1536 (default), text-embedding-3-large: 3072
                }
                else
                {
                    @:Must match model output dimensions
                }
            </small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Batch Size</label>
            <InputNumber @bind-Value="localSettings.BatchSize" class="form-control" />
            <small class="form-text text-muted">Number of texts per embedding request</small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Max Concurrent Ingestion Requests</label>
            <InputNumber @bind-Value="localSettings.MaxConcurrentIngestionRequests" class="form-control" min="1" />
            <small class="form-text text-muted">Embedding requests ingestion may run at once. Keep it low for a local model so searches stay fast during large syncs; raise it for a hosted provider.</small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Max Concurrent Query Requests</label>
            <InputNumber @bind-Value="localSettings.MaxConcurrentQueryRequests" class="form-control" min="1" />
            <small class="form-text text-muted">Search query embeddings that may run at once</small>
        </div>

        <div class="col-md-6">
            <label class="form-label">Timeout (seconds)</label>
            <InputNumber @bind-Value="localSettings.TimeoutSeconds" class="form-control" />
        </div>

        <div class="col-12">
            <label class="form-label">Query and document prefixes</label>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="emb-model-prompts"
                       checked="@localSettings.UseModelPrefixes" @onchange="OnModelPromptsChanged" />
                <label class="form-check-label" for="emb-model-prompts">Use the model's published prefixes</label>
            </div>
            @if (localSettings.UseModelPrefixes)
            {
                <small class="form-text text-muted">@ModelPromptsSummary</small>
            }
            else
            {
                <div class="row g-2 mt-1">
                    <div class="col-md-6">
                        <InputText @bind-Value="localSettings.QueryPrefix" class="form-control" placeholder="Query prefix (empty: none)" />
                    </div>
                    <div class="col-md-6">
                        <InputText @bind-Value="localSettings.DocumentPrefix" class="form-control" placeholder="Document prefix (empty: none)" />
                    </div>
                </div>
            }
            @if (EmbeddingText.IsUncased(localSettings.Model))
            {
                <small class="form-text text-muted d-block">This model's vocabulary is lowercase, so text is lowercased before embedding.</small>
            }
            <small class="form-text text-muted d-block">
                Some models are trained to see an instruction before each search query and each stored chunk.
                Changing the prefixes changes the vectors: reindex afterwards. Until then, vectors made before prefixes
                existed or with the model's own prefixes stay searchable; vectors made with earlier custom prefixes do not.
            </small>
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-primary me-2">
                <span class="bi-save me-1"></span> Save Changes
            </button>
            <button type="button" class="btn btn-secondary me-2" @onclick="Reset">
                <span class="bi-arrow-counterclockwise me-1"></span> Reset
            </button>
            <button type="button" class="btn btn-info" @onclick="TestConnection" disabled="@isTestingConnection">
                @if (isTestingConnection)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Testing...</span>
                }
                else
                {
                    <span class="bi-plug me-1"></span>
                    <span>Test Connection</span>
                }
            </button>
        </div>

        <div class="col-12 mt-3">
            <hr />
            <h6>Re-Embedding</h6>
            <p class="text-muted small mb-2">
                Re-embed all documents using the current embedding model and settings.
                Useful after changing the model, dimensions, or if embeddings need to be refreshed.
            </p>
            <button type="button" class="btn btn-outline-warning" @onclick="StartManualReEmbed" disabled="@isReEmbedding">
                @if (isReEmbedding)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Starting...</span>
                }
                else
                {
                    <span class="bi-arrow-repeat me-1"></span>
                    <span>Re-Embed All Documents</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrEmpty(testMessage))
        {
            <div class="col-12 mt-3">
                <div class="alert @(testSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                    <span class="@(testSuccess ? "bi-check-circle" : "bi-x-circle") me-2"></span>
                    @testMessage
                    <button type="button" class="btn-close" @onclick="@(() => testMessage = null)"></button>
                </div>
            </div>
        }

        @if (showLegacyBanner)
        {
            <div class="col-12 mt-3">
                <div class="alert alert-warning" role="alert">
                    <strong>Legacy vectors detected.</strong>
                    @legacyVectorCount.ToString("N0") documents are still embedded with a previous model.
                    They won't appear in Semantic search results until re-embedded.
                    <div class="mt-2">
                        <button type="button" class="btn btn-warning btn-sm me-2" @onclick="StartReEmbed" disabled="@isReEmbedding">
                            @if (isReEmbedding)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Starting...</span>
                            }
                            else
                            {
                                <span>Re-Embed Now</span>
                            }
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="EnableCrossModelSearch">
                            Skip - Use Cross-Model Search
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (reEmbedStarted)
        {
            <div class="col-12 mt-3">
                <div class="alert alert-info" role="alert">
                    <strong>Re-embedding in progress.</strong>
                    Documents are being re-embedded in the background. Cross-model search has been enabled automatically
                    so all documents remain findable during the transition.
                    <div class="mt-2">
                        <small class="text-muted">Queue depth: @queueDepth</small>
                    </div>
                </div>
            </div>
        }
    </div>
</EditForm>

@inject TestConnection Test
@inject ListEmbeddingModels Models
@inject StartReindex Reindex
@inject GetReindexStatus ReindexStatus
@inject GetSettings Get
@inject UpdateSettings Update
@inject AuthenticationStateProvider Authentication

@code {
    [Parameter]
    public EmbeddingSettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback<EmbeddingSettings> OnSave { get; set; }

    /// <summary>The keys saved for these settings, by property name; the page never holds their values.</summary>
    [Parameter]
    public IReadOnlySet<string> SavedKeys { get; set; } = new HashSet<string>();

    private EmbeddingSettings localSettings = new();
    private bool isTestingConnection;
    private string? testMessage;
    private bool testSuccess;

    // Legacy vector / re-embedding state
    private bool showLegacyBanner;
    private long legacyVectorCount;
    private bool isReEmbedding;
    private bool reEmbedStarted;
    private int queueDepth;

    private bool IsOllama => localSettings.Provider is null or "Ollama";
    private bool IsOpenAi => localSettings.Provider == "OpenAI";
    private bool IsAzureOpenAi => localSettings.Provider == "AzureOpenAI";

    private string ModelPromptsSummary
    {
        get
        {
            EmbeddingPrompts prompts = EmbeddingPrompts.ForModel(localSettings.Model);
            return prompts.IsNone
                ? "This model has no published prefixes, so text is embedded as it is."
                : $"Queries start with \"{prompts.Query}\"; stored text starts with \"{prompts.Document}\".";
        }
    }

    private void OnModelPromptsChanged(ChangeEventArgs e)
    {
        localSettings.UseModelPrefixes = e.Value is true;
        if (!localSettings.UseModelPrefixes
            && string.IsNullOrEmpty(localSettings.QueryPrefix) && string.IsNullOrEmpty(localSettings.DocumentPrefix))
        {
            // Start from the model's own prefixes, so unticking alone changes nothing.
            EmbeddingPrompts prompts = EmbeddingPrompts.ForModel(localSettings.Model);
            localSettings.QueryPrefix = prompts.Query;
            localSettings.DocumentPrefix = prompts.Document;
        }
    }

    protected override void OnParametersSet()
    {
        localSettings = Settings with { };
    }

    private void OnProviderChanged()
    {
        // Auto-fill sensible defaults when switching providers (only if fields are empty/default)
        switch (localSettings.Provider)
        {
            case "OpenAI":
                if (string.IsNullOrWhiteSpace(localSettings.Model) || localSettings.Model == "nomic-embed-text")
                    localSettings.Model = "text-embedding-3-small";
                if (localSettings.Dimensions == 768)
                    localSettings.Dimensions = 1536;
                if (localSettings.BatchSize == 16)
                    localSettings.BatchSize = 64;
                break;

            case "AzureOpenAI":
                if (string.IsNullOrWhiteSpace(localSettings.Model) || localSettings.Model == "nomic-embed-text")
                    localSettings.Model = "text-embedding-3-small";
                if (localSettings.Dimensions == 768)
                    localSettings.Dimensions = 1536;
                if (localSettings.BatchSize == 16)
                    localSettings.BatchSize = 64;
                break;

            case "Ollama":
            default:
                if (localSettings.Model is "text-embedding-3-small" or "text-embedding-3-large")
                    localSettings.Model = "nomic-embed-text";
                if (localSettings.Dimensions == 1536 || localSettings.Dimensions == 3072)
                    localSettings.Dimensions = 768;
                // BaseUrl comes from config (appsettings / env var) — don't hardcode a default
                if (localSettings.BatchSize == 64)
                    localSettings.BatchSize = 16;
                break;
        }
    }

    private async Task HandleSubmit()
    {
        // Save via parent callback (triggers API call)
        await OnSave.InvokeAsync(localSettings);

        // Check for legacy vectors after save
        await CheckForLegacyVectors();
    }

    private async Task CheckForLegacyVectors()
    {
        try
        {
            // settings.embeddingModels reads the embedding settings just saved, so the model they name is current.
            var listed = await Models.RunAsync(await Authentication.OperationContextAsync());
            legacyVectorCount = listed.Result?.LegacyVectorCount ?? 0;
            showLegacyBanner = legacyVectorCount > 0;
        }
        catch
        {
            showLegacyBanner = false;
        }

        StateHasChanged();
    }

    private Task StartManualReEmbed() => StartReEmbedding(new ReindexRequest(Force: true));

    // Re-embeds what changed; settings.reindex turns on cross-model search so documents remain findable.
    private Task StartReEmbed() => StartReEmbedding(new ReindexRequest());

    private async Task StartReEmbedding(ReindexRequest request)
    {
        isReEmbedding = true;
        StateHasChanged();

        try
        {
            var context = await Authentication.OperationContextAsync();
            var started = await Reindex.RunAsync(context, request);
            if (started.Succeeded)
            {
                showLegacyBanner = false;
                reEmbedStarted = true;
                queueDepth = (await ReindexStatus.RunAsync(context)).Result?.QueueDepth ?? 0;
            }
            else
            {
                testSuccess = false;
                testMessage = started.Detail;
            }
        }
        catch { /* Best-effort */ }
        finally
        {
            isReEmbedding = false;
            StateHasChanged();
        }
    }

    private async Task EnableCrossModelSearch()
    {
        try
        {
            var (saved, detail) = await Update.EnableCrossModelSearchAsync(Get, Authentication);
            if (saved)
                showLegacyBanner = false;
            testSuccess = saved;
            testMessage = saved
                ? "Cross-model search enabled. Legacy documents will appear in Hybrid search results."
                : $"Failed to enable cross-model search: {detail}";
        }
        catch (Exception ex)
        {
            testSuccess = false;
            testMessage = $"Failed to enable cross-model search: {ex.Message}";
        }

        StateHasChanged();
    }

    private void Reset()
    {
        localSettings = Settings with { };
        showLegacyBanner = false;
        reEmbedStarted = false;
    }

    private async Task TestConnection()
    {
        isTestingConnection = true;
        testMessage = null;
        StateHasChanged();

        try
        {
            (testSuccess, testMessage) = await Test.TestAsync(Authentication, "embedding", localSettings, 10);
        }
        catch (Exception ex)
        {
            testSuccess = false;
            testMessage = $"Test failed: {ex.Message}";
        }
        finally
        {
            isTestingConnection = false;
            StateHasChanged();
        }
    }
}
