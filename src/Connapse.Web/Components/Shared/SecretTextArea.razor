@*
    The one field type for a secret: a private key, a passphrase, a token.

    Masked by default and revealed on request, so a value pasted in can be checked before it is
    saved without being readable to anyone glancing at the screen. Nothing here blocks paste or
    a password manager: no autocomplete="off", no confirm-by-retyping.

    Multiline secrets (PEM blocks) cannot use type="password", so they are masked with the
    text-security property instead; a single-line secret toggles between password and text.
*@

@if (Multiline)
{
    <textarea @ref="input" id="@Id" class="form-control font-monospace @(revealed ? "" : "secret-masked") @CssClass"
              rows="@Rows" placeholder="@Placeholder" aria-describedby="@DescribedBy" aria-invalid="@(Invalid ? "true" : null)"
              disabled="@Disabled" @bind="CurrentValue"></textarea>
}
else
{
    @* new-password, not off: it stops the browser filling in the person's own Connapse password
       while leaving password managers free to save and fill the secret itself. *@
    <input @ref="input" id="@Id" type="@(revealed ? "text" : "password")" class="form-control @CssClass" autocomplete="new-password"
           placeholder="@Placeholder" aria-describedby="@DescribedBy" aria-invalid="@(Invalid ? "true" : null)"
           disabled="@Disabled" @bind="CurrentValue" />
}
@* A toggle button keeps one name and reports its state through aria-pressed: "Show client
   secret, pressed" while revealed. Only the icon changes, so the visible word stays inside the name. *@
<button type="button" id="@($"{Id}-reveal")" class="btn btn-sm btn-link px-0 mt-1" aria-controls="@Id" disabled="@Disabled"
        aria-label="@RevealName" aria-pressed="@(revealed ? "true" : "false")" @onclick="() => revealed = !revealed">
    <span class="@(revealed ? "bi-eye-slash" : "bi-eye") me-1" aria-hidden="true"></span>Show
</button>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>The field's label, such as "Client secret": the reveal button is named "Show client secret".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool Multiline { get; set; } = true;
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public string? CssClass { get; set; }

    /// <summary>The value was refused; marks the field invalid for assistive technology.</summary>
    [Parameter] public bool Invalid { get; set; }

    /// <summary>A save or check is running; the value can't change under it.</summary>
    [Parameter] public bool Disabled { get; set; }

    private bool revealed;
    private ElementReference input;

    /// <summary>"Show " and the label, its first letter lowered unless it starts an acronym ("SSH key").</summary>
    public static string RevealNameFor(string label)
    {
        string trimmed = label.Trim();
        if (trimmed.Length == 0) return "Show";
        bool acronym = trimmed.Length > 1 && char.IsUpper(trimmed[1]);
        return "Show " + (acronym ? trimmed : char.ToLowerInvariant(trimmed[0]) + trimmed[1..]);
    }

    private string RevealName => RevealNameFor(Label);

    /// <summary>Moves focus into the field, for a control that removed itself to reveal or clear it.</summary>
    public ValueTask FocusAsync() => input.FocusAsync();

    private string? CurrentValue
    {
        get => Value;
        set
        {
            if (value == Value) return;
            Value = value;
            _ = ValueChanged.InvokeAsync(value);
        }
    }
}
