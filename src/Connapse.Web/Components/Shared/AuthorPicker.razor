@using Connapse.Storage.Connectors.GitHub

@*
    A multi-select dropdown of GitHub logins. Closed, it shows what is chosen; open, it lists
    every suggested author as a checkbox, most active first, with a search box to narrow a long
    list. An account not seen commenting yet can still be added by typing its login.
*@

<div class="author-picker position-relative">
    <button @ref="trigger" id="@Id" type="button" class="form-select form-select-sm text-start" aria-haspopup="dialog"
            aria-expanded="@(open ? "true" : "false")" aria-controls="@PopupId" aria-describedby="@($"{ValueId} {DescribedBy}".Trim())"
            @onclick="Toggle">
        @if (Selected.Count == 0)
        {
            <span id="@ValueId" class="text-muted">@Placeholder</span>
        }
        else
        {
            <span id="@ValueId">@string.Join(", ", Selected)</span>
        }
    </button>

    @if (open)
    {
        @* Covers the page behind the open dropdown: a click anywhere outside lands here and closes it. *@
        <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index:9" @onclick="Toggle"></div>

        <div id="@PopupId" class="card shadow-sm position-absolute w-100 mt-1" style="z-index:10"
             role="dialog" aria-label="@Label" @onkeydown="OnPopupKeyDown">
            <div class="card-body p-2">
                <label class="form-label small mb-1" for="@SearchId">Find or add a GitHub login</label>
                <input @ref="search" id="@SearchId" class="form-control form-control-sm mb-2" placeholder="octocat" autocomplete="off"
                       @bind="query" @bind:event="oninput" @onkeydown="OnKeyDown" />

                <fieldset class="m-0 p-0 border-0" style="max-height:16rem;overflow-y:auto">
                    <legend class="visually-hidden">@Label</legend>
                    @foreach (var author in Listed())
                    {
                        bool chosen = IsSelected(author.Login);
                        @* The whole row is the label, so a click anywhere on it toggles the box. *@
                        <label @key="author.Login" class="author-picker-row d-flex align-items-center gap-2 rounded px-2 py-1 mb-0 small">
                            <input type="checkbox" class="form-check-input m-0 flex-shrink-0" checked="@chosen"
                                   @onchange="() => Flip(author.Login)" />
                            <span class="flex-grow-1 text-truncate">
                                @author.Login
                                @if (author.Comments > 0)
                                {
                                    <span class="badge @(author.IsBot ? "text-bg-secondary" : "text-bg-light border") ms-1">@(author.IsBot ? "Bot" : "User")</span>
                                }
                            </span>
                            @if (author.Comments > 0)
                            {
                                <span class="text-muted">@author.Comments</span>
                            }
                        </label>
                    }
                    @if (!Listed().Any() && !CanAddTyped())
                    {
                        <div class="small text-muted px-1 py-2">
                            @(Authors.Count == 0 ? "No authors synced yet. Type an account's login to add it." : "No matches.")
                        </div>
                    }
                </fieldset>

                @if (CanAddTyped())
                {
                    <button type="button" class="btn btn-sm btn-link px-1" @onclick="() => Flip(query!.Trim())">
                        Add “@query!.Trim()”, not seen commenting yet
                    </button>
                }

                <div class="d-flex justify-content-end border-top pt-2 mt-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Toggle">Done</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public List<string> Selected { get; set; } = [];

    /// <summary>Authors seen in the repository; only those <see cref="Suggest"/> accepts are listed.</summary>
    [Parameter] public IReadOnlyList<GitHubCommentAuthor> Authors { get; set; } = [];
    [Parameter] public Func<GitHubCommentAuthor, bool> Suggest { get; set; } = _ => true;
    [Parameter] public string Placeholder { get; set; } = "None";
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>What is being chosen, for assistive technology: names the popup and its checkbox group.</summary>
    [Parameter] public string Label { get; set; } = "Comment authors";

    /// <summary>The id of help text that describes the picker.</summary>
    [Parameter] public string? DescribedBy { get; set; }

    private bool open;
    private string? query;
    private ElementReference trigger;
    private ElementReference search;

    /// <summary>Where focus goes after the next render: into the search box on open, back to the button on close.</summary>
    private bool? focusSearch;

    private string PopupId => $"{Id}-popup";
    private string SearchId => $"{Id}-search";
    private string ValueId => $"{Id}-value";

    /// <summary>
    /// The order rows appear in, fixed when the dropdown opens: re-sorting as boxes are ticked would
    /// move rows under the pointer. Ticked accounts rise to the top the next time it opens.
    /// </summary>
    private List<string> order = [];

    private void Toggle()
    {
        open = !open;
        query = null;
        focusSearch = open;
        if (open)
            order = Ranked().Select(a => a.Login).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusSearch is not { } intoSearch) return;
        focusSearch = null;
        await (intoSearch ? search : trigger).FocusAsync();
    }

    /// <summary>Escape closes from anywhere in the popup, not just the search box.</summary>
    private void OnPopupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && open) Toggle();
    }

    private bool IsSelected(string login) => Selected.Contains(login, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Chosen accounts first — including ones typed in that have not commented — then the rest of
    /// the suggestions, most active first, narrowed by the search.
    /// </summary>
    private IEnumerable<GitHubCommentAuthor> Listed()
    {
        // Accounts added while open are not in the snapshot; they go last, after it.
        int Position(GitHubCommentAuthor a)
        {
            int i = order.FindIndex(l => string.Equals(l, a.Login, StringComparison.OrdinalIgnoreCase));
            return i < 0 ? int.MaxValue : i;
        }

        return Ranked()
            .Where(a => string.IsNullOrWhiteSpace(query) || a.Login.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(Position);
    }

    private IEnumerable<GitHubCommentAuthor> Ranked()
    {
        var known = Authors.Where(Suggest).ToList();
        var typed = Selected
            .Where(l => !Authors.Any(a => string.Equals(a.Login, l, StringComparison.OrdinalIgnoreCase)))
            .Select(l => new GitHubCommentAuthor(l, l.EndsWith("[bot]", StringComparison.OrdinalIgnoreCase), 0));

        return typed.Concat(known)
            .OrderByDescending(a => IsSelected(a.Login))
            .ThenByDescending(a => a.Comments);
    }

    private bool CanAddTyped() =>
        !string.IsNullOrWhiteSpace(query)
        && GitHubLogin.IsMatch(query.Trim())
        && !IsSelected(query.Trim())
        && !Authors.Any(a => string.Equals(a.Login, query.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task Flip(string login)
    {
        if (IsSelected(login))
            Selected.RemoveAll(l => string.Equals(l, login, StringComparison.OrdinalIgnoreCase));
        else
            Selected.Add(login);

        await OnChanged.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(query)) return;

        if (CanAddTyped()) await Flip(query.Trim());
        else if (Listed().FirstOrDefault(a => !IsSelected(a.Login)) is { } first) await Flip(first.Login);
        query = null;
    }

    // A user login, or an App account's "name[bot]".
    private static readonly System.Text.RegularExpressions.Regex GitHubLogin =
        new(@"^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}(\[bot\])?$");
}
