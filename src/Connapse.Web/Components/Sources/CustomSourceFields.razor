@using Connapse.Web.Components.Providers
@using Connapse.Web.Services
@inject CustomSourceSetup Setup
@inject ILogger<CustomSourceFields> Logger
@inject Connapse.Core.Interfaces.IAuditLogger Audit

@* Custom sources on a custom connection: the connection holds the middle man's address and token, and each
   scope ticked here becomes a source, as Confluence spaces and Jira projects do. *@
@if (Draft.PermissionsBy is { } checker)
{
    <div class="alert alert-info py-2 small" id="custom-source-permissions" role="note">
        <span class="bi-shield-check me-1" aria-hidden="true"></span>
        Searches show a result from this source only when @checker says the person searching may read it.
    </div>
}
else
{
    <div class="alert alert-info py-2 small" id="custom-source-content-only" role="note">
        <span class="bi-info-circle me-1" aria-hidden="true"></span>
        Everyone who can search this source in Connapse sees every document in it, even ones they could not open in
        the original system. To show each person only what they may read there, use a connection with a custom provider.
    </div>
}

@if (Draft.BaseUrl is { } baseUrl)
{
    <p class="small mb-2" id="custom-source-middle-man">
        Reads <span class="font-monospace text-break">@baseUrl</span> with the connection's token.
    </p>
}

<div class="mb-3">
    <button id="custom-source-load" type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadScopesAsync"
            disabled="@(Draft.Loading || Draft.BaseUrl is null)" aria-describedby="@(Draft.Error is null ? null : "custom-source-error")">
        @if (Draft.Loading)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
        }
        @(Draft.Loading ? "Loading scopes" : Draft.Scopes.Count > 0 ? "Reload scopes" : "Load scopes")
    </button>
    @if (Draft.Error is null && Draft.Scopes.Count > 0)
    {
        <div id="custom-source-loaded" class="small text-success mt-2" role="status">
            <span class="bi-check-circle me-1" aria-hidden="true"></span>Loaded @Draft.Scopes.Count scope@(Draft.Scopes.Count == 1 ? "" : "s").
        </div>
    }
    @if (Draft.Error is { } error)
    {
        <div id="custom-source-error" class="text-danger small fw-semibold mt-2" role="alert">
            <span class="bi-x-circle me-1" aria-hidden="true"></span>@error
            <a href="@CustomSourceFieldSpecs.Troubleshooting" target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
    }
</div>

@if (Draft.Scopes.Count > 0)
{
    <fieldset class="mb-3" id="custom-source-scopes" aria-describedby="@ScopesDescribedBy">
        <legend class="form-label fs-6 mb-1">@CustomSourceFieldSpecs.SourceScope.Label</legend>
        <div class="border rounded p-2 @(Draft.ScopesError is null ? "" : "border-danger")" style="max-height: 16rem; overflow-y: auto;">
            @foreach (var scope in Draft.Scopes)
            {
                bool exists = Draft.ExistingScopeIds.Contains(scope.Id);
                string id = $"custom-scope-{scope.Id}";
                <div class="form-check">
                    <input id="@id" type="checkbox" class="form-check-input custom-scope-option @(Draft.ScopesError is null ? "" : "is-invalid")"
                           checked="@(exists || Draft.Selected.Contains(scope.Id))" disabled="@exists"
                           aria-invalid="@(Draft.ScopesError is null ? null : "true")"
                           @onchange="e => Toggle(scope.Id, (bool)(e.Value ?? false))" />
                    <label for="@id" class="form-check-label">
                        @scope.Name
                        @if (exists)
                        {
                            <span class="badge text-bg-secondary ms-1">already added</span>
                        }
                    </label>
                </div>
            }
        </div>
        @if (Draft.ScopesError is { } scopesError)
        {
            <div id="custom-source-scopes-error" class="invalid-feedback d-block fw-semibold" role="alert">
                <span class="bi-x-circle me-1" aria-hidden="true"></span>@scopesError
                <a href="@CustomSourceFieldSpecs.Troubleshooting" target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
            </div>
        }
        <div id="custom-source-scopes-help" class="form-text">
            @CustomSourceFieldSpecs.SourceScope.Help
            <a href="@CustomSourceFieldSpecs.SourceScope.GuideUrl" target="_blank" rel="noopener">@CustomSourceFieldSpecs.SourceScope.GuideLinkText<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
    </fieldset>

    <ProviderField Spec="CustomSourceFieldSpecs.SourceInterval" Value="@Draft.IntervalText" Error="@Draft.IntervalError"
                   ValueChanged="OnIntervalChanged" CssClass="mb-0" />
}

@code {
    [Parameter, EditorRequired]
    public CustomSourceDraft Draft { get; set; } = null!;

    /// <summary>The draft whose scopes were last loaded on its own, so each connection chosen loads once.</summary>
    private CustomSourceDraft? autoLoaded;

    // The connection holds the address and token, so there is nothing to enter first: the scopes load as soon as
    // a custom connection is chosen. The button stays for loading them again.
    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(autoLoaded, Draft)) return;
        autoLoaded = Draft;
        if (Draft.Error is null && Draft.BaseUrl is not null && Draft.Scopes.Count == 0)
            await LoadScopesAsync();
    }

    private async Task LoadScopesAsync()
    {
        Draft.Loading = true;
        Draft.Error = null;
        try
        {
            CustomSourceProbe probe = await Setup.ProbeConnectionAsync(Draft.Connection, CancellationToken.None);
            await Audit.LogAsync(probe.Error is null ? "source.scopes_loaded" : "source.scopes_failed", "connection",
                Draft.Connection.Id.ToString(), new { Field = probe.Field, ScopeCount = probe.Scopes.Count });
            if (probe.Error is not null)
            {
                Draft.Error = probe.Error;
                return;
            }

            Draft.BaseUrl = probe.BaseUrl;
            Draft.ScopesLoaded(probe.Scopes);
        }
        catch (Exception ex)
        {
            // An exception escaping an event handler tears down the circuit; its text is for the log.
            Logger.LogWarning(ex, "Could not load a custom connection's scopes");
            Draft.Error = "Could not load the scopes. Try again; if it keeps failing, the server log has the cause.";
        }
        finally
        {
            Draft.Loading = false;
        }
    }

    // Checked when the source is created, not while typing; once shown, an error clears as soon as it is fixed.
    private void OnIntervalChanged(string? text)
    {
        Draft.IntervalText = text;
        if (Draft.IntervalError is not null) Draft.ValidateInterval();
    }

    private string ScopesDescribedBy => Draft.ScopesError is null
        ? "custom-source-scopes-help"
        : "custom-source-scopes-error custom-source-scopes-help";

    private void Toggle(string scopeId, bool selected)
    {
        if (selected) Draft.Selected.Add(scopeId);
        else Draft.Selected.Remove(scopeId);
        Draft.ScopesError = null;
    }
}
