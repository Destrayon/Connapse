@using Connapse.Web.Components.Providers
@using Connapse.Web.Services
@inject CustomSourceSetup Setup

@* One custom source, with or without a custom connection: the middle man's address and token are entered
   here and checked by loading the scopes it offers. The connection only adds the permission check. *@
@if (Draft.PermissionsBy is { } checker)
{
    <div class="alert alert-info py-2 small" id="custom-source-permissions" role="note">
        <span class="bi-shield-check me-1" aria-hidden="true"></span>
        Searches show a result from this source only when @checker says the person searching may read it.
    </div>
}
else
{
    <div class="alert alert-info py-2 small" id="custom-source-content-only" role="note">
        <span class="bi-info-circle me-1" aria-hidden="true"></span>
        Signed-in users with access to this source see all of its content — nothing is checked against the source system.
    </div>
}

<ProviderField Spec="CustomSourceFieldSpecs.SourceBaseUrl" Value="@Draft.BaseUrl" ValueChanged="v => Draft.BaseUrl = v ?? string.Empty"
               Disabled="@(Draft.FixedBaseUrl is not null)" Error="@(Draft.ErrorField == "baseUrl" ? Draft.Error : null)">
    <HelpContent>@(Draft.FixedBaseUrl is not null ? "Fixed to the address of the connection's custom provider." : null)</HelpContent>
</ProviderField>

<ProviderField Spec="CustomSourceFieldSpecs.SourceToken" Value="@Draft.Token" ValueChanged="v => Draft.Token = v ?? string.Empty"
               Error="@(Draft.ErrorField == "secret" ? Draft.Error : null)" />

<div class="mb-3">
    <button id="custom-source-load" type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadScopesAsync" disabled="@Draft.Loading">
        @if (Draft.Loading)
        {
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
        }
        Load scopes
    </button>
</div>

@if (Draft.Scopes.Count > 0)
{
    <div class="mb-3">
        <label class="form-label" for="custom-source-scope">Scope</label>
        <select id="custom-source-scope" class="form-select" value="@Draft.ScopeId" @onchange="OnScopeChanged">
            @foreach (var scope in Draft.Scopes)
            {
                <option value="@scope.Id">@scope.Name</option>
            }
        </select>
        <div class="form-text">Each scope becomes its own source.</div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="custom-source-name">Name</label>
        <input id="custom-source-name" class="form-control" value="@Draft.Name"
               @onchange="e => Draft.Name = e.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="custom-source-description">Description <span class="text-muted">(optional)</span></label>
        <input id="custom-source-description" class="form-control" value="@Draft.Description"
               @onchange="e => Draft.Description = e.Value?.ToString()" />
    </div>

    <div class="mb-0">
        <label class="form-label" for="custom-source-interval">Sync interval in seconds <span class="text-muted">(optional)</span></label>
        <input id="custom-source-interval" type="number" class="form-control" min="60" value="@Draft.SyncIntervalSeconds"
               @onchange="e => Draft.SyncIntervalSeconds = int.TryParse(e.Value?.ToString(), out int seconds) ? seconds : null"
               placeholder="300" />
        <div class="form-text">At least 60. Leave empty to use the configured default; the middle man may ask for a longer one.</div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public CustomSourceDraft Draft { get; set; } = null!;

    private async Task LoadScopesAsync()
    {
        Draft.Loading = true;
        Draft.Error = null;
        Draft.ErrorField = null;
        try
        {
            CustomSourceProbe probe = await Setup.ProbeAsync(Draft.BaseUrl, Draft.Token, CancellationToken.None);
            if (probe.Error is not null)
            {
                Draft.Error = probe.Error;
                Draft.ErrorField = probe.Field;
                return;
            }

            string? previousName = Draft.Scopes.FirstOrDefault(s => s.Id == Draft.ScopeId)?.Name;
            Draft.BaseUrl = probe.BaseUrl!;
            Draft.Scopes = probe.Scopes;
            if (Draft.ScopeId is null || Draft.Scopes.All(s => s.Id != Draft.ScopeId))
                Draft.ScopeId = Draft.Scopes[0].Id;
            if (Draft.Name.Length == 0 || Draft.Name == previousName)
                Draft.Name = Draft.Scopes.First(s => s.Id == Draft.ScopeId).Name;
        }
        catch (Exception ex)
        {
            // An exception escaping an event handler tears down the circuit.
            Draft.Error = ex.Message;
            Draft.ErrorField = "baseUrl";
        }
        finally
        {
            Draft.Loading = false;
        }
    }

    private void OnScopeChanged(ChangeEventArgs args)
    {
        string? previousName = Draft.Scopes.FirstOrDefault(s => s.Id == Draft.ScopeId)?.Name;
        Draft.ScopeId = args.Value?.ToString();
        // A name the dialog filled in follows the scope; one the admin typed stays.
        if (Draft.Name.Length == 0 || Draft.Name == previousName)
            Draft.Name = Draft.Scopes.FirstOrDefault(s => s.Id == Draft.ScopeId)?.Name ?? Draft.Name;
    }
}
