@using Connapse.Web.Services
@using Connapse.Storage.ConnectionTesters
@inject AtlassianSiteService Sites

@* The Confluence part of the New source dialog: the site's spaces to tick, and what to read from each. *@

<SetupGuideLink Id="confluence-setup-guide" Href="@ConfluenceSpaceSelection.GuideUrl" />

<fieldset class="mb-3" id="confluence-spaces" aria-describedby="@SpacesDescribedBy">
    <legend class="form-label fs-6 mb-1">@ConfluenceSpaceSelection.SpacesLabel</legend>
    <div class="form-check mb-2">
        <input id="confluence-personal" type="checkbox" class="form-check-input" checked="@Selection.IncludePersonal"
               disabled="@loading" aria-describedby="confluence-personal-help" @onchange="OnPersonalChanged" />
        <label for="confluence-personal" class="form-check-label">@ConfluenceSpaceSelection.IncludePersonalLabel</label>
        <div id="confluence-personal-help" class="form-text mt-0">
            Also list people's own personal spaces, not only the site's team spaces.
        </div>
    </div>

    @if (loading)
    {
        <div class="text-muted small" role="status">
            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Loading spaces...
        </div>
    }
    else if (loadError is not null)
    {
        <div class="alert alert-danger py-2 small mb-0" role="alert" id="confluence-spaces-load-error">
            <span class="bi-x-circle me-1" aria-hidden="true"></span>@loadError
            <a class="alert-link ms-1" href="@(loadErrorUrl ?? AtlassianSiteTroubleshooting.UrlOf(AtlassianSiteTroubleshooting.General))"
               target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
    }
    else if (Selection.Available.Count == 0)
    {
        <div class="text-muted small" role="status" id="confluence-spaces-none">
            This site has no spaces the service account can see.
            <a href="@AtlassianSiteTroubleshooting.UrlOf(AtlassianSiteTroubleshooting.NoSpaces)" target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
    }
    else
    {
        <div class="border rounded p-2 @(Selection.SpacesError is null ? "" : "border-danger")" style="max-height: 16rem; overflow-y: auto;">
            @foreach (var space in Selection.Available)
            {
                bool exists = ExistingSpaceIds.Contains(space.Id);
                <div class="form-check">
                    <input id="space-@space.Id" type="checkbox" class="form-check-input confluence-space-option @(Selection.SpacesError is null ? "" : "is-invalid")"
                           checked="@Selection.Selected.Contains(space.Id)" disabled="@exists"
                           aria-invalid="@(Selection.SpacesError is null ? null : "true")"
                           @onchange="e => Toggle(space.Id, (bool)(e.Value ?? false))" />
                    <label for="space-@space.Id" class="form-check-label">
                        @space.Name <span class="text-muted small">(@space.Key)</span>
                        @if (exists)
                        {
                            <span class="badge text-bg-secondary ms-1">already added</span>
                        }
                    </label>
                </div>
            }
        </div>
    }
    @if (Selection.SpacesError is { } spacesError)
    {
        <div id="confluence-spaces-error" class="invalid-feedback d-block fw-semibold" role="alert">
            <span class="bi-x-circle me-1" aria-hidden="true"></span>@spacesError
        </div>
    }
    <div id="confluence-spaces-help" class="form-text">
        @ConfluenceSpaceSelection.SpacesHelp
    </div>
</fieldset>

<fieldset id="confluence-attachments-group">
    <legend class="form-label fs-6 mb-1">@ConfluenceSpaceSelection.AttachmentsLabel</legend>
    <div class="form-check">
        <input id="confluence-attachments" type="checkbox" class="form-check-input"
               aria-describedby="@(Selection.AttachmentScopeUnconfirmed ? "confluence-attachments-help confluence-attachments-scope" : "confluence-attachments-help")"
               @bind="Selection.IncludeAttachments" @bind:after="AttachmentsChanged" />
        <label for="confluence-attachments" class="form-check-label">@ConfluenceSpaceSelection.IncludeAttachmentsLabel</label>
        <div id="confluence-attachments-help" class="form-text mt-0">
            @ConfluenceSpaceSelection.IncludeAttachmentsHelp
        </div>
        @if (Selection.AttachmentScopeUnconfirmed)
        {
            <div id="confluence-attachments-scope" class="form-text mt-1">
                <span class="bi-info-circle me-1" aria-hidden="true"></span>@ConfluenceSpaceSelection.AttachmentScopeUnconfirmedNote
                <a href="@ConfluenceSpaceSelection.MissingScopeGuideUrl" target="_blank" rel="noopener">See Missing scope in the setup guide<span class="visually-hidden"> (opens in a new tab)</span></a>.
            </div>
        }
    </div>
    <div class="ms-4 mb-0">
        <label class="form-label small" for="confluence-max-attachment-mb">@ConfluenceSpaceSelection.MaxAttachmentMbLabel</label>
        <input id="confluence-max-attachment-mb" type="number" class="form-control form-control-sm @(Selection.MaxAttachmentMbError is null ? "" : "is-invalid")"
               min="@ConfluenceSpaceSelection.MinAttachmentMb" max="@ConfluenceSpaceSelection.MaxAttachmentMbLimit" style="max-width: 8rem;"
               aria-describedby="@MaxSizeDescribedBy" aria-invalid="@(Selection.MaxAttachmentMbError is null ? null : "true")"
               disabled="@(!Selection.IncludeAttachments)"
               @bind="Selection.MaxAttachmentMb" @bind:after="ValidateMaxSize" @onblur="ValidateMaxSize" />
        @if (Selection.MaxAttachmentMbError is { } sizeError)
        {
            <div id="confluence-max-attachment-mb-error" class="invalid-feedback d-block fw-semibold" role="alert">
                <span class="bi-x-circle me-1" aria-hidden="true"></span>@sizeError
            </div>
        }
        <div id="confluence-max-attachment-mb-help" class="form-text">
            @ConfluenceSpaceSelection.MaxAttachmentMbHelp
        </div>
    </div>
</fieldset>

@code {
    [Parameter, EditorRequired] public Guid ConnectionId { get; set; }

    [Parameter, EditorRequired] public ConfluenceSpaceSelection Selection { get; set; } = null!;

    /// <summary>Space ids that already have a source on this connection; they cannot be chosen again.</summary>
    [Parameter] public IReadOnlySet<string> ExistingSpaceIds { get; set; } = new HashSet<string>();

    private bool loading;
    private string? loadError;
    private string? loadErrorUrl;
    private Guid loadedFor;
    private bool loadedPersonal;

    protected override async Task OnParametersSetAsync()
    {
        if (ConnectionId == Guid.Empty
            || (loadedFor == ConnectionId && loadedPersonal == Selection.IncludePersonal))
            return;

        await LoadAsync();
    }

    private async Task OnPersonalChanged(ChangeEventArgs e)
    {
        Selection.IncludePersonal = (bool)(e.Value ?? false);
        await LoadAsync();
    }

    private void Toggle(string id, bool on)
    {
        if (on) Selection.Selected.Add(id);
        else Selection.Selected.Remove(id);

        // An error shown for an empty choice goes away once a space is ticked; any other stays until the next submit.
        if (Selection.Selected.Count > 0 && Selection.SpacesError == ConfluenceSpaceSelection.NoSpaceChosen)
            Selection.SpacesError = null;
    }

    private void ValidateMaxSize() => Selection.ValidateMaxAttachmentMb();

    // Turning attachments off makes the size irrelevant, so an error about it is cleared; turning them on re-checks it.
    private void AttachmentsChanged()
    {
        if (Selection.MaxAttachmentMbError is not null || !Selection.IncludeAttachments)
            Selection.ValidateMaxAttachmentMb();
    }

    private string SpacesDescribedBy =>
        Selection.SpacesError is null ? "confluence-spaces-help" : "confluence-spaces-error confluence-spaces-help";

    private string MaxSizeDescribedBy =>
        Selection.MaxAttachmentMbError is null
            ? "confluence-max-attachment-mb-help"
            : "confluence-max-attachment-mb-error confluence-max-attachment-mb-help";

    private int generation;

    private async Task LoadAsync()
    {
        // A response belongs to the connection and selection it was requested for. If the admin
        // has switched sites since, the answer is for the wrong site and must not be shown.
        int mine = ++generation;
        Guid connectionId = ConnectionId;
        var selection = Selection;
        bool includePersonal = selection.IncludePersonal;

        loadedFor = connectionId;
        loadedPersonal = includePersonal;
        loading = true;
        (loadError, loadErrorUrl) = (null, null);
        try
        {
            var listed = await Sites.ListSpacesAsync(connectionId, includePersonal);
            if (mine != generation) return;

            switch (listed.Outcome)
            {
                case AtlassianSpacesOutcome.Listed:
                    selection.Available = listed.Spaces!;
                    selection.Selected.IntersectWith(listed.Spaces!.Select(s => s.Id));
                    break;
                case AtlassianSpacesOutcome.Unavailable:
                    selection.Available = [];
                    (loadError, loadErrorUrl) = (listed.Error, listed.TroubleshootingUrl);
                    break;
                default:
                    selection.Available = [];
                    loadError = "That connection is not an Atlassian site.";
                    break;
            }
        }
        catch (Exception)
        {
            // An exception escaping a Blazor lifecycle method tears down the circuit.
            if (mine != generation) return;
            selection.Available = [];
            loadError = "Could not list this site's spaces.";
        }
        finally
        {
            if (mine == generation)
                loading = false;
        }
    }
}
