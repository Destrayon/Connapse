@using System.Security.Claims
@using Connapse.Core
@using Connapse.Core.Interfaces
@using Connapse.Storage.Connectors.Atlassian
@using Connapse.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AtlassianLinkAppService LinkApp
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@inject ILogger<AtlassianProviderCard> Logger

@*
    The Atlassian provider's setup: the app people link their accounts through, so Connapse can
    check them against Atlassian products. Sites are not set up here: each one is a connection,
    added on the Connections page with the service account Connapse reads it as.
*@

<ProviderStepCard @ref="stepCard" Id="atlassian-app" Title="Linking app"
                  Description="The Atlassian app people sign in through so search can respect what they may read."
                  Status="AppStatus" StatusLabel="@AppStatusLabel"
                  Expanded="showAppSetup" ExpandedChanged="SetExpanded" EditLabel="Change the linking app"
                  Summary="@AppSummary" Actions="@AppActions">
    <ManualContent>
        <p class="small mb-2" id="atlassian-app-prerequisites">
            You need an Atlassian account that can create apps in the developer console, a privacy policy URL
            for your organization, and Connapse served over HTTPS: Atlassian accepts the callback URL only over
            HTTPS, except for localhost.
        </p>
        @if (CallbackIsInsecure)
        {
            <div class="alert alert-warning py-2 small" role="note" id="atlassian-app-insecure">
                <span class="bi-exclamation-triangle me-1" aria-hidden="true"></span>
                This address is not HTTPS, so Atlassian will refuse the callback URL below. Open Connapse over
                HTTPS before creating the app.
            </div>
        }

        <ProviderSetupGuide Title="Create the app in the Atlassian developer console" Open="@(linkApp is null)">
            <ol class="small mb-0">
                <li>
                    Open the <a href="@DeveloperConsole" target="_blank" rel="noopener">Atlassian developer console<span class="visually-hidden"> (opens in a new tab)</span></a>
                    and choose <strong>Create</strong> &rarr; <strong>OAuth 2.0 integration</strong>.
                </li>
                <li>
                    Name it <strong>Connapse – your organization</strong> so Atlassian and your users can see which software it is,
                    set <strong>Access type</strong> to <strong>Account-level</strong>, agree to the developer terms, and create it.
                    Account-level means people don't have to pick a site when they sign in.
                </li>
                <li>
                    <strong>Permissions</strong>: next to <strong>User identity API</strong> choose <strong>Add</strong>, then
                    <strong>Configure</strong> and add the <code>read:me</code> scope. Nothing else is needed.
                </li>
                <li>
                    <strong>Authorization</strong>: next to <strong>OAuth 2.0 (3LO)</strong>, Atlassian's name for signing people in
                    through an app, choose <strong>Configure</strong>, set the callback URL to
                    <code id="atlassian-callback-url" class="text-break">@CallbackUrl</code>
                    <button type="button" id="atlassian-copy-callback" class="btn btn-sm btn-outline-secondary ms-1 py-0 px-1"
                            style="min-width:24px;min-height:24px" aria-label="Copy the callback URL" @onclick="CopyCallbackUrl">
                        <span class="bi-clipboard" aria-hidden="true"></span>
                    </button>
                    and <strong>Save changes</strong>.
                </li>
                <li>
                    <strong>Distribution</strong>: a new app is private, so only you can sign in through it. Before anyone else can, choose
                    <strong>Sharing</strong> and fill in the vendor name (your organization), a privacy policy URL, and the personal-data
                    question (<strong>No</strong>: Connapse keeps only each linked person's Atlassian account ID, never their name or email).
                    People then see a notice that Atlassian hasn't reviewed the app, which is expected.
                </li>
                <li><strong>Settings</strong>: copy the client ID and secret, and paste them under <strong>@AtlassianLinkAppFieldSpecs.ClientId.Group</strong> below.</li>
            </ol>
            <span class="small @(copySucceeded ? "text-success" : "text-danger")" role="status">@appCopyMessage</span>
        </ProviderSetupGuide>

        <section class="border rounded p-3 mt-3" aria-labelledby="atlassian-app-credentials-heading">
            <h3 id="atlassian-app-credentials-heading" class="h6">@AtlassianLinkAppFieldSpecs.ClientId.Group</h3>
            @if (linkApp is not null)
            {
                <p class="small mb-3" id="atlassian-app-current">
                    The secret is stored encrypted and is never shown. Enter both values only to replace the app.
                </p>
            }
            <ProviderField @ref="clientIdField" Spec="AtlassianLinkAppFieldSpecs.ClientId" Small="true" Value="@appClientId"
                           ValueChanged="@((string? v) => appClientId = v)" Disabled="@appBusy" Error="@clientIdError" />
            <ProviderField Spec="AtlassianLinkAppFieldSpecs.ClientSecret" Small="true" Value="@appClientSecret"
                           ValueChanged="@((string? v) => appClientSecret = v)" Disabled="@appBusy" Error="@secretError">
                <ErrorContent>
                    @if (secretRejected)
                    {
                        <a class="ms-1" href="@AtlassianLinkAppFieldSpecs.TroubleshootingRejected" target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
                        @AtlassianAnswer(secretErrorDetail, "atlassian-app-secret-detail")
                    }
                </ErrorContent>
            </ProviderField>

            @if (confirmingReplace && linkApp is not null)
            {
                <div class="alert alert-warning py-2 small" role="group" aria-labelledby="atlassian-app-replace-text" id="atlassian-app-replace">
                    <p id="atlassian-app-replace-text" class="mb-2">
                        Replace the linking app? The @PeopleLinked who linked an Atlassian account keep their links.
                        New sign-ins use the new app. Connapse checks the new client ID and secret with Atlassian before saving.
                        @if (!linkApp.SignInEnabled)
                        {
                            <text>Saving also turns Atlassian sign-in back on.</text>
                        }
                    </p>
                    <button @ref="replaceConfirmButton" type="button" id="atlassian-app-replace-confirm" class="btn btn-sm btn-warning"
                            disabled="@appBusy" @onclick="CheckAndSaveAsync">Check and replace</button>
                    <button type="button" id="atlassian-app-replace-keep" class="btn btn-sm btn-outline-secondary ms-1" @onclick="KeepCurrentApp">Keep the current app</button>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <button @ref="saveButton" type="button" id="atlassian-app-save" class="btn btn-sm btn-outline-primary" disabled="@appBusy" @onclick="SaveAppAsync">
                        @if (appBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Checking with Atlassian…</span>
                        }
                        else
                        {
                            <span>Check and save</span>
                        }
                    </button>
                    @if (linkApp is not null)
                    {
                        <button type="button" id="atlassian-app-cancel" class="btn btn-sm btn-outline-secondary" disabled="@appBusy" @onclick="CancelFromButton">Cancel</button>
                    }
                </div>
            }
            @if (appError is not null)
            {
                <div class="text-danger small mt-2" role="alert" id="atlassian-app-error">
                    <span class="bi-x-circle me-1" aria-hidden="true"></span>@appError
                    @if (appErrorUnreachable)
                    {
                        <a class="ms-1" href="@UnreachableHelp" target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
                    }
                    @AtlassianAnswer(appErrorDetail, "atlassian-app-error-detail")
                </div>
            }
        </section>
    </ManualContent>
</ProviderStepCard>

<p class="small text-muted mt-3" id="atlassian-sites-elsewhere">
    <span class="bi-info-circle me-1" aria-hidden="true"></span>
    Atlassian sites are added on the <a href="/connections">Connections page</a>, as a Confluence site
    or a Jira site, each with the service account Connapse reads it as. Then add a source on the site to
    choose what to index.
</p>

@code {
    private const string DeveloperConsole = "https://developer.atlassian.com/console/myapps/";

    private AtlassianLinkAppRegistration? linkApp;
    private int? linkedPeople;
    private bool showAppSetup;
    private bool appBusy;
    private bool checkBusy;
    private bool confirmingReplace;
    private bool focusReplaceConfirm;
    private bool copySucceeded;
    private bool secretRejected;
    private bool showNextSteps;
    private bool toggleBusy;
    private bool removeBusy;
    private bool appErrorUnreachable;
    private string? alertTroubleshootingUrl;
    private string? appClientId;
    private string? appClientSecret;
    private string? clientIdError;
    private string? secretError;
    private string? secretErrorDetail;
    private string? appError;
    private string? appErrorDetail;
    private string? appCopyMessage;
    private string? statusMessage;
    private string? alertMessage;
    private string? alertDetail;
    private ElementReference replaceConfirmButton;

    private const string UnreachableHelp = AtlassianLinkAppFieldSpecs.Guide + "#couldnt-reach-atlassian";

    /// <summary>
    /// Where the outcome of an action goes: the alert at the top of the Providers page, as for every
    /// other provider. Errors about a field stay beside the field.
    /// </summary>
    [Parameter] public EventCallback<ProviderPageMessage?> OnMessage { get; set; }

    private ProviderPageMessage? CurrentMessage =>
        statusMessage is not null ? new ProviderPageMessage(statusMessage, true, showNextSteps ? NextSteps : null)
        : alertMessage is not null ? new ProviderPageMessage(alertMessage, false, AlertExtra(alertTroubleshootingUrl, alertDetail))
        : null;

    private Task PublishMessageAsync() => OnMessage.InvokeAsync(CurrentMessage);

    private static readonly RenderFragment NextSteps =
        @<span class="ms-1" id="atlassian-app-next-steps">
            <a href="/profile/integrations">Link your own account</a> to try it, then
            add a <a href="/connections?new=confluence">Confluence site</a> or a
            <a href="/connections?new=jira">Jira site</a>.
        </span>;

    private static RenderFragment AlertExtra(string? troubleshootingUrl, string? detail) =>
        @<text>
            @if (troubleshootingUrl is not null)
            {
                <a class="ms-1" href="@troubleshootingUrl" target="_blank" rel="noopener">Troubleshooting<span class="visually-hidden"> (opens in a new tab)</span></a>
            }
            @AtlassianAnswer(detail, "atlassian-app-alert-detail")
        </text>;

    /// <summary>When the stored app is checked next, so an administrator can tell its status is current.</summary>
    private static string CheckSchedule(AtlassianLinkAppRegistration app) => app switch
    {
        { SignInEnabled: false } => "Not checked automatically while sign-in is off.",
        { CallbackUrl: null or "" } => "Checked automatically every day once Recheck has run here.",
        _ => "Checked automatically every day.",
    };

    /// <summary>Atlassian's own answer, behind a disclosure: the message above says what it means.</summary>
    private static RenderFragment AtlassianAnswer(string? detail, string id) => detail is null
        ? _ => { }
        : @<details class="mt-1" id="@id"><summary>Details</summary>Atlassian answered: <code class="text-break">@detail</code></details>;

    private string CallbackUrl => Navigation.BaseUri + Connapse.Web.Endpoints.CloudIdentityEndpoints.AtlassianCallbackPath;

    private bool CallbackIsInsecure
    {
        get
        {
            var uri = new Uri(Navigation.BaseUri);
            return uri.Scheme != Uri.UriSchemeHttps && !uri.IsLoopback;
        }
    }

    // Ready once saved and accepted: nobody having signed in through it yet says nothing about its setup.
    private RequirementStatus AppStatus => linkApp switch
    {
        null => RequirementStatus.NotConfigured,
        { CheckAccepted: false } => RequirementStatus.Failed,
        { SignInEnabled: false } => RequirementStatus.Warning,
        _ => RequirementStatus.Satisfied,
    };

    /// <summary>Whether the client ID and secret fields are on screen, as the step card decides.</summary>
    private bool SetupOpen => AppStatus != RequirementStatus.Satisfied || showAppSetup;

    private string AppStatusLabel => linkApp switch
    {
        null => "Not set up",
        { CheckAccepted: false } => "Rejected by Atlassian",
        { SignInEnabled: false } => "Sign-in turned off",
        _ => "Ready",
    };

    private string PeopleLinked => linkedPeople switch
    {
        null => "people",
        1 => "1 person",
        int n => $"{n} people",
    };

    private string RemoveHelp =>
        $"{(linkedPeople is null ? "People" : PeopleLinked)} linked an Atlassian account. They keep their links, but nobody can "
        + "link a new account until you add a linking app again. To stop new links for a while instead, turn off Atlassian sign-in.";

    private RenderFragment AppSummary => linkApp is not { } app
        ? @<p class="mb-0" id="atlassian-app-requirement">@ProviderSetupReader.AtlassianNoLinkAppDetail</p>
        : @<div id="atlassian-app-summary">
              @if (app.CheckAccepted == false)
              {
                  <p class="mb-2">@ProviderSetupReader.AtlassianLinkAppRejectedDetail Paste a new secret under @AtlassianLinkAppFieldSpecs.ClientId.Group.</p>
              }
              else if (!app.SignInEnabled)
              {
                  <p class="mb-2">@ProviderSetupReader.AtlassianSignInOffDetail</p>
              }
              <dl class="provider-step-values mb-0">
                  <dt>Client ID</dt><dd><code>@app.ClientId</code></dd>
                  <dt>Permission</dt><dd><code>read:me</code> (User identity API): reads each person's Atlassian account ID, nothing else</dd>
                  <dt>Atlassian sign-in</dt><dd id="atlassian-app-sign-in">@(app.SignInEnabled ? "On" : "Off")</dd>
                  <dt>Last checked</dt>
                  <dd id="atlassian-app-checked">
                      @if (app.CheckedAt is { } checkedAt)
                      {
                          <text>@checkedAt.ToString("u"): @(app.CheckAccepted == true ? "accepted by Atlassian" : "rejected by Atlassian")</text>
                      }
                      else
                      {
                          <text>Not yet. Choose Recheck.</text>
                      }
                      <span class="d-block text-muted" id="atlassian-app-check-schedule">@CheckSchedule(app)</span>
                  </dd>
                  <dt>Last used for a sign-in</dt><dd>@(app.VerifiedAt is { } used ? used.ToString("u") : "Not yet")</dd>
                  @if (linkedPeople is { } count)
                  {
                      <dt>People linked</dt><dd id="atlassian-app-linked">@count</dd>
                  }
              </dl>
          </div>;

    // Null without an app, so the card draws no empty actions row.
    private RenderFragment? AppActions => linkApp is not { } app ? null : @<text>
        <button type="button" id="atlassian-app-recheck" class="btn btn-sm btn-outline-secondary" disabled="@checkBusy" @onclick="RecheckAsync">
            @if (checkBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Rechecking…</span>
            }
            else
            {
                <span>Recheck</span>
            }
        </button>
        <button type="button" id="atlassian-sign-in-toggle" class="btn btn-sm btn-outline-secondary" @onclick="ToggleSignInAsync"
                disabled="@(toggleBusy || removeBusy)" aria-describedby="atlassian-sign-in-toggle-help">
            @if (toggleBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                <span>@(app.SignInEnabled ? "Turning off…" : "Turning on…")</span>
            }
            else
            {
                @(app.SignInEnabled ? "Turn off Atlassian sign-in" : "Turn on Atlassian sign-in")
            }
        </button>
        @* The next step, as GitHub's card offers "Add a GitHub connection". While the setup is
           open, Check and save is the one primary action. *@
        <a id="atlassian-add-site" class="btn btn-sm @(SetupOpen ? "btn-outline-secondary" : "btn-outline-primary")" href="/connections?new=confluence">
            <span class="bi-plug me-1" aria-hidden="true"></span> Add a Confluence site
        </a>
        <a id="atlassian-add-jira-site" class="btn btn-sm btn-outline-secondary" href="/connections?new=jira">
            <span class="bi-plug me-1" aria-hidden="true"></span> Add a Jira site
        </a>
        @* Placed as GitHub's: at the right of the row, set apart from the other actions by a divider. *@
        <div class="ms-auto" id="atlassian-app-remove">
            <ProviderResetAction OnReset="RemoveAppAsync"
                                 Label="Remove the linking app from Connapse"
                                 ConfirmLabel="Remove the linking app"
                                 ConfirmText="@app.ClientId"
                                 BusyLabel="Removing…"
                                 Disabled="@toggleBusy"
                                 HelpText="@RemoveHelp" />
        </div>
        @* Its own full-width line under the buttons, so it doesn't stretch the row. *@
        <div id="atlassian-sign-in-toggle-help" class="form-text w-100 mt-0">
            @(app.SignInEnabled
                ? "Turning off sign-in stops new links for everyone. People who linked keep their links, and you can turn it back on."
                : "Turning on sign-in lets people link their Atlassian accounts again.")
        </div>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // A control that removes itself hands focus on after the render that removes it.
    private ProviderStepCard? stepCard;
    private ProviderField? clientIdField;
    private ElementReference saveButton;
    private Func<ValueTask>? focusAfterRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusReplaceConfirm)
        {
            focusReplaceConfirm = false;
            await replaceConfirmButton.FocusAsync();
        }
        if (focusAfterRender is { } focus)
        {
            focusAfterRender = null;
            await focus();
        }
    }

    /// <summary>The setup closed under the control that closed it: back to the toggle that reopens it.</summary>
    private ValueTask FocusEditToggle() => stepCard?.FocusEditToggleAsync() ?? ValueTask.CompletedTask;

    /// <summary>
    /// After the replace confirmation closes: to Check and save if the setup is still open (the
    /// check failed, or the confirmation was declined), otherwise to the toggle that reopens it.
    /// </summary>
    private ValueTask FocusAfterConfirmation() =>
        stepCard is { HasEditToggle: true } && !showAppSetup ? FocusEditToggle() : saveButton.FocusAsync();

    private void KeepCurrentApp()
    {
        confirmingReplace = false;
        focusAfterRender = () => saveButton.FocusAsync();
    }

    private async Task LoadAsync()
    {
        linkApp = await LinkApp.GetAsync();
        appClientId = linkApp?.ClientId; // not a secret, so the saved one is shown for editing
        linkedPeople = await LinkApp.CountLinkedPeopleAsync();
    }

    private void SetExpanded(bool expanded)
    {
        showAppSetup = expanded;
        if (!expanded) CancelEdit();
    }

    private void CancelEdit()
    {
        appClientId = linkApp?.ClientId;
        appClientSecret = null;
        (clientIdError, secretError, appError, secretRejected, confirmingReplace) = (null, null, null, false, false);
        (secretErrorDetail, appErrorDetail, appErrorUnreachable) = (null, null, false);
        showAppSetup = false;
    }

    /// <summary>Cancel closes the setup it sits in, so focus goes to the toggle that reopens it.</summary>
    private void CancelFromButton()
    {
        CancelEdit();
        focusAfterRender = FocusEditToggle;
    }

    private void ClearMessages()
    {
        (clientIdError, secretError, appError, secretRejected) = (null, null, null, false);
        (secretErrorDetail, appErrorDetail, appErrorUnreachable) = (null, null, false);
        (statusMessage, alertMessage, alertTroubleshootingUrl, alertDetail, showNextSteps) = (null, null, null, null, false);
    }

    private async Task SaveAppAsync()
    {
        ClearMessages();
        await PublishMessageAsync();
        if (string.IsNullOrWhiteSpace(appClientId))
            clientIdError = "Enter the client ID. It is under Settings on the app in the developer console.";
        if (string.IsNullOrWhiteSpace(appClientSecret))
            secretError = "Enter the client secret. It is under Settings on the app, below the client ID.";
        if (clientIdError is not null || secretError is not null)
            return;

        if (linkApp is not null)
        {
            // Replacing affects everyone who signs in next, so it is confirmed first.
            confirmingReplace = true;
            focusReplaceConfirm = true;
            return;
        }

        await CheckAndSaveAsync();
    }

    private async Task CheckAndSaveAsync()
    {
        confirmingReplace = false;
        if (string.IsNullOrWhiteSpace(appClientId) || string.IsNullOrWhiteSpace(appClientSecret))
            return;

        appBusy = true;
        try
        {
            string clientId = appClientId.Trim();
            var state = await AuthState.GetAuthenticationStateAsync();
            Guid? userId = Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid id) ? id : null;

            var saved = await LinkApp.CheckAndSaveAsync(clientId, appClientSecret, CallbackUrl, userId);
            if (saved.Outcome == AtlassianLinkAppSaveOutcome.Rejected)
            {
                // The secret stays in the field, so it can be corrected rather than copied again.
                secretError = "Atlassian rejected this client ID and secret, so nothing was saved. Copy both again from Settings on the app in the developer console.";
                (secretRejected, secretErrorDetail) = (true, saved.Detail);
                return;
            }
            if (saved.Outcome == AtlassianLinkAppSaveOutcome.Unreachable)
            {
                appError = "Couldn't reach Atlassian to check the app, so nothing was saved. Check that this server can reach auth.atlassian.com over HTTPS, then try again.";
                (appErrorUnreachable, appErrorDetail) = (true, saved.Detail);
                return;
            }
            // Never rendered back, and no reason to keep it in the circuit's memory.
            appClientSecret = null;
            showAppSetup = false;
            await LoadAsync();
            appClientId = linkApp?.ClientId ?? clientId;
            statusMessage = "Atlassian accepted the client ID and secret, and the linking app is saved. People can now link their Atlassian accounts from their profile.";
            showNextSteps = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not save the Atlassian linking app");
            appError = "The app could not be saved. Nothing was changed; try again.";
        }
        finally
        {
            appBusy = false;
            // The confirmation, or on success the whole setup, is gone from under the button pressed.
            focusAfterRender = FocusAfterConfirmation;
            await PublishMessageAsync();
        }
    }

    private async Task RecheckAsync()
    {
        ClearMessages();
        await PublishMessageAsync();
        checkBusy = true;
        try
        {
            var result = await LinkApp.RecheckWithDetailAsync(CallbackUrl);
            await LoadAsync();

            alertDetail = result?.Detail;
            switch (result?.Result)
            {
                case AtlassianLinkAppCheck.Accepted:
                    statusMessage = "Atlassian accepted the stored client ID and secret.";
                    break;
                case AtlassianLinkAppCheck.Rejected:
                    alertMessage = "Atlassian rejected the stored client ID or secret, so nobody new can link an account. Choose Change the linking app and paste a new secret.";
                    alertTroubleshootingUrl = AtlassianLinkAppFieldSpecs.TroubleshootingRejected;
                    break;
                case AtlassianLinkAppCheck.Unknown:
                    alertMessage = "Couldn't reach Atlassian to check the app. Nothing was changed. Check that this server can reach auth.atlassian.com over HTTPS, then try again.";
                    alertTroubleshootingUrl = UnreachableHelp;
                    break;
                default:
                    alertMessage = "No linking app is stored.";
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not check the Atlassian linking app");
            alertMessage = "The app could not be checked. Nothing was changed; try again.";
        }
        finally
        {
            checkBusy = false;
            await PublishMessageAsync();
        }
    }

    private async Task ToggleSignInAsync()
    {
        if (linkApp is null || toggleBusy) return;
        ClearMessages();
        await PublishMessageAsync();
        bool enable = !linkApp.SignInEnabled;
        toggleBusy = true;
        try
        {
            if (!await LinkApp.SetSignInEnabledAsync(enable))
            {
                alertMessage = "No linking app is stored.";
                return;
            }
            await LoadAsync();
            statusMessage = enable
                ? "Atlassian sign-in is on. People can link their accounts from their profile."
                : "Atlassian sign-in is off. People who linked keep their links; nobody new can link until you turn it back on.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not change whether Atlassian sign-in is on");
            alertMessage = "Atlassian sign-in could not be changed. Nothing was changed; try again.";
        }
        finally
        {
            toggleBusy = false;
            await PublishMessageAsync();
        }
    }

    private async Task RemoveAppAsync()
    {
        ClearMessages();
        await PublishMessageAsync();
        removeBusy = true;
        try
        {
            // ProviderResetAction enabled the confirm button only once the client ID was typed.
            if (await LinkApp.RemoveAsync(linkApp?.ClientId) != AtlassianLinkAppRemoveOutcome.Removed)
            {
                await LoadAsync();
                alertMessage = "No linking app is stored.";
                return;
            }
            await LoadAsync();
            // The remove action went with the app; the setup it reopens starts at the client ID.
            focusAfterRender = () => clientIdField?.FocusAsync() ?? ValueTask.CompletedTask;
            statusMessage = "The linking app was removed. People who linked keep their links, but nobody can link an account until a new app is added.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not remove the Atlassian linking app");
            alertMessage = "The linking app could not be removed. Nothing was changed; try again.";
        }
        finally
        {
            removeBusy = false;
            await PublishMessageAsync();
        }
    }

    private async Task CopyCallbackUrl()
    {
        copySucceeded = await JS.InvokeAsync<bool>("connapse.copyToClipboard", CallbackUrl);
        appCopyMessage = copySucceeded ? "Copied." : "Couldn't copy. Select the text and copy it yourself.";
    }
}
