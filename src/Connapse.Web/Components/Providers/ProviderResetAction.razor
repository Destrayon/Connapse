<div class="provider-reset-action">
    @if (confirming)
    {
        @if (!string.IsNullOrWhiteSpace(ConfirmText))
        {
            <label class="form-label small mb-1" for="@InputId">Type <strong>@ConfirmText</strong> to confirm</label>
            <input id="@InputId" class="form-control form-control-sm mb-2" style="max-width:20rem" autocomplete="off"
                   aria-describedby="@(string.IsNullOrWhiteSpace(HelpText) ? null : HelpId)"
                   @bind="typed" @bind:event="oninput" />
        }
        <button type="button" class="btn btn-sm btn-danger" disabled="@(!Confirmed)" @onclick="ConfirmResetAsync">@ConfirmLabel</button>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelReset">Cancel</button>
    }
    else
    {
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RequestReset">@Label</button>
    }
    @if (confirming && !string.IsNullOrWhiteSpace(HelpText))
    {
        <div id="@HelpId" class="form-text">@HelpText</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Reset this step";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm reset";
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    /// <summary>When set, the reset stays disabled until this exact text is typed.</summary>
    [Parameter] public string? ConfirmText { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];
    private string InputId => $"reset-confirm-{_id}";
    private string HelpId => $"reset-help-{_id}";

    private bool confirming;
    private string? typed;

    private bool Confirmed => string.IsNullOrWhiteSpace(ConfirmText)
        || string.Equals(typed?.Trim(), ConfirmText, StringComparison.Ordinal);

    private void RequestReset() => (confirming, typed) = (true, null);
    private void CancelReset() => (confirming, typed) = (false, null);
    private async Task ConfirmResetAsync()
    {
        if (!Confirmed) return;
        await OnReset.InvokeAsync();
        (confirming, typed) = (false, null);
    }
}
