<div class="provider-reset-action">
    @if (confirming)
    {
        @if (!string.IsNullOrWhiteSpace(ConfirmText))
        {
            <label class="form-label small mb-1" for="@InputId">Type <strong>@ConfirmText</strong> to confirm</label>
            <input @ref="confirmInput" id="@InputId" class="form-control form-control-sm mb-2" style="max-width:20rem" autocomplete="off"
                   aria-describedby="@(string.IsNullOrWhiteSpace(HelpText) ? null : HelpId)" disabled="@resetting"
                   @bind="typed" @bind:event="oninput" />
        }
        <button @ref="confirmButton" type="button" class="btn btn-sm btn-danger" disabled="@(!Confirmed || resetting || Disabled)" @onclick="ConfirmResetAsync">
            @if (resetting)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>@(BusyLabel ?? ConfirmLabel)</span>
            }
            else
            {
                @ConfirmLabel
            }
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled="@resetting" @onclick="CancelReset">Cancel</button>
    }
    else
    {
        <button @ref="trigger" type="button" class="btn btn-sm btn-outline-danger" disabled="@Disabled" @onclick="RequestReset">@Label</button>
    }
    @if (confirming && !string.IsNullOrWhiteSpace(HelpText))
    {
        <div id="@HelpId" class="form-text">@HelpText</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Reset this step";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm reset";
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    /// <summary>When set, the reset stays disabled until this exact text is typed.</summary>
    [Parameter] public string? ConfirmText { get; set; }

    /// <summary>What the confirm button says while the reset runs, beside a spinner.</summary>
    [Parameter] public string? BusyLabel { get; set; }

    /// <summary>Another action on the page is running, so this one waits.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Whether focus returns to the button once a confirmed reset finishes. False where the reset shows
    /// something new that takes focus itself, such as a secret shown once.
    /// </summary>
    [Parameter] public bool RestoreFocus { get; set; } = true;

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];
    private string InputId => $"reset-confirm-{_id}";
    private string HelpId => $"reset-help-{_id}";

    private bool confirming;
    private bool resetting;
    private string? typed;
    private ElementReference trigger;
    private ElementReference confirmInput;
    private ElementReference confirmButton;

    /// <summary>Where focus goes after the next render, as the buttons swap: into the confirmation, or back.</summary>
    private bool? focusConfirmation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusConfirmation is not { } intoConfirmation) return;
        focusConfirmation = null;
        try
        {
            if (!intoConfirmation) await trigger.FocusAsync();
            else if (!string.IsNullOrWhiteSpace(ConfirmText)) await confirmInput.FocusAsync();
            else await confirmButton.FocusAsync();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or InvalidOperationException)
        {
            // The page navigated away, or the action left the page with the reset.
        }
    }

    private bool Confirmed => string.IsNullOrWhiteSpace(ConfirmText)
        || string.Equals(typed?.Trim(), ConfirmText, StringComparison.Ordinal);

    private void RequestReset() => (confirming, typed, focusConfirmation) = (true, null, true);
    private void CancelReset() => (confirming, typed, focusConfirmation) = (false, null, false);
    private async Task ConfirmResetAsync()
    {
        if (!Confirmed || resetting) return;
        resetting = true;
        try
        {
            await OnReset.InvokeAsync();
        }
        finally
        {
            resetting = false;
        }
        (confirming, typed, focusConfirmation) = (false, null, RestoreFocus ? false : null);
    }
}
