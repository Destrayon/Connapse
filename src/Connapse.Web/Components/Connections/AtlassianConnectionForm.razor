@using System.Security.Claims
@using System.Text.Json
@using Connapse.Core
@using Connapse.Core.Interfaces
@using Connapse.Storage.ConnectionTesters
@using Connapse.Storage.Connectors.Atlassian
@using Connapse.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject AtlassianSiteService Sites
@inject IConnectionStore Store
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<AtlassianConnectionForm> Logger

@*
    An Atlassian site as a connection: its address and the service account Connapse reads it as.
    A new site is saved only after every probe passes (or, when the only gap is a site with nothing
    to check administrator access against yet, after the admin chooses to save anyway), so a saved
    site is one Connapse can use. A saved site can be tested again with its stored secret, and its
    credential replaced in place: the new one is tested first and stored only if it passes.

    The secret is never rendered back. After a failed test it is kept, outside every bound field,
    so the admin can retry without pasting it again (Atlassian shows it only once); it is dropped
    once a save succeeds or the admin clears it.
*@

<div class="col-12" style="max-width:40rem">
    @if (PlainHttp)
    {
        <div class="alert alert-warning py-2 small" role="note" id="atlassian-http-warning">
            <span class="bi-unlock me-1" aria-hidden="true"></span>
            This page is served over plain HTTP, so a client secret entered here crosses the network unencrypted.
            Serve Connapse over HTTPS before entering one.
        </div>
    }

    @if (current is { } site)
    {
        AtlassianSiteStatus status = AtlassianSiteStatus.Of(site);
        <dl class="small mb-2" id="atlassian-site-details">
            <dt>Site</dt>
            <dd>@SiteUrlOf(site)</dd>
            <dt>Cloud ID</dt>
            <dd>
                <code>@ConfigValue(site, "cloudId")</code>
                <div class="text-muted">Atlassian's own ID for the site, looked up from its address.</div>
            </dd>
            <dt>Service account client ID</dt>
            <dd><code>@ConfigValue(site, "clientId")</code></dd>
            <dt>Status</dt>
            <dd id="atlassian-site-status" class="@status.CssClass">
                <span class="@status.Icon me-1" aria-hidden="true"></span>@status.Text
            </dd>
            <dt>Last successful check</dt>
            <dd id="atlassian-site-last-success">@AtlassianSiteStatus.When(site.Health?.LastSucceededAt)</dd>
            @if (site.Health is { } health)
            {
                <dt>Last check</dt>
                <dd id="atlassian-site-last-check">
                    @AtlassianSiteStatus.When(health.CheckedAt)@(health.Origin == "sync" ? ", while syncing" : ""):
                    @if (health.Succeeded)
                    {
                        <text>passed.</text>
                    }
                    else
                    {
                        <text>@AtlassianConnectionTester.StepLabel(health.Step) did not pass. @health.Message</text>
                    }
                </dd>
            }
        </dl>

        @if (status.NeedsNewCredentials)
        {
            <div class="alert alert-danger py-2 small" role="alert" id="atlassian-needs-credentials">
                <span class="bi-exclamation-triangle me-1" aria-hidden="true"></span>
                <strong>Needs new credentials.</strong> Atlassian refused this site's stored credential, so its sources can't sync.
                Create a new OAuth 2.0 credential on the service account, then enter it with
                <strong>Replace credentials</strong> below.
            </div>
        }

        <p class="small text-muted mb-2">
            The client secret is stored encrypted and never shown. Rename the site with the Name field above; replace its credential here
            without removing any source.
        </p>
        <p class="small text-muted mb-2" id="atlassian-revoke-help">
            To revoke the credential itself, open
            <a href="@AdminUrl" target="_blank" rel="noopener">Atlassian Administration<span class="visually-hidden"> (opens in a new tab)</span></a>
            → <strong>Directory</strong> → <strong>Service accounts</strong>, choose the service account, and delete its OAuth 2.0 credential.
            <a href="@AtlassianSiteFieldSpecs.SiteConnectionSection" target="_blank" rel="noopener">See the setup guide<span class="visually-hidden"> (opens in a new tab)</span></a>.
        </p>

        <details class="mb-2 small" id="atlassian-site-scopes">
            <summary>Permissions Connapse needs (@ConfirmedCount(site, Scopes) of @Scopes.Count confirmed by the last test)</summary>
            <ul class="list-unstyled mt-2 mb-0">
                @foreach (AtlassianScope scope in Scopes)
                {
                    bool confirmed = site.Health?.ConfirmedScopes?.Contains(scope.Name, StringComparer.OrdinalIgnoreCase) ?? false;
                    <li class="mb-2">
                        <code>@scope.Name</code>
                        @if (scope.Optional)
                        {
                            <span class="badge text-bg-light border ms-1">Optional</span>
                        }
                        <span class="ms-1 @(confirmed ? "text-success" : "text-muted")">
                            <span class="@(confirmed ? "bi-check-circle" : "bi-dash-circle") me-1" aria-hidden="true"></span>@(confirmed ? "Confirmed" : "Not confirmed")
                        </span>
                        <div class="text-muted">@scope.Reason.</div>
                    </li>
                }
            </ul>
            <p class="mb-0 text-muted">
                To take a permission away, edit or delete the service account's credential in
                <a href="@AdminUrl" target="_blank" rel="noopener">Atlassian Administration<span class="visually-hidden"> (opens in a new tab)</span></a>.
            </p>
        </details>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" id="atlassian-retest" class="btn btn-sm btn-outline-secondary" disabled="@(retesting || replaceBusy)" @onclick="RetestAsync">
                @if (retesting)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Testing…</span>
                }
                else
                {
                    <span class="bi-plug me-1" aria-hidden="true"></span><span>Test connection</span>
                }
            </button>
            @if (!replacing)
            {
                <button @ref="replaceOpenButton" type="button" id="atlassian-replace-open" class="btn btn-sm btn-outline-secondary" @onclick="OpenReplace">
                    <span class="bi-key me-1" aria-hidden="true"></span>Replace credentials
                </button>
            }
        </div>
        <div aria-live="polite">
            @if (retesting)
            {
                <span class="visually-hidden" role="status">Testing the site with its stored credential.</span>
            }
        </div>
        @if (retest is { } result)
        {
            <AtlassianTestResultView Result="result" Id="atlassian-retest-result" />
        }

        @if (replacing)
        {
            <section class="border rounded p-3 mt-3" id="atlassian-replace" aria-labelledby="atlassian-replace-title">
                <h3 class="h6" id="atlassian-replace-title">Replace credentials</h3>
                <p class="small mb-2" id="atlassian-replace-consequence">
                    Connapse tests the new client ID and secret against @SiteUrlOf(site) first. Only if every check passes does it
                    store them in place of the current ones; @SourcesPhrase(site) then sync with the new credential and nothing is
                    removed. If the test fails, nothing changes. Afterwards, delete the old credential in Atlassian Administration.
                </p>
                <div>
                    <ProviderField @ref="replaceClientIdField" Spec="AtlassianSiteFieldSpecs.ReplaceClientId" Small="true" Value="@replaceClientId"
                                   ValueChanged="@((string? v) => { replaceClientId = v; replaceClientIdError = null; })"
                                   Error="@replaceClientIdError" Disabled="@replaceBusy" />
                    <ProviderField @ref="replaceClientSecretField" Spec="AtlassianSiteFieldSpecs.ReplaceClientSecret" Small="true" Value="@replaceClientSecret"
                                   ValueChanged="@((string? v) => { replaceClientSecret = v; replaceClientSecretError = null; })"
                                   Error="@replaceClientSecretError" HasStoredValue="@(replaceKept is not null)" Disabled="@replaceBusy" />
                </div>
                @if (replaceKept is not null)
                {
                    <p class="small mb-2" id="atlassian-replace-kept" role="status">
                        <span class="bi-shield-lock me-1" aria-hidden="true"></span>Secret kept for your next attempt.
                        <button type="button" id="atlassian-replace-secret-clear" class="btn btn-sm btn-link p-0 align-baseline" @onclick="ClearReplaceKept">Clear it</button>
                    </p>
                }
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" id="atlassian-replace-save" class="btn btn-sm btn-primary" disabled="@replaceBusy" @onclick="() => ReplaceAsync(saveAnyway: false)">
                        @if (replaceBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Checking with Atlassian…</span>
                        }
                        else
                        {
                            <span>Check and replace</span>
                        }
                    </button>
                    <button type="button" class="btn btn-sm btn-secondary" disabled="@replaceBusy" @onclick="CloseReplace">Cancel</button>
                </div>
                @if (replaceError is not null)
                {
                    <div class="alert alert-danger py-2 mt-2 mb-0 small" role="alert" id="atlassian-replace-error">
                        <span class="bi-x-circle me-1" aria-hidden="true"></span>@replaceError
                    </div>
                }
                @if (replaceResult is { } replaced)
                {
                    <AtlassianTestResultView Result="replaced" Id="atlassian-replace-result" Busy="@replaceBusy"
                                             SaveAnywayLabel="Replace anyway" OnSaveAnyway="() => ReplaceAsync(saveAnyway: true)" />
                }
            </section>
        }
    }
    else
    {
        @if (IsJira)
        {
            <p class="small text-muted" id="atlassian-site-intro">
                A Jira Cloud site, read as a service account.
                This service account reads your site's Jira projects for Jira sources and checks each user's access.
                The site is saved only once every check passes.
            </p>
        }
        else
        {
            <p class="small text-muted" id="atlassian-site-intro">
                A Confluence Cloud site, read as a service account.
                This service account reads your site's Confluence spaces for Confluence sources and checks each user's access.
                The site is saved only once every check passes.
            </p>
        }

        <details class="border rounded p-3 mb-3" open id="atlassian-service-account-guide">
            <summary class="fw-semibold small">Create the service account in Atlassian admin</summary>
            <p class="small mt-2 mb-2">
                You need to be an organization admin, and the organization must use centralized user management.
                Service accounts are free (five per organization) and don't take a product seat.
                <a href="@AtlassianSiteFieldSpecs.ServiceAccountSection" target="_blank" rel="noopener">Step-by-step guide<span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
            @if (IsJira)
            {
                <ol class="small">
                    <li>
                        In <a href="@AdminUrl" target="_blank" rel="noopener">Atlassian Administration<span class="visually-hidden"> (opens in a new tab)</span></a>,
                        go to <strong>Directory</strong> &rarr; <strong>Service accounts</strong> &rarr; <strong>Create a service account</strong>.
                        Name it (6 to 30 letters or digits, for example <code>connapse</code>). A service account you already use for
                        this site can serve Jira too.
                    </li>
                    <li>
                        On <strong>Select app roles</strong>, set <strong>Jira</strong> to <strong>User</strong> (access to Jira) and
                        <strong>Jira Administration</strong> to <strong>App admin</strong>, which gives the
                        <strong>Administer Jira</strong> and <strong>Browse users and groups</strong> permissions. Connapse needs them to ask
                        what each person may read, and Check and save checks for them. App admin doesn't add the account to any group, so
                        Jira's <strong>Global permissions</strong> page won't list it. If the check fails, add the service account to the
                        <strong>jira-admins-</strong><em>site</em> group under <strong>Directory</strong> &rarr; <strong>Groups</strong> and test again.
                    </li>
                    <li>
                        The service account must be able to see every project you will index (Jira on newer sites calls projects spaces).
                        A team-managed space set to <strong>Open</strong> or <strong>Limited</strong> under <strong>&bull;&bull;&bull;</strong> next to its
                        name &rarr; <strong>Space settings</strong> &rarr; <strong>Access</strong> already lets it; a <strong>Private</strong> one needs it added as
                        <strong>Viewer</strong>. A company-managed project on the default permission scheme already grants <strong>Browse Projects</strong>
                        to everyone with Jira access. A project it can't see is not listed.
                    </li>
                    <li>
                        Add the service account to every group and project role your team restricts comments to. A comment
                        restricted to a group or role it isn't in is never indexed, and Connapse can't tell it exists.
                    </li>
                    <li>
                        Back on the service account, choose <strong>Create credentials</strong> &rarr; <strong>OAuth 2.0</strong>. On
                        <strong>Select scopes</strong>, choose <strong>Copy required scopes</strong> below and paste it into the search
                        box: the list narrows to exactly these @RequiredScopes.Count, so tick each one. Only if a source will include
                        attachments, choose <strong>Copy with the attachments permission</strong> instead, which adds
                        <code>@Connapse.Web.Components.Sources.JiraProjectSelection.AttachmentScope</code>; you can add it later when a source needs it.
                        Make this a credential for Jira only, separate from the one this site's other connection uses. Its scopes can't
                        be changed later: to change them, create a new credential, use <strong>Replace credentials</strong>, then revoke the old one.
                        Create it, then copy the client ID and secret: the secret is shown only once.
                    </li>
                </ol>
            }
            else
            {
                <ol class="small">
                    <li>
                        In <a href="@AdminUrl" target="_blank" rel="noopener">Atlassian Administration<span class="visually-hidden"> (opens in a new tab)</span></a>,
                        go to <strong>Directory</strong> &rarr; <strong>Service accounts</strong> &rarr; <strong>Create a service account</strong>.
                        Name it (6 to 30 letters or digits, for example <code>connapse</code>).
                    </li>
                    <li>
                        On <strong>Select app roles</strong>, set <strong>Confluence</strong> to its admin role and leave other apps at None.
                        Connapse needs Confluence admin rights to ask what each person may read, and Check and save checks for them.
                        If it reports the account isn't an administrator, change its Confluence role here, under
                        <strong>Directory</strong> &rarr; <strong>Service accounts</strong>, or add it to the site's Confluence admin group
                        under <strong>Directory</strong> &rarr; <strong>Groups</strong>.
                    </li>
                    <li>
                        In every space you will index, give the service account (or a group it is in) at least view access. Open the
                        space, choose <strong>&bull;&bull;&bull;</strong> next to its name in the sidebar &rarr; <strong>Space settings</strong>
                        &rarr; <strong>Users</strong>, add the service account and give it the <strong>Viewer</strong> role. On sites without
                        space roles the page is <strong>Permissions</strong>, where it needs <strong>View</strong>.
                        Being an admin does not grant this. Pages with view restrictions that don't include the service account are skipped.
                    </li>
                    <li>
                        Back on the service account, choose <strong>Create credentials</strong> &rarr; <strong>OAuth 2.0</strong>. On
                        <strong>Select scopes</strong>, choose <strong>Copy required scopes</strong> below and paste it into the search
                        box: the list narrows to exactly these @RequiredScopes.Count, so tick each one. Only if a source will include
                        attachments, choose <strong>Copy with the attachments permission</strong> instead, which adds
                        <code>@Connapse.Web.Components.Sources.ConfluenceSpaceSelection.AttachmentScope</code>; you can add it later when a source needs it.
                        Create it, then copy the client ID and secret: the secret is shown only once.
                    </li>
                </ol>
            }
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <strong class="small">Scopes</strong>
                <button type="button" id="atlassian-copy-required" class="btn btn-sm btn-outline-secondary" @onclick="CopyRequiredScopes">
                    <span class="bi-clipboard me-1" aria-hidden="true"></span> Copy required scopes
                </button>
                <button type="button" id="atlassian-copy-with-attachments" class="btn btn-sm btn-outline-secondary" @onclick="CopyAllScopes"
                        aria-describedby="atlassian-copy-with-attachments-help">
                    <span class="bi-clipboard me-1" aria-hidden="true"></span> Copy with the attachments permission
                </button>
                <span id="atlassian-copy-with-attachments-help" class="visually-hidden">Only if a source will include attachments.</span>
                <span class="small @(copySucceeded ? "text-success" : "text-danger")" role="status" id="atlassian-copy-status">@copyMessage</span>
            </div>
            <div class="small fw-semibold mb-1">@AtlassianSiteScopes.DisplayName(ShownProduct)</div>
            <ul class="list-unstyled small mb-0" id="@($"atlassian-scopes-{ShownProduct}")">
                @foreach (AtlassianScope scope in Scopes)
                {
                    <li class="mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <code>@scope.Name</code>
                            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center p-1"
                                    style="min-width:24px;min-height:24px" aria-label="Copy @scope.Name" @onclick="() => CopyAsync(scope.Name)">
                                <span class="bi-clipboard" aria-hidden="true"></span>
                            </button>
                            @if (scope.Optional)
                            {
                                <span class="badge text-bg-light border">Optional</span>
                            }
                        </div>
                        <div class="text-muted">@scope.Reason.</div>
                    </li>
                }
            </ul>
        </details>

        <h3 class="h6 mt-3">Site</h3>
        <div @onfocusout="() => { ValidateSiteUrl(blur: true); }">
            <ProviderField Spec="AtlassianSiteFieldSpecs.SiteUrlFor(Product)" Small="true" Value="@siteUrl" ValueChanged="OnSiteUrlChanged"
                           Error="@siteUrlError" Disabled="@(busy || lookingUp)" />
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <button type="button" id="atlassian-resolve" class="btn btn-sm btn-outline-secondary" disabled="@(busy || lookingUp)" @onclick="ResolveAsync">
                @if (lookingUp)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Looking up…</span>
                }
                else
                {
                    <span>Look up site</span>
                }
            </button>
            <span class="small text-muted" id="atlassian-resolve-help">Optional: checks the address before you test.</span>
        </div>
        <div role="status" class="small mb-3" id="atlassian-resolve-status">
            @if (cloudId is not null)
            {
                <span class="text-success"><span class="bi-check-circle me-1" aria-hidden="true"></span>Found the site. Its Cloud ID is <code id="atlassian-cloud-id">@cloudId</code>.</span>
                <div class="text-muted">The Cloud ID is Atlassian's own ID for your site. Connapse uses it to reach the site and fills it in for you.</div>
            }
        </div>
        @if (resolveError is not null)
        {
            <div class="text-danger small mb-3" role="alert" id="atlassian-resolve-error">
                <span class="bi-x-circle me-1" aria-hidden="true"></span>@resolveError
            </div>
        }

        <h3 class="h6">Service account credential</h3>
        <div>
            <ProviderField Spec="AtlassianSiteFieldSpecs.ClientId" Small="true" Value="@clientId"
                           ValueChanged="@((string? v) => { clientId = v; clientIdError = null; })"
                           Error="@clientIdError" Disabled="@busy" />
            <ProviderField @ref="clientSecretField" Spec="AtlassianSiteFieldSpecs.ClientSecret" Small="true" Value="@clientSecret"
                           ValueChanged="@((string? v) => { clientSecret = v; clientSecretError = null; })"
                           Error="@clientSecretError" HasStoredValue="@(kept is not null)" Disabled="@busy" />
        </div>
        @if (kept is not null)
        {
            <p class="small mb-2" id="atlassian-secret-kept" role="status">
                <span class="bi-shield-lock me-1" aria-hidden="true"></span>Secret kept for your next attempt.
                <button type="button" id="atlassian-secret-clear" class="btn btn-sm btn-link p-0 align-baseline" @onclick="ClearKept">Clear it</button>
            </p>
        }

        <div class="mt-3">
            <button type="button" id="atlassian-save" class="btn btn-primary me-2" disabled="@busy" @onclick="() => SaveAsync(saveAnyway: false)">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Checking with Atlassian…</span>
                }
                else
                {
                    <span>Check and save</span>
                }
            </button>
            <button type="button" id="atlassian-cancel" class="btn btn-secondary" @onclick="CancelAsync">Cancel</button>
        </div>
        @if (saveError is not null)
        {
            <div class="alert alert-danger py-2 mt-2 mb-0 small" role="alert" id="atlassian-save-error">
                <span class="bi-x-circle me-1" aria-hidden="true"></span>@saveError
            </div>
        }
        @if (saveResult is { } tested)
        {
            <AtlassianTestResultView Result="tested" Id="atlassian-save-result" Busy="@busy" OnSaveAnyway="() => SaveAsync(saveAnyway: true)" />
        }
    }
</div>

@code {
    /// <summary>An Atlassian connection being edited; null to add a new site.</summary>
    [Parameter] public Connection? Existing { get; set; }

    /// <summary>The product a new site's connection reads; a saved site's comes from its config.</summary>
    [Parameter] public AtlassianProduct Product { get; set; } = AtlassianProduct.Confluence;

    private AtlassianProduct shownNewProduct = AtlassianProduct.Confluence;

    /// <summary>Raised with the connection once a new site passes every probe and is saved.</summary>
    [Parameter] public EventCallback<Connection> OnCreated { get; set; }

    /// <summary>Raised with the connection after its credentials are replaced.</summary>
    [Parameter] public EventCallback<Connection> OnUpdated { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>
    /// Raised when Check and save starts and when it ends, so the page can lock the product choice:
    /// a switch mid-check would land one product's result or connection under the other's form.
    /// </summary>
    [Parameter] public EventCallback<bool> CheckingChanged { get; set; }

    /// <summary>Raised when the Replace credentials section opens or closes, so the page can keep one primary action.</summary>
    [Parameter] public EventCallback<bool> ReplacingChanged { get; set; }

    /// <summary>The Confluence scopes the service account's credential needs, space separated as Atlassian shows them.</summary>
    public const string ConfluenceScopeList =
        "read:space:confluence read:page:confluence read:comment:confluence read:attachment:confluence "
        + "read:folder:confluence read:content-details:confluence read:content.permission:confluence";

    private const string AdminUrl = "https://admin.atlassian.com";

    /// <summary>
    /// A secret held for a retry after a failed test. Not a string field, so nothing binds or
    /// renders it, and its ToString never prints it.
    /// </summary>
    private sealed class KeptSecret(string value)
    {
        public string Value { get; } = value;
        public override string ToString() => "***";
    }

    private bool busy;

    // Trips when Cancel is pressed during the check, so the check stops and nothing is saved.
    private CancellationTokenSource? saveCts;
    private bool lookingUp;
    private bool copySucceeded;
    private string? copyMessage;

    private string? siteUrl;
    private string? siteUrlError;
    private string? cloudId;
    private string? resolveError;
    private string? clientId;
    private string? clientIdError;
    private string? clientSecret;
    private string? clientSecretError;
    private KeptSecret? kept;
    private string? saveError;
    private ConnectionTestResult? saveResult;

    private Connection? current;
    private bool retesting;

    // A control that removes itself hands focus on after the render that removes it.
    private ElementReference replaceOpenButton;
    private ProviderField? replaceClientIdField;
    private ProviderField? replaceClientSecretField;
    private ProviderField? clientSecretField;
    private Func<ValueTask>? focusAfterRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusAfterRender is not { } focus) return;
        focusAfterRender = null;
        await focus();
    }

    private static ValueTask FocusField(ProviderField? field) => field?.FocusAsync() ?? ValueTask.CompletedTask;

    /// <summary>Drops the kept secret; focus goes to the now-empty secret field, where a new one is pasted.</summary>
    private void ClearKept()
    {
        kept = null;
        focusAfterRender = () => FocusField(clientSecretField);
    }

    private void ClearReplaceKept()
    {
        replaceKept = null;
        focusAfterRender = () => FocusField(replaceClientSecretField);
    }
    private ConnectionTestResult? retest;

    private bool replacing;
    private bool replaceBusy;
    private string? replaceClientId;
    private string? replaceClientIdError;
    private string? replaceClientSecret;
    private string? replaceClientSecretError;
    private KeptSecret? replaceKept;
    private string? replaceError;
    private ConnectionTestResult? replaceResult;

    /// <summary>
    /// Opens a saved site with Replace credentials already expanded, as a link from a source that
    /// needs a permission the credential lacks does (<c>/connections?edit=&lt;id&gt;&amp;replace=1</c>).
    /// </summary>
    [Parameter] public bool StartReplacing { get; set; }

    // Only another site replaces what is shown: the parent's copy of this one goes stale after a
    // re-test or a replace, which refresh it here.
    protected override async Task OnParametersSetAsync()
    {
        // Choosing the other product for a new site drops the last result, which was that product's.
        if (Product != shownNewProduct)
        {
            shownNewProduct = Product;
            saveResult = null;
            saveError = null;
            copyMessage = null;
        }

        if (Existing?.Id == current?.Id)
            return;

        current = Existing;
        replacing = false;
        retest = null;
        if (StartReplacing && current is not null)
            await OpenReplace();
    }

    /// <summary>Plain HTTP to anything but this machine: a secret entered here crosses the network in the clear.</summary>
    private bool PlainHttp
    {
        get
        {
            if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out Uri? page) || page.Scheme != Uri.UriSchemeHttp)
                return false;
            return !(page.IsLoopback
                     || page.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase)
                     || page.Host.EndsWith(".localhost", StringComparison.OrdinalIgnoreCase));
        }
    }

    private void OnSiteUrlChanged(string? value)
    {
        siteUrl = value;
        siteUrlError = null;
        cloudId = null;
        resolveError = null;
    }

    /// <summary>On blur only a malformed address is flagged; a blank one waits for submit.</summary>
    private bool ValidateSiteUrl(bool blur)
    {
        if (string.IsNullOrWhiteSpace(siteUrl))
        {
            siteUrlError = blur ? null : "Enter the site URL.";
            return blur;
        }

        siteUrlError = AtlassianSiteResolver.NormalizeSiteUrl(siteUrl) is null
            ? InvalidAddressMessage
            : null;
        return siteUrlError is null;
    }

    private bool ValidateCredentialFields()
    {
        clientIdError = string.IsNullOrWhiteSpace(clientId) ? "Enter the client ID." : null;
        clientSecretError = string.IsNullOrWhiteSpace(clientSecret) && kept is null ? "Paste the client secret." : null;
        return clientIdError is null && clientSecretError is null;
    }

    private bool ValidateReplaceField()
    {
        replaceClientIdError = string.IsNullOrWhiteSpace(replaceClientId) ? "Enter the new client ID." : null;
        replaceClientSecretError = string.IsNullOrWhiteSpace(replaceClientSecret) && replaceKept is null
            ? "Paste the new client secret." : null;
        return replaceClientIdError is null && replaceClientSecretError is null;
    }

    private async Task ResolveAsync()
    {
        cloudId = null;
        resolveError = null;
        if (!ValidateSiteUrl(blur: false))
            return;

        lookingUp = true;
        try
        {
            var resolved = await Sites.ResolveAsync(siteUrl);
            switch (resolved.Outcome)
            {
                case AtlassianResolveOutcome.Resolved:
                    cloudId = resolved.CloudId;
                    break;
                case AtlassianResolveOutcome.InvalidAddress:
                    siteUrlError = InvalidAddressMessage;
                    break;
                default:
                    resolveError = $"Couldn't find an Atlassian Cloud site at {resolved.SiteUrl}. Check the spelling against your browser's address bar.";
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not look up an Atlassian site");
            resolveError = "The site could not be looked up. Check that this server can reach the internet, then try again.";
        }
        finally
        {
            lookingUp = false;
        }
    }

    private async Task<Guid?> UserIdAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out Guid id) ? id : null;
    }

    private async Task SaveAsync(bool saveAnyway)
    {
        saveError = null;
        bool siteOk = ValidateSiteUrl(blur: false);
        bool credentialsOk = ValidateCredentialFields();
        if (!siteOk || !credentialsOk)
            return;

        saveResult = null;

        // A newly pasted secret replaces any kept one. The bound field is emptied before the first
        // await, so no outcome leaves the secret in it or behind the field's Show control.
        if (!string.IsNullOrWhiteSpace(clientSecret))
            kept = new KeptSecret(clientSecret);
        clientSecret = null;
        string submittedSecret = kept!.Value;

        busy = true;
        await CheckingChanged.InvokeAsync(true);
        saveCts?.Dispose();
        saveCts = new CancellationTokenSource();
        CancellationToken ct = saveCts.Token;
        try
        {
            var added = await Sites.AddAsync(siteUrl, clientId, submittedSecret, await UserIdAsync(), saveAnyway, Product, ct);
            switch (added.Outcome)
            {
                case AtlassianAddOutcome.Created:
                    kept = null;
                    clientId = null;
                    siteUrl = null;
                    cloudId = null;
                    await OnCreated.InvokeAsync(added.Connection!);
                    break;
                case AtlassianAddOutcome.MissingFields:
                    ValidateCredentialFields();
                    break;
                case AtlassianAddOutcome.Conflict:
                    saveError = $"A connection named '{added.Name}' already exists. Open it from the list to test it or replace its credentials.";
                    break;
                case AtlassianAddOutcome.NameTaken:
                    saveError = $"Another connection is already named '{added.Name}'. Rename it, then try again.";
                    break;
                default:
                    saveResult = added.Test;
                    break;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Cancelled: the check stopped before anything was saved, and the form is closing.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not add an Atlassian site");
            saveError = "The site could not be checked. Try again.";
        }
        finally
        {
            busy = false;
            await CheckingChanged.InvokeAsync(false);
        }
    }

    /// <summary>Cancel stops a check that is running, so no site is saved, then closes the form.</summary>
    private async Task CancelAsync()
    {
        saveCts?.Cancel();
        await OnCancel.InvokeAsync();
    }

    public void Dispose()
    {
        saveCts?.Cancel();
        saveCts?.Dispose();
    }

    private async Task RetestAsync()
    {
        if (current is not { } site) return;

        retesting = true;
        retest = null;
        try
        {
            retest = await Sites.RetestAsync(site.Id)
                ?? ConnectionTestResult.CreateFailure(
                    "The stored credential for this site can't be read. Choose Replace credentials and enter it again.",
                    new Dictionary<string, object> { ["step"] = AtlassianConnectionTester.TokenStep, ["troubleshoot"] = AtlassianSiteTroubleshooting.CredentialsRejected });
            current = await Store.GetAsync(site.Id) ?? current;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not re-test an Atlassian site");
            retest = ConnectionTestResult.CreateFailure("The test could not run. Try again.");
        }
        finally
        {
            retesting = false;
        }
    }

    private async Task OpenReplace()
    {
        replacing = true;
        replaceResult = null;
        replaceError = null;
        // The button is gone once the section opens, so focus moves to the section's first field.
        focusAfterRender = () => FocusField(replaceClientIdField);
        await ReplacingChanged.InvokeAsync(true);
    }

    private async Task CloseReplace()
    {
        replacing = false;
        replaceClientId = null;
        replaceClientSecret = null;
        replaceKept = null;
        replaceResult = null;
        replaceError = null;
        replaceClientIdError = null;
        replaceClientSecretError = null;
        // Back to the button that reopens the section, which this render shows again.
        focusAfterRender = () => replaceOpenButton.FocusAsync();
        await ReplacingChanged.InvokeAsync(false);
    }

    private async Task ReplaceAsync(bool saveAnyway)
    {
        if (current is not { } site) return;

        replaceError = null;
        if (!ValidateReplaceField())
            return;

        replaceResult = null;
        if (!string.IsNullOrWhiteSpace(replaceClientSecret))
            replaceKept = new KeptSecret(replaceClientSecret);
        replaceClientSecret = null;
        string submittedSecret = replaceKept!.Value;

        replaceBusy = true;
        try
        {
            var replaced = await Sites.ReplaceCredentialsAsync(site.Id, replaceClientId, submittedSecret, await UserIdAsync(), saveAnyway);
            switch (replaced.Outcome)
            {
                case AtlassianReplaceOutcome.Replaced:
                    await CloseReplace();
                    current = replaced.Connection;
                    retest = replaced.Test;
                    await OnUpdated.InvokeAsync(replaced.Connection!);
                    break;
                case AtlassianReplaceOutcome.NotFound:
                    replaceError = "This site no longer exists; it was deleted elsewhere.";
                    break;
                case AtlassianReplaceOutcome.MissingFields:
                    ValidateReplaceField();
                    break;
                case AtlassianReplaceOutcome.SiteChanged:
                    replaceError = "The site at this address has a different Cloud ID than when it was added, so it is a different site. Add it as a new connection.";
                    break;
                default:
                    replaceResult = replaced.Test;
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not replace an Atlassian site's credentials");
            replaceError = "The new credential could not be checked. Try again.";
        }
        finally
        {
            replaceBusy = false;
        }
    }

    private static int ConfirmedCount(Connection site, IReadOnlyList<AtlassianScope> scopes) =>
        scopes.Count(s => site.Health?.ConfirmedScopes?.Contains(s.Name, StringComparer.OrdinalIgnoreCase) ?? false);

    private static string SourcesPhrase(Connection site) => site.SourceCount switch
    {
        0 => "any sources you add will",
        1 => "its 1 source will",
        _ => $"its {site.SourceCount} sources will",
    };

    private static string SiteUrlOf(Connection site) => ConfigValue(site, "siteUrl");

    private static string ConfigValue(Connection site, string name)
    {
        try
        {
            using var doc = JsonDocument.Parse(site.ConfigJson ?? "{}");
            return doc.RootElement.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
                ? value.GetString() ?? ""
                : "";
        }
        catch (JsonException)
        {
            return "";
        }
    }

    /// <summary>The product the form shows, as <c>confluence</c> or <c>jira</c>: the saved site's, or the new site's.</summary>
    private string ShownProduct => current is { } site ? AtlassianSiteStatus.ProductOf(site) : AtlassianSite.ProductValue(Product);

    private bool IsJira => ShownProduct == AtlassianSiteScopes.JiraProduct;

    /// <summary>The scopes of the product the form shows; a connection's credential needs no other product's.</summary>
    private IReadOnlyList<AtlassianScope> Scopes => AtlassianSiteScopes.Of(ShownProduct);

    private string InvalidAddressMessage =>
        $"Enter the address as https://your-site.atlassian.net, the address in your browser when you open {AtlassianSiteScopes.DisplayName(ShownProduct)}.";

    /// <summary>
    /// The scopes a Confluence site needs, space separated: all but the attachment permission, which
    /// is asked for only when a source turns attachments on. The form copies its own product's list.
    /// </summary>
    public static string RequiredScopeList => string.Join(' ', AtlassianSiteScopes.Confluence.Where(s => !s.Optional).Select(s => s.Name));

    /// <summary>The Jira scopes a Jira site needs, space separated: all but the attachment permission.</summary>
    public static string RequiredJiraScopeList => string.Join(' ', AtlassianSiteScopes.Jira.Where(s => !s.Optional).Select(s => s.Name));

    private IReadOnlyList<AtlassianScope> RequiredScopes => Scopes.Where(s => !s.Optional).ToList();

    private Task CopyRequiredScopes() => CopyAsync(string.Join(' ', RequiredScopes.Select(s => s.Name)));

    private Task CopyAllScopes() => CopyAsync(string.Join(' ', Scopes.Select(s => s.Name)));

    // Through the shared helper: navigator.clipboard is undefined outside a secure context, and
    // Connapse is routinely served over plain HTTP on a LAN.
    private async Task CopyAsync(string text)
    {
        copySucceeded = await JS.InvokeAsync<bool>("connapse.copyToClipboard", text);
        copyMessage = copySucceeded ? "Copied." : "Couldn't copy. Select the text and copy it yourself.";
    }
}
