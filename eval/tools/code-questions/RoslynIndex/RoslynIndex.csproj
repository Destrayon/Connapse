<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# answer-key indexer for the code-question set (CON-35). Not part of Connapse.slnx: it runs
    offline, from index_repos.sh, against pinned clones. scip-dotnet 0.2.14 bundles Roslyn 4.4 (C# 11)
    and leaves every primary-constructor class unbound, so the keys come from current Roslyn instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Workspaces.MSBuild brings this in; MSBuild itself comes from the installed SDK at run time. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
  </ItemGroup>

</Project>
